0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["hi",{"children":["ragas",{"children":[["slug","rag-gauri","d"],{"children":["__PAGE__?{\"slug\":\"rag-gauri\"}",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["hi",{"children":["ragas",{"children":[["slug","rag-gauri","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ItemList\",\"name\":\"राग गौरी\",\"description\":\"राग राग गौरी में रचित पदों की सूची\",\"numberOfItems\":1,\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"url\":\"https://path.vrindopnishad.in/hi/content/rasabhare-rajat-rasikabahari\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"मुख्यपृष्ठ\",\"item\":\"https://path.vrindopnishad.in/hi\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"राग\",\"item\":\"https://path.vrindopnishad.in/hi/ragas\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"राग गौरी\",\"item\":\"https://path.vrindopnishad.in/hi/ragas/rag-gauri\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/hi","className":"hover:text-amber-400 transition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/hi/ragas","className":"hover:text-amber-400 transition-colors","children":"राग"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"राग गौरी"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialRaga":{"name":"राग गौरी","hinglishName":"rag gauri","slug":"rag-gauri","verses":[{"id":"local-153","title":"रसभरे राजत रसिकबहारी","category":"Shloka","sanskrit_text":"रसभरे राजत रसिकबहारी |गौर स्याम अभिराम रूप दोऊ नव नेह विहारी  |यह सुख निरखि सखी नित प्रमुदित, प्रान करै बलिहारी |भगवतरसिक पियत या रस को और लगै सब खारी ||","hindi_text":"(राग गौरी)\nरसभरे राजत रसिकबहारी |\nगौर स्याम अभिराम रूप दोऊ नव नेह विहारी  |\nयह सुख निरखि सखी नित प्रमुदित, प्रान करै बलिहारी |\nभगवतरसिक पियत या रस को और लगै सब खारी ||\n- श्री भगवत रसिक - भगवत रसिक की वाणी, अनन्यरसीकाभरण ग्रन्थ (6.6)\nयहाँ श्यामा श्याम ही रसिकबिहारी है। वे रस भरे हैं। वे नव नव नेह भरे खेल खेलते हैं। उनके सुख से सखियाँ प्रमोदित हैं। भगवतरसिक जी इस रस का पान कर तृप्त हो रहे हैं और  इसके सामने ओर सभी रस उन्हें खारे लगते हैं।","english_text":null,"english_translation":"In the words of Shri Bhagwat Rasik, Yugal Sarkar Shri Shyama Shyam, The ever-young blissful Divine Couple i.e fair complexioned Shri Radha & blue complexioned Shri Krishna are Rasik Bihari and are full of unprecedented love, unprecedented joy and unprecedented blissful nectar blossom among each other. O Sakhi friend, Look at the nectarine bliss of \"Nitya Vihar\" (Pastimes of Yugal Sarkar without being separated even for half a moment) which are always relished by Sakhis and offer your life on this bliss. Shri Bhagwat Rasik says, by drinking an amzing bliss of \"Nitya Vihar\", all other kinds of pleasures look worthless.","description":"https://www.brajrasik.org/hi/articles/5b54059f5dbf5475ed9a43da/ras-bhare-rajat-rasik-bihari-gaur-shyam-abhiram-roop-dou-nav-neh-bihari-yeh-sukh-nirakhi-sakhi-nit-pramudit-praan-kare-balihari-bhagwat-rasik-piyat-ya-ras-ko-aur-lage-sab-khari-shri-bhagwat-rasik-bhagwat-rasik-ki-vani","author":"श्री भगवत रसिक  भगवत रसिक की वाणी, अनन्यरसीकाभरण ग्रन्थ (6.6)","status":"published","content_text":"(राग गौरी)\nरसभरे राजत रसिकबहारी |\nगौर स्याम अभिराम रूप दोऊ नव नेह विहारी  |\nयह सुख निरखि सखी नित प्रमुदित, प्रान करै बलिहारी |\nभगवतरसिक पियत या रस को और लगै सब खारी ||\n- श्री भगवत रसिक - भगवत रसिक की वाणी, अनन्यरसीकाभरण ग्रन्थ (6.6)\nयहाँ श्यामा श्याम ही रसिकबिहारी है। वे रस भरे हैं। वे नव नव नेह भरे खेल खेलते हैं। उनके सुख से सखियाँ प्रमोदित हैं। भगवतरसिक जी इस रस का पान कर तृप्त हो रहे हैं और  इसके सामने ओर सभी रस उन्हें खारे लगते हैं।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b54059f5dbf5475ed9a43da/ras-bhare-rajat-rasik-bihari-gaur-shyam-abhiram-roop-dou-nav-neh-bihari-yeh-sukh-nirakhi-sakhi-nit-pramudit-praan-kare-balihari-bhagwat-rasik-piyat-ya-ras-ko-aur-lage-sab-khari-shri-bhagwat-rasik-bhagwat-rasik-ki-vani","slug":"rasabhare-rajat-rasikabahari"}],"imageUrl":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","ragas","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","ragas","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"lang":"hi","children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/84