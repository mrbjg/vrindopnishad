":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"राग रस"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialRaga":{"name":"राग रस","hinglishName":"rag rasa","slug":"rag-rasa","verses":[{"id":"local-24","title":"नारायण दो बात सों","category":"Shloka","sanskrit_text":"नारायण दो बात सों, अधिक और नहिं बात |रसिकनको सत्संग नित, युगलध्यान दिनरात ||","hindi_text":"नारायण दो बात सों, अधिक और नहिं बात |\nरसिकनको सत्संग नित, युगलध्यान दिनरात ||\nश्री नारायण स्वामी - अनुराग रस (183)\nसाधक के लिए, दो बातों से बड़ी और कोई बात नहीं है:\n1. यदि रसिकों का संग नित्य मिल जाए।\n2. रात दिन युगल रूप ध्यान बना रहे।","english_text":null,"english_translation":"For an aspirant, there is no bigger achievement than these two things:\n1. Getting association of Rasik Saints ceaselessly.\n2. To be immersed day and night in loving remembrance of the form of Yugal Sarkar Shri Radha Krishn.","description":"https://www.brajrasik.org/hi/articles/5b71cf2ee2a515004edc249c/narayan-do-baat-son-shri-narayan-swami-anurag-ras","author":"श्री नारायण स्वामी  अनुराग रस (183)","status":"published","content_text":"नारायण दो बात सों, अधिक और नहिं बात |\nरसिकनको सत्संग नित, युगलध्यान दिनरात ||\nश्री नारायण स्वामी - अनुराग रस (183)\nसाधक के लिए, दो बातों से बड़ी और कोई बात नहीं है:\n1. यदि रसिकों का संग नित्य मिल जाए।\n2. रात दिन युगल रूप ध्यान बना रहे।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b71cf2ee2a515004edc249c/narayan-do-baat-son-shri-narayan-swami-anurag-ras","slug":"narayan-do-bat-son"},{"id":"local-104","title":"परस्पर दोउ चकोर, दोउ चंदा","category":"Shloka","sanskrit_text":"परस्पर दोउ चकोर, दोउ चंदा |दोउ चातक, दोउ स्वाति,दोउ घन, दोउ दामिनी अमंदा ||दोउ अरबिंद, दोउ अलि लंपट, दोउ लोहा दोउ चुबंक |दोउ आसक, महबूब दोउ मिलि, जुरे जुराफा अंबक ||दोउ मुदार, दोउ मोर, दोउ मृग, दोउ राग रस भीने |दोउ मनि बिसद, दोउ बर पन्नग, दोउ बारि दोउ मीने ||भगवतरसिक बिहारिन प्यारी रसिकबिहारी प्यारे |दोउ मुख देखि जियत, अधरामृत पियत, होत नहि न्यारे ||","hindi_text":"$5","english_text":null,"english_translation":"$6","description":"https://www.brajrasik.org/hi/articles/5baaac84d8c34c0056850709/paraspar-dou-chakor-dou-chanda-shri-bhagwat-rasik","author":"श्री भगवत रसिक, श्री भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ  उत्तरार्ध (6)","status":"published","content_text":"$7","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5baaac84d8c34c0056850709/paraspar-dou-chakor-dou-chanda-shri-bhagwat-rasik","slug":"paraspar-dou-chakor-dou-chnda"},{"id":"local-357","title":"कोऊ नहीं अपनो सगो, बिन राधा गोपाल","category":"Shloka","sanskrit_text":"कोऊ नहीं अपनो सगो, बिन राधा गोपाल |नारायण तू वृथा मति, परै जगत के जाल ||","hindi_text":"कोऊ नहीं अपनो सगो, बिन राधा गोपाल |\nनारायण तू वृथा मति, परै जगत के जाल ||\n- श्री नारायण स्वामी - अनुराग रस (50)\nश्री राधा कृष्ण के सिवाय तुम्हारा अपना कोई नहीं है, यह भली भांति जान लो और संसार के जाल में अपने मन को फ़साना व्यर्थ है।","english_text":null,"english_translation":"There is no other real companion like Yugal Sarkar, Shri Radha Krishna, Hence It is completely useless to trap your mind in this material world!","description":"https://www.brajrasik.org/hi/articles/5b8014f2506f44004fb01264/kou-nahin-apno-sago-bin-radha-gopal-shri-narayan-swami-anurag-ras","author":"श्री नारायण स्वामी  अनुराग रस (50)","status":"published","content_text":"कोऊ नहीं अपनो सगो, बिन राधा गोपाल |\nनारायण तू वृथा मति, परै जगत के जाल ||\n- श्री नारायण स्वामी - अनुराग रस (50)\nश्री राधा कृष्ण के सिवाय तुम्हारा अपना कोई नहीं है, यह भली भांति जान लो और संसार के जाल में अपने मन को फ़साना व्यर्थ है।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b8014f2506f44004fb01264/kou-nahin-apno-sago-bin-radha-gopal-shri-narayan-swami-anurag-ras","slug":"kuo-nahin-apano-sago-bin-radha-gopala"},{"id":"local-510","title":"वैदग्ध्य सिन्धु अनुराग","category":"Shloka","sanskrit_text":"“ वैदग्ध्य सिन्धु अनुराग-रसैक सिंधु, वात्सल्य सिंधु, अतिसान्ध्र कृपैक सिंधु ||लावण्य सिन्दु अमृतछवि रूप सिंधु, श्री राधिका स्फुरतु मे हृदय केलि सिंधु || ”","hindi_text":"“ वैदग्ध्य सिन्धु अनुराग-रसैक सिंधु, वात्सल्य सिंधु, अतिसान्ध्र कृपैक सिंधु ||\nलावण्य सिन्दु अमृतछवि रूप सिंधु, श्री राधिका स्फुरतु मे हृदय केलि सिंधु || ”\n- हित हरिवंश महाप्रभु - श्री राधा सुधा निधि - 17\nकला विलास की सिंधु, अनुराग रस की एक मात्र सिंधु, अतिशय ममत्व एवं वात्सल्य की सिंधु, अत्यंत प्रगाढ़ कृपा की सिंधु , अत्यंत मोहिनी एवं लावण्य सिंधु, अमृत छवि साक्षात् महाभाव स्वरुप सिंधु, अंतरंग केलि सिंधु स्वरूपा श्री राधा मेरे हृदय में प्रकट हों।","english_text":null,"english_translation":"\"Vaidagdhya Sindhu Anuraga-Rasaika-Sindhu\nVatsalya-Sindhu Ati-Sandra-Kripaika-Sindhu ||\nLavanya-Sindhu Amrta-Cchavi-Rupa-Sindhu\nShri-Radhika Sphurati Me Hrdi Keli-Sindhuh\"\n- Hita Harivansh Mahaprabhu - Shri Radha Sudha Nidhi - 17\nMay Shri Radha, who is an ocean of intelligence, a nectar ocean of love, an ocean of kind affection, an ocean of great mercy, an ocean of beauty, an ocean of nectar splendor, and an ocean of transcendental pastimes, appear in my heart.","description":"https://www.brajrasik.org/hi/articles/5a4f314659e8c72a534d86d8/vaidagdhya-sindhu-anuragarasaikasindhu-vatsalyasindhu-atisandrakripaikasindhu-lavanyasindhu-amrtacchavirupasindhu-shriradhika-sphurati-me-hrdi-kelisindhuh-hita-harivansh-mahaprabhu-shri-radha-sudha-nidhi-17","author":"हित हरिवंश महाप्रभु  श्री राधा सुधा निधि  17","status":"published","content_text":"“ वैदग्ध्य सिन्धु अनुराग-रसैक सिंधु, वात्सल्य सिंधु, अतिसान्ध्र कृपैक सिंधु ||\nलावण्य सिन्दु अमृतछवि रूप सिंधु, श्री राधिका स्फुरतु मे हृदय केलि सिंधु || ”\n- हित हरिवंश महाप्रभु - श्री राधा सुधा निधि - 17\nकला विलास की सिंधु, अनुराग रस की एक मात्र सिंधु, अतिशय ममत्व एवं वात्सल्य की सिंधु, अत्यंत प्रगाढ़ कृपा की सिंधु , अत्यंत मोहिनी एवं लावण्य सिंधु, अमृत छवि साक्षात् महाभाव स्वरुप सिंधु, अंतरंग केलि सिंधु स्वरूपा श्री राधा मेरे हृदय में प्रकट हों।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5a4f314659e8c72a534d86d8/vaidagdhya-sindhu-anuragarasaikasindhu-vatsalyasindhu-atisandrakripaikasindhu-lavanyasindhu-amrtacchavirupasindhu-shriradhika-sphurati-me-hrdi-kelisindhuh-hita-harivansh-mahaprabhu-shri-radha-sudha-nidhi-17","slug":"vaidagdhy-sindhu-anuraga"}],"imageUrl":null}}]}]],null],null],null]},[null,["$","$L8",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","ragas","children","$9","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$La",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L8",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","ragas","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$La",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"lang":"hi","children":["$","$L8",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$La",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html