0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["hi",{"children":["ragas",{"children":[["slug","rag-asavari","d"],{"children":["__PAGE__?{\"slug\":\"rag-asavari\"}",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["hi",{"children":["ragas",{"children":[["slug","rag-asavari","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ItemList\",\"name\":\"राग आसावरी\",\"description\":\"राग राग आसावरी में रचित पदों की सूची\",\"numberOfItems\":1,\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"url\":\"https://path.vrindopnishad.in/hi/content/suni-mero-vachan-chhabili-radha-tain-payo-ras-sindhu-agadha\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"मुख्यपृष्ठ\",\"item\":\"https://path.vrindopnishad.in/hi\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"राग\",\"item\":\"https://path.vrindopnishad.in/hi/ragas\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"राग आसावरी\",\"item\":\"https://path.vrindopnishad.in/hi/ragas/rag-asavari\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/hi","className":"hover:text-amber-400 transition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/hi/ragas","className":"hover:text-amber-400 transition-colors","children":"राग"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"राग आसावरी"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialRaga":{"name":"राग आसावरी","hinglishName":"rag asavari","slug":"rag-asavari","verses":[{"id":"local-421","title":"सुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा","category":"Shloka","sanskrit_text":"सुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा ।।तूँ वृषभानु गोप की बेटी, मोहनलाल रसिक हँसि भेंटी ।जाहि बिरंचि उमापति नाये, तापै तैं बन फूल बिनाये ।।जो रस नेति-नेति श्रुति भाख्यो, ताकौ तैं अधर सुधारस चाख्यौ ।तेरौ रूप कहत नहीं आवै, जै श्रीहित हरिवंश कछुक जस गावै ।","hindi_text":"(राग आसावरी)\nसुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा ।।\nतूँ वृषभानु गोप की बेटी, मोहनलाल रसिक हँसि भेंटी ।\nजाहि बिरंचि उमापति नाये, तापै तैं बन फूल बिनाये ।।\nजो रस नेति-नेति श्रुति भाख्यो, ताकौ तैं अधर सुधारस चाख्यौ ।\nतेरौ रूप कहत नहीं आवै, जै श्रीहित हरिवंश कछुक जस गावै ।\n- मुरली अवतार श्री हित हरिवंश महाप्रभु - श्री हित चतुरासी (18)\nभावार्थ- \"हे छविमयी राधे ! तू मेरी बात सुन ! तूने रस का गम्भीर समुद्र पाया है । यद्यपि तू वृषभानु गोप की ही बेटी है, फिर भी तूने प्रसन्नता पूर्वक रसिक मोहन लाल का आलिंगन किया है, जिन श्रीकृष्ण का नमन ब्रह्म और उमापति शङ्कर भी करते है, तूने उन्हों से फूल विनाये (चुनवाये) हैं । आरी ! जिस श्रीकृष्ण (परम पुरुष भगवान) के रस (लीला, प्रभाव, गुण माहात्म्य आदि) के लिये श्रुतियों ने भी (असमर्थता पूर्वक) नेति नेति कह दिया तूने तो उसका भी अधर रस पान किया है। राधे ! तेरा रूप तो कुछ कहने में ही नहीं आता, हित हरिवंश तो तेरा कुछ थोड़ा सा सुयश मात्र ही गा रहा है |","english_text":null,"english_translation":"Oh, Shri Radhey, Please listen to me, You have got the ultimate mine of bliss. You are the daughter of Shri Vrishbhanu and have lovingly embraced Shri Krishna. [1]\nThe supreme God Shri Krishn who is always worshipped by Lord Bhrama and Lord Shiva, has especially picked up flowers for you from the forest. Even Vedas declare Him as out of reach, and you can easily drink the nectar of His lips. [2]\nShri Hita Harivansh Mahaprabhu, the incarnation of Shri Krishn’s Murali says “By any means possible, Its utterly impossible to explain your divine beauty, and the glimpse in the words, Whatever I am explaining is just the fraction of it!” [3]","description":"https://www.brajrasik.org/hi/articles/5b7e7ee8506f44004fb01262/suni-mero-vachan-chabeeli-radha-shri-hita-harivansh-mahaprabhu-shri-hita-chaturasi-98","author":"मुरली अवतार श्री हित हरिवंश महाप्रभु  श्री हित चतुरासी (18)","status":"published","content_text":"(राग आसावरी)\nसुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा ।।\nतूँ वृषभानु गोप की बेटी, मोहनलाल रसिक हँसि भेंटी ।\nजाहि बिरंचि उमापति नाये, तापै तैं बन फूल बिनाये ।।\nजो रस नेति-नेति श्रुति भाख्यो, ताकौ तैं अधर सुधारस चाख्यौ ।\nतेरौ रूप कहत नहीं आवै, जै श्रीहित हरिवंश कछुक जस गावै ।\n- मुरली अवतार श्री हित हरिवंश महाप्रभु - श्री हित चतुरासी (18)\nभावार्थ- \"हे छविमयी राधे ! तू मेरी बात सुन ! तूने रस का गम्भीर समुद्र पाया है । यद्यपि तू वृषभानु गोप की ही बेटी है, फिर भी तूने प्रसन्नता पूर्वक रसिक मोहन लाल का आलिंगन किया है, जिन श्रीकृष्ण का नमन ब्रह्म और उमापति शङ्कर भी करते है, तूने उन्हों से फूल विनाये (चुनवाये) हैं । आरी ! जिस श्रीकृष्ण (परम पुरुष भगवान) के रस (लीला, प्रभाव, गुण माहात्म्य आदि) के लिये श्रुतियों ने भी (असमर्थता पूर्वक) नेति नेति कह दिया तूने तो उसका भी अधर रस पान किया है। राधे ! तेरा रूप तो कुछ कहने में ही नहीं आता, हित हरिवंश तो तेरा कुछ थोड़ा सा सुयश मात्र ही गा रहा है |","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b7e7ee8506f44004fb01262/suni-mero-vachan-chabeeli-radha-shri-hita-harivansh-mahaprabhu-shri-hita-chaturasi-98","slug":"suni-mero-vachan-chhabili-radha-tain-payo-ras-sindhu-agadha"}],"imageUrl":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","ragas","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","ragas","children"],"error":"$undefined","errorStyles":"$undefined