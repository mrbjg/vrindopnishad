0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["hi",{"children":["ragas",{"children":[["slug","rag-nita","d"],{"children":["__PAGE__?{\"slug\":\"rag-nita\"}",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["hi",{"children":["ragas",{"children":[["slug","rag-nita","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ItemList\",\"name\":\"राग नित\",\"description\":\"राग राग नित में रचित पदों की सूची\",\"numberOfItems\":1,\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"url\":\"https://path.vrindopnishad.in/hi/content/prem-ras-rup-agadha-radha\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"मुख्यपृष्ठ\",\"item\":\"https://path.vrindopnishad.in/hi\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"राग\",\"item\":\"https://path.vrindopnishad.in/hi/ragas\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"राग नित\",\"item\":\"https://path.vrindopnishad.in/hi/ragas/rag-nita\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/hi","className":"hover:text-amber-400 transition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/hi/ragas","className":"hover:text-amber-400 transition-colors","children":"राग"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"राग नित"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialRaga":{"name":"राग नित","hinglishName":"rag nita","slug":"rag-nita","verses":[{"id":"local-141","title":"प्रेम रस रूप अगाधा राधा","category":"Shloka","sanskrit_text":"प्रेम रस रूप अगाधा राधा ।सोइ बिनु बाधा पाय रास – रस, जोइ राधा आराधा ॥ [1]नित्य विहार करति बनि सहचरि, रस न विरह पल आधा ।रासहिं रिझवत सानुराग नित, ताल राग स्वर साधा ॥ [2]निरतत दिव्य हाव – भावन सों, कहि धा तिर – किट – धा – धा – धा ।लहि ‘कृपालु’ इमि युगल – रास – रस, होति धन्य बिनु बाधा ॥ [3]","hindi_text":"श्री किशोरी जी प्रेम – रस एवं रूप की अनंत राशि हैं । उनकी जो उपासना करता है वह सहज ही दिव्य रास – रस प्राप्त करता है ।  [1]\nइतना ही नहीं, वह किशोरी जी की सहचरी बनकर उनके साथ नित्य विहार करता है । उसे आधे पल के लिये भी रस का वियोग नहीं हो सकता । वह सदा स्वरों को साध कर अनुराग – युक्त विविध रागों के द्वारा किशोरी जी के गुणों को गाकर उन्हें प्रसन्न करता है । [2]\nएवं ‘धा – तिर – किट – धा – धा’ आदि नृत्य के शब्दों का उच्चारण करता हुआ विविध हाव – भाव द्वारा अलौकिक नृत्य करता है । ‘श्री कृपालु जी’ कहते हैं कि वह इस प्रकार सहज ही श्यामा – श्याम के दिव्य प्रेमानन्द का निरन्तर अनुभव करता हुआ कृतार्थ रहता है । [3]","english_text":null,"english_translation":null,"description":"https://www.brajrasik.org/hi/articles/5976483e1350677a49620728/prem-ras-roop-agadha-radha-pad-written-by-jagadguru-shri-kripalu-ji-maharaj","author":"जगद्गुरु श्री कृपालु जी महाराज, प्रेम रस मदिरा, श्रीराधा माधुरी (26)","status":"published","content_text":"प्रेम रस रूप अगाधा राधा ।\nसोइ बिनु बाधा पाय रास – रस, जोइ राधा आराधा ॥ [1]\nनित्य विहार करति बनि सहचरि, रस न विरह पल आधा ।\nरासहिं रिझवत सानुराग नित, ताल राग स्वर साधा ॥ [2]\nनिरतत दिव्य हाव – भावन सों, कहि धा तिर – किट – धा – धा – धा ।\nलहि ‘कृपालु’ इमि युगल – रास – रस, होति धन्य बिनु बाधा ॥ [3]\n- जगद्गुरु श्री कृपालु जी महाराज, प्रेम रस मदिरा, श्रीराधा माधुरी (26)\nश्री किशोरी जी प्रेम – रस एवं रूप की अनंत राशि हैं । उनकी जो उपासना करता है वह सहज ही दिव्य रास – रस प्राप्त करता है ।  [1]\nइतना ही नहीं, वह किशोरी जी की सहचरी बनकर उनके साथ नित्य विहार करता है । उसे आधे पल के लिये भी रस का वियोग नहीं हो सकता । वह सदा स्वरों को साध कर अनुराग – युक्त विविध रागों के द्वारा किशोरी जी के गुणों को गाकर उन्हें प्रसन्न करता है । [2]\nएवं ‘धा – तिर – किट – धा – धा’ आदि नृत्य के शब्दों का उच्चारण करता हुआ विविध हाव – भाव द्वारा अलौकिक नृत्य करता है । ‘श्री कृपालु जी’ कहते हैं कि वह इस प्रकार सहज ही श्यामा – श्याम के दिव्य प्रेमानन्द का निरन्तर अनुभव करता हुआ कृतार्थ रहता है । [3]","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5976483e1350677a49620728/prem-ras-roop-agadha-radha-pad-written-by-jagadguru-shri-kripalu-ji-maharaj","slug":"prem-ras-rup-agadha-radha"}],"imageUrl":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","ragas","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","ragas","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"lang":"hi","children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","ht