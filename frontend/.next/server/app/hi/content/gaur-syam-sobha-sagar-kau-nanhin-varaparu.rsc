c:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"गौर स्याम सोभा सागर कौ, नाँहिन वारापारु | वृंदोपनिषद्"}],["$","meta","3",{"name":"description","content":"गौर स्याम सोभा सागर कौ, नाँहिन वारापारु |\nव्यास स्वामिनी की छबि आगैं, सकल सरूप उगारु ||\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\n\"युगल सरकार की शोभा..."}],["$","link","4",{"rel":"canonical","href":"https://path.vrindopnishad.in/hi/content/gaur-syam-sobha-sagar-kau-nanhin-varaparu"}],["$","meta","5",{"property":"og:title","content":"गौर स्याम सोभा सागर कौ, नाँहिन वारापारु | वृंदोपनिषद्"}],["$","meta","6",{"property":"og:description","content":"गौर स्याम सोभा सागर कौ, नाँहिन वारापारु |\nव्यास स्वामिनी की छबि आगैं, सकल सरूप उगारु ||\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\n\"युगल सरकार की शोभा..."}],["$","meta","7",{"property":"og:url","content":"https://path.vrindopnishad.in/hi/content/gaur-syam-sobha-sagar-kau-nanhin-varaparu"}],["$","meta","8",{"property":"og:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}],["$","meta","9",{"property":"og:image:width","content":"800"}],["$","meta","10",{"property":"og:image:height","content":"600"}],["$","meta","11",{"property":"og:image:alt","content":"गौर स्याम सोभा सागर कौ, नाँहिन वारापारु"}],["$","meta","12",{"property":"og:type","content":"article"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"गौर स्याम सोभा सागर कौ, नाँहिन वारापारु | वृंदोपनिषद्"}],["$","meta","15",{"name":"twitter:description","content":"गौर स्याम सोभा सागर कौ, नाँहिन वारापारु |\nव्यास स्वामिनी की छबि आगैं, सकल सरूप उगारु ||\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\n\"युगल सरकार की शोभा..."}],["$","meta","16",{"name":"twitter:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}]]
