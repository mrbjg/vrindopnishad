0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["hi",{"children":["content",{"children":[["slug","nagarata-ki-rasi-kisori","d"],{"children":["__PAGE__?{\"slug\":\"nagarata-ki-rasi-kisori\"}",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["hi",{"children":["content",{"children":[["slug","nagarata-ki-rasi-kisori","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"मुख्यपृष्ठ\",\"item\":\"https://path.vrindopnishad.in/hi\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"पुस्तकालय\",\"item\":\"https://path.vrindopnishad.in/hi/content\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"नागरता की रासि किसोरी\",\"item\":\"https://path.vrindopnishad.in/hi/content/nagarata-ki-rasi-kisori\"}]}"}}],["$","div",null,{"className":"max-w-6xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L3",null,{"href":"/hi","className":"hover:text-amber-400 transition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],[["$","$L3",null,{"href":"/hi/content","className":"hover:text-amber-400 transition-colors","children":"पुस्तकालय"}],["$","span",null,{"children":"→"}]],["$","span",null,{"className":"text-white/80 font-medium truncate max-w-[200px]","children":"नागरता की रासि किसोरी"}]]}],["$","$L4",null,{"children":["$","$L5",null,{"initialContent":{"id":"local-255","title":"नागरता की रासि किसोरी","category":"Shloka","sanskrit_text":"नागरता की रासि किसोरी।नव नागर कुल मौलि साँवरौ, वर बस किया चिते मुख मोरी।।रूप रुचिर अँग अँग माधुरी, बिनु भूषन भूषित ब्रज गोरी।छिन छिन कुसल सुधंग अंग में, कोक रभस रस सिंधु झकोरी।।चंचल रसिक मधुप मोहन मन, राखे कनक कमल कुच कोरी।प्रीतम नैन जुगल खंजन खग, बॉधे विविध निबंधनि डोरी ।।अवनी उदर नाभि सरसी में, मनौं कछुक मदिक मधु घोरी।(जे श्री) हित हरिवंश पिवत सुंदर वर, सींव सुदृढ़ निगमनि की तोरी।।","hindi_text":"भावार्थ- किशोरी राधिका सुन्दरता की राशि हैं। इन्होंने नव नागर समूह के भी सिरमौर श्याम सुन्दर को अपनी चितवन और ललितभाव से मुख मोड़ने की क्रिया से ही वश में कर लिया है। इनका रूप अत्यन्त रुचिर है और अङ्ग अङ्ग में माधुर्य है। ये व्रज गोरी विना भूषणों के ही भूषित है अर्थात् अत्यन्त रमणीय है। यह सुधङ्ग नृत्य के प्रत्येक अङ्ग में कुशल तो है ही अपितु एकान्तिक कोक विलास के रस समुद्र में भी प्रतिक्षण सराबोर सी हैं। इन्होंने परम चञ्चल रसिक मन मोहन भ्रमर के मन को अपने कनक जैसे कुच कमलो की कोर से ही अटका लिया है और प्रियतम के युगल नयन खञ्जन पक्षियों को भी (अपने रूप माधुर्य्य आदि) अनेक बन्धन डोरियों से बाँध रखा है।श्रीहित हरिवंशचन्द्र महाप्रभु पाद (सखी रूप से) कहते है इन परम सौन्दर्य मयी श्रीराधा ने अपने उदर रूप भूमि में स्थित नाभि कुण्डिका में कुछ एक मधुर एवं मादक रस घोल रखा है, जिसे सुन्दर शिरोमणि श्रीलालजी वेदों की भी सुदृढ़ मर्यादा-सीमाओं को तोड़कर उल्लंघन करके पी रहे हैं।","english_text":null,"english_translation":"Kishori Shri Radha is the treasure of beauty. She has forcibly captivated the crest jewel of all Rasiks, Lord Krishn by her charming nature and simply by moving her face in a gentle style. Her form is quite pleasing and nectar oozes from each and every pore of her body. This fair complexioned lady of Braj is looking gorgeous even without any ornaments. She is very much gracious. She is skilled in all types of divine dance arts. She has controlled the fickleness of Shri Krishn and Shri Krishna's eyes are so much captivated with divine form and sweetness of Shri Radha that He can’t look anywhere else. Shri Hita Harivansh Mahaprabhu descension of Shri Krishn's flute says, this supreme blissful Radha has put such a divine sweet and intoxicating nectar in her belly button that looking at which even Lord Krishn, the crest jewel of divine beauty is drinking such nectarine bliss unceasingly, giving no care to his steadfast principles of Scriptures in front of this divine bliss.","description":"https://www.brajrasik.org/hi/articles/5af7ed789f7ab760360f9c51/nagarta-ki-raasi-kishori-pada-from-hita-chaturasi-by-murali-avtaar-shri-hita-harivansh-mahaprabhu","author":"श्री हित हरिवंश महाप्रभु, श्री हित चतुरासी (82)","status":"published","content_text":"$6","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5af7ed789f7ab760360f9c51/nagarta-ki-raasi-kishori-pada-from-hita-chaturasi-by-murali-avtaar-shri-hita-harivansh-mahaprabhu","slug":"nagarata-ki-rasi-kisori"},"initialRelatedSaint":{"name":"श्री हित हरिवंश , श्री हित चतुरासी (82)","hinglishName":"shri hit harivnsh , shri hit chaturasi (82)","slug":"shri-hit-harivnsh-mahaprabhu","biography":"श्री हित हरिवंश महाप्रभु, श्री वृंदावन धाम के रसिक शिरोमणि संत और श्री कृष्ण की वंशी के अवतार हैं। वे श्री राधारानी को ही अपना गुरु और इष्ट मानते हैं और राधावल्लभ संप्रदाय के मुख्य आचार्य हैं। इनकी उपासना में मुख्य रूप से सहचरी भाव है, जिसमें श्री राधा चरण प्रधानता है।","metadata":null,"imageUrl":null,"verses":["$7"],"books":[],"rawItem":{"id":"saint-local-1","title":"श्री हित हरिवंश महाप्रभु","hindi_text":"श्री हित हरिवंश महाप्रभु, श्री वृंदावन धाम के रसिक शिरोमणि संत और श्री कृष्ण की वंशी के अवतार हैं। वे श्री राधारानी को ही अपना गुरु और इष्ट मानते हैं और राधावल्लभ संप्रदाय के मुख्य आचार्य हैं। इनकी उपासना में मुख्य रूप से सहचरी भाव है, जिसमें श्री राधा चरण प्रधानता है।","english_translation":"","description":"https://www.brajrasik.org/hi/tag/hitharivansh","tags":["Braj Rasik","Saint","Biography"],"author":"BrajRasik.org","category":"saint","slug":"shri-hit-harivnsh-mahaprabhu"}},"initialRelatedBook":null,"initialRelatedRaga":null,"initialRelatedVerses":[{"id":"local-0","title":"बनी श्रीराधा मोहन की जोरी","category":"Shloka","sanskrit_text":"बनी श्रीराधा मोहन की जोरी।इंद्र नील मनि स्याम मनोहर, सात कुंभ तनु गोरी।।भाल बिसाल तिलक हरि, कामिनि चिकुर चंद्र बिच रोरी।गज नाइक प्रभु चाल, गयंदनि गति वृषभानु किसोरी।।नील निचोल जुवति, मोहन पट पीत अरुन सिर खोरी।(जै श्री) हित हरिवंश रसिक राधा पति, सुरत रंग में बोरी।।","hindi_text":"भावार्थ-अति अनुपम जोड़ी है श्री राधा मोहन की। मनोहर श्याम सुन्दर इन्द्र नील मणि की भाँति हैं। तो वृषभानु किशोरी श्रीराधा काञ्चन तनु हैं।लाल के विशाल भाल पर तिलक शोभित है, तो कामिनि प्रिया की केश चन्द्रिका के मध्य (माँग) में रोरी लसित है। मोहन लाल की गति (चाल) मत्त गजराज जैसी मोहक और श्रीवृषभानु नन्दिनी की मत्त करिणी जैसी मद मथर है।नव तरुणि श्रीराधा के श्रीअंग में नीलाम्बर शोभित हैं और श्याम सुन्दर के श्यामाङ्ग पर पीत कौशेय धारण है। उपरोक्त नख शिख शृङ्गार की पूर्णता शिरोभाग पर लसित अरुण खोरी (छोर) कर रहा है। श्रीहित हरिवंश कहते हैं यह जोड़ी सौन्दर्थ्य एवं रस की सीमा है। राधापति श्रीकृष्ण रसिक चूडामणि हैं और श्रीराधा सूरत रस सिन्धु रूपा हैं जो रसिकों को नित्य रस देती हैं ।","english_text":null,"english_translation":"The divine couple, Shri Radha Krishn is all attractive and unique. All attractive Shri Shyam Sundar is effulgent like a blue sapphire and the daughter of Shri Vrishbhanu, Shri Radha is golden complexioned. The divine forehead of Shri Krishn is glorified with distinctive Tilak mark (his forehead is adorned by the mark of bright saffron), whereas beloved Radha rani has charming vermillion in her parting line of head. The walking style of Shri Krishn is most similar to that of the elephant, which is so captivating and Shri Radharani’s extraordinary style of walking is similar to that of an intoxicated elephant as well. Shri Radha wears attractive blue garments and Shri Krishn wears attractive yellow garments. Shri Hit Harivansh Mahaprabhu says, the beauty and bliss of this divine couple is limitless. Shri Krishn, the beloved one of Radha, is actually the crest jewel of all Rasiks and Shri Radha is never ending ocean of the blissful divine beauty who provides ceaseless bliss to the Rasiks.","description":"https://www.brajrasik.org/hi/articles/5b0d865c9f7ab760360f9c70/bani-shri-radha-mohan-ki-jori-shri-hita-harivansh-mahaprabhu-from-hit-chaturasi-09","author":"श्री हित हरिवंश , हित चतुरासी (09)","status":"published","content_text":"(राग बिलावल)\nबनी श्रीराधा मोहन की जोरी।\nइंद्र नील मनि स्याम मनोहर, सात कुंभ तनु गोरी।।\nभाल बिसाल तिलक हरि, कामिनि चिकुर चंद्र बिच रोरी।\nगज नाइक प्रभु चाल, गयंदनि गति वृषभानु किसोरी।।\nनील निचोल जुवति, मोहन पट पीत अरुन सिर खोरी।\n(जै श्री) हित हरिवंश रसिक राधा पति, सुरत रंग में बोरी।।\nश्री हित हरिवंश , हित चतुरासी (09)\nभावार्थ-अति अनुपम जोड़ी है श्री राधा मोहन की। मनोहर श्याम सुन्दर इन्द्र नील मणि की भाँति हैं। तो वृषभानु किशोरी श्रीराधा काञ्चन तनु हैं।लाल के विशाल भाल पर तिलक शोभित है, तो कामिनि प्रिया की केश चन्द्रिका के मध्य (माँग) में रोरी लसित है। मोहन लाल की गति (चाल) मत्त गजराज जैसी मोहक और श्रीवृषभानु नन्दिनी की मत्त करिणी जैसी मद मथर है।नव तरुणि श्रीराधा के श्रीअंग में नीलाम्बर शोभित हैं और श्याम सुन्दर के श्यामाङ्ग पर पीत कौशेय धारण है। उपरोक्त नख शिख शृङ्गार की पूर्णता शिरोभाग पर लसित अरुण खोरी (छोर) कर रहा है। श्रीहित हरिवंश कहते हैं यह जोड़ी सौन्दर्थ्य एवं रस की सीमा है। राधापति श्रीकृष्ण रसिक चूडामणि हैं और श्रीराधा सूरत रस सिन्धु रूपा हैं जो रसिकों को नित्य रस देती हैं ।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b0d865c9f7ab760360f9c70/bani-shri-radha-mohan-ki-jori-shri-hita-harivansh-mahaprabhu-from-hit-chaturasi-09","slug":"bani-shriradha-mohan-ki-jori"},{"id":"local-1","title":"राधा नाम को आधार","category":"Shloka","sanskrit_text":"राधा नाम को आधार,ललित लालवर रटत निरंतर, सरबस रस को सार ||सब गुण हीन मलीन दीन, अति पतितन में सरदार |ललित किशोरी तासु भरोसे सोवत पॉव पसार ||","hindi_text":"श्री ललित किशोरी जी कहते हैं की उनके जीवन का आधार एक मात्रा श्री राधा नाम ही है | यह वह दिव्य नाम है जो श्री लाल जी निरंतर रटन करते हैं एवं समस्त रस का मानो सार ही राधा नाम है | श्री ललित किशोरी जी\nके विनम्र शब्दों में, \"यूँ तो मैं गुण हीन, अशुद्ध हृदय युक्त, दीन एवं समस्त पतितों में शिरोमणि हूँ लेकिन केवल और केवल श्री राधा नाम एवं श्री किशोरीजी के बल से दोनों पॉंव पसार कर अर्थात निर्भय होकर सोता हूँ\" |","english_text":null,"english_translation":"Shri Lalit Kishori says, \"Shri Radha’s name is the foundation of his devotion. Shri Krishn the crest jewel of all the Rasiks, incessantly chants the same name, which is the essence of all the nectarian bliss. With humbleness, Shri Lalit Kishori says, although I am devoid of the entire expedient, my heart is awfully dirty and decayed. Thus I am an orphan from every point of view and leader of all the fallen souls. But still He says, simply by having a strong faith in Shri Radha’s name, he sleeps fearlessly.”","description":"https://www.brajrasik.org/hi/articles/5af9fc999f7ab760360f9c52/radha-naam-ko-aadhar-shri-lalit-kishori-abhilash-madhuri","author":"ललित किशोरी जी, अभिलाष माधुरी, विनय (२०५)","status":"published","content_text":"(राग देस)\nराधा नाम को आधार,\nललित लालवर रटत निरंतर, सरबस रस को सार ||\nसब गुण हीन मलीन दीन, अति पतितन में सरदार |\nललित किशोरी तासु भरोसे सोवत पॉव पसार ||\n- ललित किशोरी जी, अभिलाष माधुरी, विनय (२०५)\nश्री ललित किशोरी जी कहते हैं की उनके जीवन का आधार एक मात्रा श्री राधा नाम ही है | यह वह दिव्य नाम है जो श्री लाल जी निरंतर रटन करते हैं एवं समस्त रस का मानो सार ही राधा नाम है | श्री ललित किशोरी जी\nके विनम्र शब्दों में, \"यूँ तो मैं गुण हीन, अशुद्ध हृदय युक्त, दीन एवं समस्त पतितों में शिरोमणि हूँ लेकिन केवल और केवल श्री राधा नाम एवं श्री किशोरीजी के बल से दोनों पॉंव पसार कर अर्थात निर्भय होकर सोता हूँ\" |","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5af9fc999f7ab760360f9c52/radha-naam-ko-aadhar-shri-lalit-kishori-abhilash-madhuri","slug":"radha-nam-ko-adhara"},{"id":"local-3","title":"राधा नाम को उर धार","category":"Shloka","sanskrit_text":"राधा नाम को उर धार,मिलहिं रसिक मुकुटमणि मोहन आपहिं कुंजन द्वार,आठों जाम छकेंगी अँखियाँ छवि निकुंज विहार,ललित किशोरी फीके परिहैं सरवस सुख संसार ||","hindi_text":"आपको केवल राधा नाम को हृदय से धारण करना है, यह मान कर की किशोरीजी के नाम में वह बैठी हैं। आपको बिना प्रयास के ही श्याम सुन्दर कुञ्ज द्वार में मिल जाएंगे। श्री ललित किशोरीजी के शब्दों में राधा कृष्ण के रस को आठों याम अँखियाँ चखेंगी और निकुंज विहार रस प्राप्त होगा और संसार का समस्त बड़े से बड़ा सुख भी तुच्छ लगेगा।","english_text":null,"english_translation":"You have to keep Shri Radha's name in your heart all the time, believing the fact that she herself is seated in her name. You will be able to meet Shree Krishna on the gates of the Kunja, without any further efforts. In the words of Shri Lalit Kishoriji, your eyes will relish the ras (bliss) of Shri Radha Krishn at Nikunj Vihaar and even the greatest pleasures of the world will look immaterial (comparable to nothing).","description":"https://www.brajrasik.org/hi/articles/5a853a8b82274812fecf9694/radha-naam-ko-ur-dhar-pada-written-by-shri-lalit-kishori-abhilash-madhuri","author":"ललित किशोरी जी, अभिलाष माधुरी, विनय (२०४)","status":"published","content_text":"(राग देस)\nराधा नाम को उर धार,\nमिलहिं रसिक मुकुटमणि मोहन आपहिं कुंजन द्वार,\nआठों जाम छकेंगी अँखियाँ छवि निकुंज विहार,\nललित किशोरी फीके परिहैं सरवस सुख संसार ||\n- ललित किशोरी जी, अभिलाष माधुरी, विनय (२०४)\nआपको केवल राधा नाम को हृदय से धारण करना है, यह मान कर की किशोरीजी के नाम में वह बैठी हैं। आपको बिना प्रयास के ही श्याम सुन्दर कुञ्ज द्वार में मिल जाएंगे। श्री ललित किशोरीजी के शब्दों में राधा कृष्ण के रस को आठों याम अँखियाँ चखेंगी और निकुंज विहार रस प्राप्त होगा और संसार का समस्त बड़े से बड़ा सुख भी तुच्छ लगेगा।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5a853a8b82274812fecf9694/radha-naam-ko-ur-dhar-pada-written-by-shri-lalit-kishori-abhilash-madhuri","slug":"radha-nam-ko-ur-dhara"}]}]}]],null],null],null]},[null,["$","$Ld",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","content","children","$e","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Lf",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$Ld",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","content","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Lf",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"lang":"hi","children":["$","$Ld",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Lf",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L10",null,{"children":["$","$Ld",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Lf",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":"404"}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"notFoundStyles":[]}]}]}]}]],null],null],["$L11",null]]]]
11:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"नागरता की रासि किसोरी | वृंदोपनिषद्"}],["$","meta","3",{"name":"description","content":"भावार्थ- किशोरी राधिका सुन्दरता की राशि हैं। इन्होंने नव नागर समूह के भी सिरमौर श्याम सुन्दर को अपनी चितवन और ललितभाव से मुख मोड़ने की क्रिया से ही वश में ..."}],["$","link","4",{"rel":"canonical","href":"https://path.vrindopnishad.in/hi/content/nagarata-ki-rasi-kisori"}],["$","meta","5",{"property":"og:title","content":"नागरता की रासि किसोरी | वृंदोपनिषद्"}],["$","meta","6",{"property":"og:description","content":"भावार्थ- किशोरी राधिका सुन्दरता की राशि हैं। इन्होंने नव नागर समूह के भी सिरमौर श्याम सुन्दर को अपनी चितवन और ललितभाव से मुख मोड़ने की क्रिया से ही वश में ..."}],["$","meta","7",{"property":"og:url","content":"https://path.vrindopnishad.in/hi/content/nagarata-ki-rasi-kisori"}],["$","meta","8",{"property":"og:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}],["$","meta","9",{"property":"og:image:width","content":"800"}],["$","meta","10",{"property":"og:image:height","content":"600"}],["$","meta","11",{"property":"og:image:alt","content":"नागरता की रासि किसोरी"}],["$","meta","12",{"property":"og:type","content":"article"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"नागरता की रासि किसोरी | वृंदोपनिषद्"}],["$","meta","15",{"name":"twitter:description","content":"भावार्थ- किशोरी राधिका सुन्दरता की राशि हैं। इन्होंने नव नागर समूह के भी सिरमौर श्याम सुन्दर को अपनी चितवन और ललितभाव से मुख मोड़ने की क्रिया से ही वश में ..."}],["$","meta","16",{"name":"twitter:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}]]
