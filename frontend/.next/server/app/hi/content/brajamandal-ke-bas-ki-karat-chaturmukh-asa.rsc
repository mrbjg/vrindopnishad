e:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"ब्रजमण्डल के बास की, करत चतुर्मुख आस | वृंदोपनिषद्"}],["$","meta","3",{"name":"description","content":"ब्रजवास की आशा श्री ब्रह्मा जी भी नित्य करते हैं, ऐसे जीव धन्य हैं जिनका ब्रज में नित्य निवास है।"}],["$","link","4",{"rel":"canonical","href":"https://path.vrindopnishad.in/hi/content/brajamandal-ke-bas-ki-karat-chaturmukh-asa"}],["$","meta","5",{"property":"og:title","content":"ब्रजमण्डल के बास की, करत चतुर्मुख आस | वृंदोपनिषद्"}],["$","meta","6",{"property":"og:description","content":"ब्रजवास की आशा श्री ब्रह्मा जी भी नित्य करते हैं, ऐसे जीव धन्य हैं जिनका ब्रज में नित्य निवास है।"}],["$","meta","7",{"property":"og:url","content":"https://path.vrindopnishad.in/hi/content/brajamandal-ke-bas-ki-karat-chaturmukh-asa"}],["$","meta","8",{"property":"og:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}],["$","meta","9",{"property":"og:image:width","content":"800"}],["$","meta","10",{"property":"og:image:height","content":"600"}],["$","meta","11",{"property":"og:image:alt","content":"ब्रजमण्डल के बास की, करत चतुर्मुख आस"}],["$","meta","12",{"property":"og:type","content":"article"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"ब्रजमण्डल के बास की, करत चतुर्मुख आस | वृंदोपनिषद्"}],["$","meta","15",{"name":"twitter:description","content":"ब्रजवास की आशा श्री ब्रह्मा जी भी नित्य करते हैं, ऐसे जीव धन्य हैं जिनका ब्रज में नित्य निवास है।"}],["$","meta","16",{"name":"twitter:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}]]
