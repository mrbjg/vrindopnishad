0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["hi",{"children":["content",{"children":[["slug","suni-mero-vachan-chhabili-radha-tain-payo-ras-sindhu-agadha","d"],{"children":["__PAGE__?{\"slug\":\"suni-mero-vachan-chhabili-radha-tain-payo-ras-sindhu-agadha\"}",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["hi",{"children":["content",{"children":[["slug","suni-mero-vachan-chhabili-radha-tain-payo-ras-sindhu-agadha","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"मुख्यपृष्ठ\",\"item\":\"https://path.vrindopnishad.in/hi\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"पुस्तकालय\",\"item\":\"https://path.vrindopnishad.in/hi/content\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"सुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा\",\"item\":\"https://path.vrindopnishad.in/hi/content/suni-mero-vachan-chhabili-radha-tain-payo-ras-sindhu-agadha\"}]}"}}],["$","div",null,{"className":"max-w-6xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L3",null,{"href":"/hi","className":"hover:text-amber-400 transition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],[["$","$L3",null,{"href":"/hi/content","className":"hover:text-amber-400 transition-colors","children":"पुस्तकालय"}],["$","span",null,{"children":"→"}]],["$","span",null,{"className":"text-white/80 font-medium truncate max-w-[200px]","children":"सुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा"}]]}],["$","$L4",null,{"children":["$","$L5",null,{"initialContent":{"id":"local-421","title":"सुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा","category":"Shloka","sanskrit_text":"सुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा ।।तूँ वृषभानु गोप की बेटी, मोहनलाल रसिक हँसि भेंटी ।जाहि बिरंचि उमापति नाये, तापै तैं बन फूल बिनाये ।।जो रस नेति-नेति श्रुति भाख्यो, ताकौ तैं अधर सुधारस चाख्यौ ।तेरौ रूप कहत नहीं आवै, जै श्रीहित हरिवंश कछुक जस गावै ।","hindi_text":"(राग आसावरी)\nसुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा ।।\nतूँ वृषभानु गोप की बेटी, मोहनलाल रसिक हँसि भेंटी ।\nजाहि बिरंचि उमापति नाये, तापै तैं बन फूल बिनाये ।।\nजो रस नेति-नेति श्रुति भाख्यो, ताकौ तैं अधर सुधारस चाख्यौ ।\nतेरौ रूप कहत नहीं आवै, जै श्रीहित हरिवंश कछुक जस गावै ।\n- मुरली अवतार श्री हित हरिवंश महाप्रभु - श्री हित चतुरासी (18)\nभावार्थ- \"हे छविमयी राधे ! तू मेरी बात सुन ! तूने रस का गम्भीर समुद्र पाया है । यद्यपि तू वृषभानु गोप की ही बेटी है, फिर भी तूने प्रसन्नता पूर्वक रसिक मोहन लाल का आलिंगन किया है, जिन श्रीकृष्ण का नमन ब्रह्म और उमापति शङ्कर भी करते है, तूने उन्हों से फूल विनाये (चुनवाये) हैं । आरी ! जिस श्रीकृष्ण (परम पुरुष भगवान) के रस (लीला, प्रभाव, गुण माहात्म्य आदि) के लिये श्रुतियों ने भी (असमर्थता पूर्वक) नेति नेति कह दिया तूने तो उसका भी अधर रस पान किया है। राधे ! तेरा रूप तो कुछ कहने में ही नहीं आता, हित हरिवंश तो तेरा कुछ थोड़ा सा सुयश मात्र ही गा रहा है |","english_text":null,"english_translation":"Oh, Shri Radhey, Please listen to me, You have got the ultimate mine of bliss. You are the daughter of Shri Vrishbhanu and have lovingly embraced Shri Krishna. [1]\nThe supreme God Shri Krishn who is always worshipped by Lord Bhrama and Lord Shiva, has especially picked up flowers for you from the forest. Even Vedas declare Him as out of reach, and you can easily drink the nectar of His lips. [2]\nShri Hita Harivansh Mahaprabhu, the incarnation of Shri Krishn’s Murali says “By any means possible, Its utterly impossible to explain your divine beauty, and the glimpse in the words, Whatever I am explaining is just the fraction of it!” [3]","description":"https://www.brajrasik.org/hi/articles/5b7e7ee8506f44004fb01262/suni-mero-vachan-chabeeli-radha-shri-hita-harivansh-mahaprabhu-shri-hita-chaturasi-98","author":"मुरली अवतार श्री हित हरिवंश महाप्रभु  श्री हित चतुरासी (18)","status":"published","content_text":"(राग आसावरी)\nसुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा ।।\nतूँ वृषभानु गोप की बेटी, मोहनलाल रसिक हँसि भेंटी ।\nजाहि बिरंचि उमापति नाये, तापै तैं बन फूल बिनाये ।।\nजो रस नेति-नेति श्रुति भाख्यो, ताकौ तैं अधर सुधारस चाख्यौ ।\nतेरौ रूप कहत नहीं आवै, जै श्रीहित हरिवंश कछुक जस गावै ।\n- मुरली अवतार श्री हित हरिवंश महाप्रभु - श्री हित चतुरासी (18)\nभावार्थ- \"हे छविमयी राधे ! तू मेरी बात सुन ! तूने रस का गम्भीर समुद्र पाया है । यद्यपि तू वृषभानु गोप की ही बेटी है, फिर भी तूने प्रसन्नता पूर्वक रसिक मोहन लाल का आलिंगन किया है, जिन श्रीकृष्ण का नमन ब्रह्म और उमापति शङ्कर भी करते है, तूने उन्हों से फूल विनाये (चुनवाये) हैं । आरी ! जिस श्रीकृष्ण (परम पुरुष भगवान) के रस (लीला, प्रभाव, गुण माहात्म्य आदि) के लिये श्रुतियों ने भी (असमर्थता पूर्वक) नेति नेति कह दिया तूने तो उसका भी अधर रस पान किया है। राधे ! तेरा रूप तो कुछ कहने में ही नहीं आता, हित हरिवंश तो तेरा कुछ थोड़ा सा सुयश मात्र ही गा रहा है |","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b7e7ee8506f44004fb01262/suni-mero-vachan-chabeeli-radha-shri-hita-harivansh-mahaprabhu-shri-hita-chaturasi-98","slug":"suni-mero-vachan-chhabili-radha-tain-payo-ras-sindhu-agadha"},"initialRelatedSaint":{"name":"मुरली अवतार श्री हित हरिवंश   श्री हित चतुरासी (18)","hinglishName":"murali avatar shri hit harivnsh shri hit chaturasi (18)","slug":"shri-hit-harivnsh-mahaprabhu","biography":"श्री हित हरिवंश महाप्रभु, श्री वृंदावन धाम के रसिक शिरोमणि संत और श्री कृष्ण की वंशी के अवतार हैं। वे श्री राधारानी को ही अपना गुरु और इष्ट मानते हैं और राधावल्लभ संप्रदाय के मुख्य आचार्य हैं। इनकी उपासना में मुख्य रूप से सहचरी भाव है, जिसमें श्री राधा चरण प्रधानता है।","metadata":null,"imageUrl":null,"verses":["$6"],"books":[],"rawItem":{"id":"saint-local-1","title":"श्री हित हरिवंश महाप्रभु","hindi_text":"श्री हित हरिवंश महाप्रभु, श्री वृंदावन धाम के रसिक शिरोमणि संत और श्री कृष्ण की वंशी के अवतार हैं। वे श्री राधारानी को ही अपना गुरु और इष्ट मानते हैं और राधावल्लभ संप्रदाय के मुख्य आचार्य हैं। इनकी उपासना में मुख्य रूप से सहचरी भाव है, जिसमें श्री राधा चरण प्रधानता है।","english_translation":"","description":"https://www.brajrasik.org/hi/tag/hitharivansh","tags":["Braj Rasik","Saint","Biography"],"author":"BrajRasik.org","category":"saint","slug":"shri-hit-harivnsh-mahaprabhu"}},"initialRelatedBook":null,"initialRelatedRaga":{"name":"राग आसावरी","hinglishName":"rag asavari","slug":"rag-asavari","verses":["$6"],"imageUrl":null},"initialRelatedVerses":[{"id":"local-0","title":"बनी श्रीराधा मोहन की जोरी","category":"Shloka","sanskrit_text":"बनी श्रीराधा मोहन की जोरी।इंद्र नील मनि स्याम मनोहर, सात कुंभ तनु गोरी।।भाल बिसाल तिलक हरि, कामिनि चिकुर चंद्र बिच रोरी।गज नाइक प्रभु चाल, गयंदनि गति वृषभानु किसोरी।।नील निचोल जुवति, मोहन पट पीत अरुन सिर खोरी।(जै श्री) हित हरिवंश रसिक राधा पति, सुरत रंग में बोरी।।","hindi_text":"भावार्थ-अति अनुपम जोड़ी है श्री राधा मोहन की। मनोहर श्याम सुन्दर इन्द्र नील मणि की भाँति हैं। तो वृषभानु किशोरी श्रीराधा काञ्चन तनु हैं।लाल के विशाल भाल पर तिलक शोभित है, तो कामिनि प्रिया की केश चन्द्रिका के मध्य (माँग) में रोरी लसित है। मोहन लाल की गति (चाल) मत्त गजराज जैसी मोहक और श्रीवृषभानु नन्दिनी की मत्त करिणी जैसी मद मथर है।नव तरुणि श्रीराधा के श्रीअंग में नीलाम्बर शोभित हैं और श्याम सुन्दर के श्यामाङ्ग पर पीत कौशेय धारण है। उपरोक्त नख शिख शृङ्गार की पूर्णता शिरोभाग पर लसित अरुण खोरी (छोर) कर रहा है। श्रीहित हरिवंश कहते हैं यह जोड़ी सौन्दर्थ्य एवं रस की सीमा है। राधापति श्रीकृष्ण रसिक चूडामणि हैं और श्रीराधा सूरत रस सिन्धु रूपा हैं जो रसिकों को नित्य रस देती हैं ।","english_text":null,"english_translation":"The divine couple, Shri Radha Krishn is all attractive and unique. All attractive Shri Shyam Sundar is effulgent like a blue sapphire and the daughter of Shri Vrishbhanu, Shri Radha is golden complexioned. The divine forehead of Shri Krishn is glorified with distinctive Tilak mark (his forehead is adorned by the mark of bright saffron), whereas beloved Radha rani has charming vermillion in her parting line of head. The walking style of Shri Krishn is most similar to that of the elephant, which is so captivating and Shri Radharani’s extraordinary style of walking is similar to that of an intoxicated elephant as well. Shri Radha wears attractive blue garments and Shri Krishn wears attractive yellow garments. Shri Hit Harivansh Mahaprabhu says, the beauty and bliss of this divine couple is limitless. Shri Krishn, the beloved one of Radha, is actually the crest jewel of all Rasiks and Shri Radha is never ending ocean of the blissful divine beauty who provides ceaseless bliss to the Rasiks.","description":"https://www.brajrasik.org/hi/articles/5b0d865c9f7ab760360f9c70/bani-shri-radha-mohan-ki-jori-shri-hita-harivansh-mahaprabhu-from-hit-chaturasi-09","author":"श्री हित हरिवंश , हित चतुरासी (09)","status":"published","content_text":"(राग बिलावल)\nबनी श्रीराधा मोहन की जोरी।\nइंद्र नील मनि स्याम मनोहर, सात कुंभ तनु गोरी।।\nभाल बिसाल तिलक हरि, कामिनि चिकुर चंद्र बिच रोरी।\nगज नाइक प्रभु चाल, गयंदनि गति वृषभानु किसोरी।।\nनील निचोल जुवति, मोहन पट पीत अरुन सिर खोरी।\n(जै श्री) हित हरिवंश रसिक राधा पति, सुरत रंग में बोरी।।\nश्री हित हरिवंश , हित चतुरासी (09)\nभावार्थ-अति अनुपम जोड़ी है श्री राधा मोहन की। मनोहर श्याम सुन्दर इन्द्र नील मणि की भाँति हैं। तो वृषभानु किशोरी श्रीराधा काञ्चन तनु हैं।लाल के विशाल भाल पर तिलक शोभित है, तो कामिनि प्रिया की केश चन्द्रिका के मध्य (माँग) में रोरी लसित है। मोहन लाल की गति (चाल) मत्त गजराज जैसी मोहक और श्रीवृषभानु नन्दिनी की मत्त करिणी जैसी मद मथर है।नव तरुणि श्रीराधा के श्रीअंग में नीलाम्बर शोभित हैं और श्याम सुन्दर के श्यामाङ्ग पर पीत कौशेय धारण है। उपरोक्त नख शिख शृङ्गार की पूर्णता शिरोभाग पर लसित अरुण खोरी (छोर) कर रहा है। श्रीहित हरिवंश कहते हैं यह जोड़ी सौन्दर्थ्य एवं रस की सीमा है। राधापति श्रीकृष्ण रसिक चूडामणि हैं और श्रीराधा सूरत रस सिन्धु रूपा हैं जो रसिकों को नित्य रस देती हैं ।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b0d865c9f7ab760360f9c70/bani-shri-radha-mohan-ki-jori-shri-hita-harivansh-mahaprabhu-from-hit-chaturasi-09","slug":"bani-shriradha-mohan-ki-jori"},{"id":"local-1","title":"राधा नाम को आधार","category":"Shloka","sanskrit_text":"राधा नाम को आधार,ललित लालवर रटत निरंतर, सरबस रस को सार ||सब गुण हीन मलीन दीन, अति पतितन में सरदार |ललित किशोरी तासु भरोसे सोवत पॉव पसार ||","hindi_text":"श्री ललित किशोरी जी कहते हैं की उनके जीवन का आधार एक मात्रा श्री राधा नाम ही है | यह वह दिव्य नाम है जो श्री लाल जी निरंतर रटन करते हैं एवं समस्त रस का मानो सार ही राधा नाम है | श्री ललित किशोरी जी\nके विनम्र शब्दों में, \"यूँ तो मैं गुण हीन, अशुद्ध हृदय युक्त, दीन एवं समस्त पतितों में शिरोमणि हूँ लेकिन केवल और केवल श्री राधा नाम एवं श्री किशोरीजी के बल से दोनों पॉंव पसार कर अर्थात निर्भय होकर सोता हूँ\" |","english_text":null,"english_translation":"Shri Lalit Kishori says, \"Shri Radha’s name is the foundation of his devotion. Shri Krishn the crest jewel of all the Rasiks, incessantly chants the same name, which is the essence of all the nectarian bliss. With humbleness, Shri Lalit Kishori says, although I am devoid of the entire expedient, my heart is awfully dirty and decayed. Thus I am an orphan from every point of view and leader of all the fallen souls. But still He says, simply by having a strong faith in Shri Radha’s name, he sleeps fearlessly.”","description":"https://www.brajrasik.org/hi/articles/5af9fc999f7ab760360f9c52/radha-naam-ko-aadhar-shri-lalit-kishori-abhilash-madhuri","author":"ललित किशोरी जी, अभिलाष माधुरी, विनय (२०५)","status":"published","content_text":"(राग देस)\nराधा नाम को आधार,\nललित लालवर रटत निरंतर, सरबस रस को सार ||\nसब गुण हीन मलीन दीन, अति पतितन में सरदार |\nललित किशोरी तासु भरोसे सोवत पॉव पसार ||\n- ललित किशोरी जी, अभिलाष माधुरी, विनय (२०५)\nश्री ललित किशोरी जी कहते हैं की उनके जीवन का आधार एक मात्रा श्री राधा नाम ही है | यह वह दिव्य नाम है जो श्री लाल जी निरंतर रटन करते हैं एवं समस्त रस का मानो सार ही राधा नाम है | श्री ललित किशोरी जी\nके विनम्र शब्दों में, \"यूँ तो मैं गुण हीन, अशुद्ध हृदय युक्त, दीन एवं समस्त पतितों में शिरोमणि हूँ लेकिन केवल और केवल श्री राधा नाम एवं श्री किशोरीजी के बल से दोनों पॉंव पसार कर अर्थात निर्भय होकर सोता हूँ\" |","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5af9fc999f7ab760360f9c52/radha-naam-ko-aadhar-shri-lalit-kishori-abhilash-madhuri","slug":"radha-nam-ko-adhara"},{"id":"local-3","title":"राधा नाम को उर धार","category":"Shloka","sanskrit_text":"राधा नाम को उर धार,मिलहिं रसिक मुकुटमणि मोहन आपहिं कुंजन द्वार,आठों जाम छकेंगी अँखियाँ छवि निकुंज विहार,ललित किशोरी फीके परिहैं सरवस सुख संसार ||","hindi_text":"आपको केवल राधा नाम को हृदय से धारण करना है, यह मान कर की किशोरीजी के नाम में वह बैठी हैं। आपको बिना प्रयास के ही श्याम सुन्दर कुञ्ज द्वार में मिल जाएंगे। श्री ललित किशोरीजी के शब्दों में राधा कृष्ण के रस को आठों याम अँखियाँ चखेंगी और निकुंज विहार रस प्राप्त होगा और संसार का समस्त बड़े से बड़ा सुख भी तुच्छ लगेगा।","english_text":null,"english_translation":"You have to keep Shri Radha's name in your heart all the time, believing the fact that she herself is seated in her name. You will be able to meet Shree Krishna on the gates of the Kunja, without any further efforts. In the words of Shri Lalit Kishoriji, your eyes will relish the ras (bliss) of Shri Radha Krishn at Nikunj Vihaar and even the greatest pleasures of the world will look immaterial (comparable to nothing).","description":"https://www.brajrasik.org/hi/articles/5a853a8b82274812fecf9694/radha-naam-ko-ur-dhar-pada-written-by-shri-lalit-kishori-abhilash-madhuri","author":"ललित किशोरी जी, अभिलाष माधुरी, विनय (२०४)","status":"published","content_text":"(राग देस)\nराधा नाम को उर धार,\nमिलहिं रसिक मुकुटमणि मोहन आपहिं कुंजन द्वार,\nआठों जाम छकेंगी अँखियाँ छवि निकुंज विहार,\nललित किशोरी फीके परिहैं सरवस सुख संसार ||\n- ललित किशोरी जी, अभिलाष माधुरी, विनय (२०४)\nआपको केवल राधा नाम को हृदय से धारण करना है, यह मान कर की किशोरीजी के नाम में वह बैठी हैं। आपको बिना प्रयास के ही श्याम सुन्दर कुञ्ज द्वार में मिल जाएंगे। श्री ललित किशोरीजी के शब्दों में राधा कृष्ण के रस को आठों याम अँखियाँ चखेंगी और निकुंज विहार रस प्राप्त होगा और संसार का समस्त बड़े से बड़ा सुख भी तुच्छ लगेगा।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5a853a8b82274812fecf9694/radha-naam-ko-ur-dhar-pada-written-by-shri-lalit-kishori-abhilash-madhuri","slug":"radha-nam-ko-ur-dhara"}]}]}]],null],null],null]},[null,["$","$Lb",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","content","children","$c","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$Lb",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","content","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"lang":"hi","children":["$","$Lb",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$Le",null,{"children":["$","$Lb",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":"404"}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"notFoundStyles":[]}]}]}]}]],null],null],["$Lf",null]]]]
f:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"सुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा | वृंदोपनिषद्"}],["$","meta","3",{"name":"description","content":"(राग आसावरी)\nसुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा ।।\nतूँ वृषभानु गोप की बेटी, मोहनलाल रसिक हँसि भेंटी ।\nजाहि बिरंचि उमापति नाये, तापै तैं बन फ..."}],["$","link","4",{"rel":"canonical","href":"https://path.vrindopnishad.in/hi/content/suni-mero-vachan-chhabili-radha-tain-payo-ras-sindhu-agadha"}],["$","meta","5",{"property":"og:title","content":"सुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा | वृंदोपनिषद्"}],["$","meta","6",{"property":"og:description","content":"(राग आसावरी)\nसुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा ।।\nतूँ वृषभानु गोप की बेटी, मोहनलाल रसिक हँसि भेंटी ।\nजाहि बिरंचि उमापति नाये, तापै तैं बन फ..."}],["$","meta","7",{"property":"og:url","content":"https://path.vrindopnishad.in/hi/content/suni-mero-vachan-chhabili-radha-tain-payo-ras-sindhu-agadha"}],["$","meta","8",{"property":"og:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}],["$","meta","9",{"property":"og:image:width","content":"800"}],["$","meta","10",{"property":"og:image:height","content":"600"}],["$","meta","11",{"property":"og:image:alt","content":"सुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा"}],["$","meta","12",{"property":"og:type","content":"article"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"सुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा | वृंदोपनिषद्"}],["$","meta","15",{"name":"twitter:description","content":"(राग आसावरी)\nसुनि मेरो वचन छबीली राधा, तैं पायो रस सिंधु अगाधा ।।\nतूँ वृषभानु गोप की बेटी, मोहनलाल रसिक हँसि भेंटी ।\nजाहि बिरंचि उमापति नाये, तापै तैं बन फ..."}],["$","meta","16",{"name":"twitter:image","content":"https://vrindopnishad.in/Vrindopnishad%20W