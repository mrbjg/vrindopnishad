0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["hi",{"children":["content",{"children":[["slug","jayati-nav-nagari-krishna","d"],{"children":["__PAGE__?{\"slug\":\"jayati-nav-nagari-krishna\"}",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["hi",{"children":["content",{"children":[["slug","jayati-nav-nagari-krishna","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"मुख्यपृष्ठ\",\"item\":\"https://path.vrindopnishad.in/hi\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"पुस्तकालय\",\"item\":\"https://path.vrindopnishad.in/hi/content\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"जयति नव नागरी , कृष्ण\",\"item\":\"https://path.vrindopnishad.in/hi/content/jayati-nav-nagari-krishna\"}]}"}}],["$","div",null,{"className":"max-w-6xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L3",null,{"href":"/hi","className":"hover:text-amber-400 transition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],[["$","$L3",null,{"href":"/hi/content","className":"hover:text-amber-400 transition-colors","children":"पुस्तकालय"}],["$","span",null,{"children":"→"}]],["$","span",null,{"className":"text-white/80 font-medium truncate max-w-[200px]","children":"जयति नव नागरी , कृष्ण"}]]}],["$","$L4",null,{"children":["$","$L5",null,{"initialContent":{"id":"local-121","title":"जयति नव नागरी , कृष्ण","category":"Shloka","sanskrit_text":"जयति नव नागरी , कृष्ण-सुख-सागरी ,सकल गुन-आगरी , दीनन भोरी !जयति हरि-भामिनि , कृष्ण-घन-दामिनी ,मत्त गज-गामिनी , नव किशोरी !!जयति पिय-केलि हित, कनक नव बेलिसमकृष्ण कलकलप निसि मिलि बिलासिनी !जयति वृषभान-कुल-कुमुद-बन-कुमुदिनी ,कृष्ण-सुख हिमकर निरख प्रकासिनी !!जयति गोपाल मन-मधुप नव मालती ,जयति गोविंद-मुख-कमल-भृंगी !जयति नँदनंदन-उर, परम आनंद-निधि ,लाल गिरिधरन पिय-प्रेम-रंगी !!जयति सौभाग्य-मनि , कृष्ण-अनुराग-मनि,सकल पिय मुकुट-मनि , सुजस लीजै !दीजियै दान यह \"व्यास' निज दास कों ,कृष्ण सों बहुरि नहिं मान कीजै !!","hindi_text":"(राग केदारो व कामोद)\nजयति नव नागरी , कृष्ण-सुख-सागरी ,\nसकल गुन-आगरी , दीनन भोरी !\nजयति हरि-भामिनि , कृष्ण-घन-दामिनी ,\nमत्त गज-गामिनी , नव किशोरी !!\nजयति पिय-केलि हित, कनक नव बेलिसम\nकृष्ण कलकलप निसि मिलि बिलासिनी !\nजयति वृषभान-कुल-कुमुद-बन-कुमुदिनी ,\nकृष्ण-सुख हिमकर निरख प्रकासिनी !!\nजयति गोपाल मन-मधुप नव मालती ,\nजयति गोविंद-मुख-कमल-भृंगी !\nजयति नँदनंदन-उर, परम आनंद-निधि ,\nलाल गिरिधरन पिय-प्रेम-रंगी !!\nजयति सौभाग्य-मनि , कृष्ण-अनुराग-मनि,\nसकल पिय मुकुट-मनि , सुजस लीजै !\nदीजियै दान यह \"व्यास' निज दास कों ,\nकृष्ण सों बहुरि नहिं मान कीजै !!\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी, पूर्वार्ध (47)","english_text":null,"english_translation":null,"description":"https://www.brajrasik.org/hi/articles/5b44cf159f7ab760360f9cd5/jayati-nava-nagari-krishn-sukh-sagari-by-shri-hariram-vyas-from-vyas-vani","author":"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी, पूर्वार्ध (47)","status":"published","content_text":"(राग केदारो व कामोद)\nजयति नव नागरी , कृष्ण-सुख-सागरी ,\nसकल गुन-आगरी , दीनन भोरी !\nजयति हरि-भामिनि , कृष्ण-घन-दामिनी ,\nमत्त गज-गामिनी , नव किशोरी !!\nजयति पिय-केलि हित, कनक नव बेलिसम\nकृष्ण कलकलप निसि मिलि बिलासिनी !\nजयति वृषभान-कुल-कुमुद-बन-कुमुदिनी ,\nकृष्ण-सुख हिमकर निरख प्रकासिनी !!\nजयति गोपाल मन-मधुप नव मालती ,\nजयति गोविंद-मुख-कमल-भृंगी !\nजयति नँदनंदन-उर, परम आनंद-निधि ,\nलाल गिरिधरन पिय-प्रेम-रंगी !!\nजयति सौभाग्य-मनि , कृष्ण-अनुराग-मनि,\nसकल पिय मुकुट-मनि , सुजस लीजै !\nदीजियै दान यह \"व्यास' निज दास कों ,\nकृष्ण सों बहुरि नहिं मान कीजै !!\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी, पूर्वार्ध (47)","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b44cf159f7ab760360f9cd5/jayati-nava-nagari-krishn-sukh-sagari-by-shri-hariram-vyas-from-vyas-vani","slug":"jayati-nav-nagari-krishna"},"initialRelatedSaint":{"name":"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी, पूर्वार्ध (47)","hinglishName":"shri hariram vyas (vishakha avatara) vyas vani, purvardh (47)","slug":"shri-hariram-vyas-vishakha-avatara-vyas-vani-purvardh-47","biography":"","metadata":{"lineageEn":"Vaishnav Rasik Tradition (Haritrayi)","lineageHi":"वैष्णव रसिक परंपरा (हरित्रयी)","timelineEn":"1510–1612 AD","timelineHi":"1510–1612 ईस्वी","associatedPlacesEn":"Vyas Ghera, Vrindavan","associatedPlacesHi":"व्यास घेरा, वृंदावन","discipleOfEn":"Shri Madhavdas Bhatta (disciple of Hit Harivansh)","discipleOfHi":"श्री माधवदास भट्ट जी (हित हरिवंश महाप्रभु के शिष्य)","influencedByEn":"Swami Haridas and Shri Hit Harivansh Mahaprabhu (forming the Haritrayi)","influencedByHi":"स्वामी हरिदास एवं श्री हित हरिवंश महाप्रभु (हरित्रयी परंपरा)","associatedSampradayaEn":"Radhavallabh / Haritrayi Tradition","associatedSampradayaHi":"राधावल्लभ / हरित्रयी परंपरा","devotionalMoodEn":"Humility, Raganuga Bhakti, Sakhi Bhava","devotionalMoodHi":"परम विनम्रता, रागानुगा भक्ति, सखी भाव","teachingsEn":"Emphasized pure, unadorned devotion based on absolute humility, rejection of caste pride, and criticism of ritualistic hypocrisy. Believed that only a humble heart can experience the sweet nectar of Vrindavan.","teachingsHi":"जाति-पाति के अभिमान का त्याग, बाह्य कर्मकांडों का विरोध और परम विनम्रता पर आधारित भक्ति। उनका मानना था कि केवल अहंकार रहित हृदय ही वृंदावन रस का अधिकारी है।","literaryStyleEn":"Author of Vyas Vani (व्यास वाणी), written in bold, direct Braj Bhasha. His verses contain both ecstatic descriptions of the Divine Couple and sharp, instructional remarks on behavior and sincerity.","literaryStyleHi":"'Vyas Vani' के रचयिता, जो अपनी स्पष्टवादिता और ठेठ ब्रजभाषा के लिए जानी जाती है। इनके पदों में लीला रस के साथ-साथ साधकों के लिए व्यावहारिक उपदेश भी प्रचुरता में हैं।","biographyEn":"Shri Hariram Vyas, affectionately known as Vyas Ji, was a prominent contemporary of Swami Haridas and Hit Harivansh Mahaprabhu. Together, these three saints are celebrated as the \"Haritrayi\" (spiritual triad) of Vrindavan, who established the foundations of Rasik theology. Born in Orchha, Madhya Pradesh, Hariram Vyas left his high royal position and vast scholarship to live as a humble beggar in the dust of Vrindavan. He established his ashram at Vyas Ghera and worshiped the deity of Jugal Kishor Ji. His writings are famously candid, warning devotees against spiritual vanity and urging them to seek the shelter of true saintly association (Sadhu Sanga).","biographyHi":"श्री हरिराम व्यास (व्यास जी) वृंदावन के ऐतिहासिक त्रिमूर्ति 'हरित्रयी' के तीसरे स्तम्भ थे। वे ओरछा के एक प्रतिष्ठित विद्वान थे, परंतु सब कुछ त्यागकर वृंदावन की धूल में आ बसे। उन्होंने व्यास घेरा में रहकर युगल किशोर जी की सेवा की। व्यास जी अपनी बेबाक और स्पष्ट टिप्पणियों के लिए प्रसिद्ध थे। उन्होंने संतों के प्रति अपराध और वैष्णवों में आपसी भेद का कड़ा विरोध किया और सरल प्रेम मार्ग को ही सर्वोत्तम बताया।","relatedSaints":[{"nameEn":"Swami Haridas","nameHi":"स्वामी हरिदास","slug":"haridas"},{"nameEn":"Shri Hit Harivansh","nameHi":"श्री हित हरिवंश","slug":"hit-harivansh"}],"relatedGranthas":[{"nameEn":"Vyas Vani","nameHi":"व्यास वाणी","slug":"vyas-vani"}],"associatedGlossary":[{"termEn":"Sadhana","termHi":"साधना","slug":"sadhana"},{"termEn":"Saranagati","termHi":"शरणागति","slug":"saranagati"},{"termEn":"Braj Bhasha","termHi":"ब्रजभाषा","slug":"braj-bhasha"}],"faq":[{"qEn":"Where is Vyas Ghera located?","aEn":"Vyas Ghera is located in Vrindavan near the Yamuna river, serving as the historical bhajan site and samadhi of Hariram Vyas Ji.","qHi":"व्यास घेरा कहाँ स्थित है?","aHi":"व्यास घेरा वृंदावन में यमुना नदी के समीप स्थित है, जो हरीराम व्यास जी की भजन स्थली और उनकी समाधि स्थली है।"}]},"imageUrl":null,"verses":["$6"],"books":[],"rawItem":null},"initialRelatedBook":null,"initialRelatedRaga":{"name":"राग केदारो","hinglishName":"rag kedaro","slug":"rag-kedaro","verses":["$6"],"imageUrl":null},"initialRelatedVerses":[{"id":"local-0","title":"बनी श्रीराधा मोहन की जोरी","category":"Shloka","sanskrit_text":"बनी श्रीराधा मोहन की जोरी।इंद्र नील मनि स्याम मनोहर, सात कुंभ तनु गोरी।।भाल बिसाल तिलक हरि, कामिनि चिकुर चंद्र बिच रोरी।गज नाइक प्रभु चाल, गयंदनि गति वृषभानु किसोरी।।नील निचोल जुवति, मोहन पट पीत अरुन सिर खोरी।(जै श्री) हित हरिवंश रसिक राधा पति, सुरत रंग में बोरी।।","hindi_text":"भावार्थ-अति अनुपम जोड़ी है श्री राधा मोहन की। मनोहर श्याम सुन्दर इन्द्र नील मणि की भाँति हैं। तो वृषभानु किशोरी श्रीराधा काञ्चन तनु हैं।लाल के विशाल भाल पर तिलक शोभित है, तो कामिनि प्रिया की केश चन्द्रिका के मध्य (माँग) में रोरी लसित है। मोहन लाल की गति (चाल) मत्त गजराज जैसी मोहक और श्रीवृषभानु नन्दिनी की मत्त करिणी जैसी मद मथर है।नव तरुणि श्रीराधा के श्रीअंग में नीलाम्बर शोभित हैं और श्याम सुन्दर के श्यामाङ्ग पर पीत कौशेय धारण है। उपरोक्त नख शिख शृङ्गार की पूर्णता शिरोभाग पर लसित अरुण खोरी (छोर) कर रहा है। श्रीहित हरिवंश कहते हैं यह जोड़ी सौन्दर्थ्य एवं रस की सीमा है। राधापति श्रीकृष्ण रसिक चूडामणि हैं और श्रीराधा सूरत रस सिन्धु रूपा हैं जो रसिकों को नित्य रस देती हैं ।","english_text":null,"english_translation":"The divine couple, Shri Radha Krishn is all attractive and unique. All attractive Shri Shyam Sundar is effulgent like a blue sapphire and the daughter of Shri Vrishbhanu, Shri Radha is golden complexioned. The divine forehead of Shri Krishn is glorified with distinctive Tilak mark (his forehead is adorned by the mark of bright saffron), whereas beloved Radha rani has charming vermillion in her parting line of head. The walking style of Shri Krishn is most similar to that of the elephant, which is so captivating and Shri Radharani’s extraordinary style of walking is similar to that of an intoxicated elephant as well. Shri Radha wears attractive blue garments and Shri Krishn wears attractive yellow garments. Shri Hit Harivansh Mahaprabhu says, the beauty and bliss of this divine couple is limitless. Shri Krishn, the beloved one of Radha, is actually the crest jewel of all Rasiks and Shri Radha is never ending ocean of the blissful divine beauty who provides ceaseless bliss to the Rasiks.","description":"https://www.brajrasik.org/hi/articles/5b0d865c9f7ab760360f9c70/bani-shri-radha-mohan-ki-jori-shri-hita-harivansh-mahaprabhu-from-hit-chaturasi-09","author":"श्री हित हरिवंश , हित चतुरासी (09)","status":"published","content_text":"(राग बिलावल)\nबनी श्रीराधा मोहन की जोरी।\nइंद्र नील मनि स्याम मनोहर, सात कुंभ तनु गोरी।।\nभाल बिसाल तिलक हरि, कामिनि चिकुर चंद्र बिच रोरी।\nगज नाइक प्रभु चाल, गयंदनि गति वृषभानु किसोरी।।\nनील निचोल जुवति, मोहन पट पीत अरुन सिर खोरी।\n(जै श्री) हित हरिवंश रसिक राधा पति, सुरत रंग में बोरी।।\nश्री हित हरिवंश , हित चतुरासी (09)\nभावार्थ-अति अनुपम जोड़ी है श्री राधा मोहन की। मनोहर श्याम सुन्दर इन्द्र नील मणि की भाँति हैं। तो वृषभानु किशोरी श्रीराधा काञ्चन तनु हैं।लाल के विशाल भाल पर तिलक शोभित है, तो कामिनि प्रिया की केश चन्द्रिका के मध्य (माँग) में रोरी लसित है। मोहन लाल की गति (चाल) मत्त गजराज जैसी मोहक और श्रीवृषभानु नन्दिनी की मत्त करिणी जैसी मद मथर है।नव तरुणि श्रीराधा के श्रीअंग में नीलाम्बर शोभित हैं और श्याम सुन्दर के श्यामाङ्ग पर पीत कौशेय धारण है। उपरोक्त नख शिख शृङ्गार की पूर्णता शिरोभाग पर लसित अरुण खोरी (छोर) कर रहा है। श्रीहित हरिवंश कहते हैं यह जोड़ी सौन्दर्थ्य एवं रस की सीमा है। राधापति श्रीकृष्ण रसिक चूडामणि हैं और श्रीराधा सूरत रस सिन्धु रूपा हैं जो रसिकों को नित्य रस देती हैं ।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b0d865c9f7ab760360f9c70/bani-shri-radha-mohan-ki-jori-shri-hita-harivansh-mahaprabhu-from-hit-chaturasi-09","slug":"bani-shriradha-mohan-ki-jori"},{"id":"local-1","title":"राधा नाम को आधार","category":"Shloka","sanskrit_text":"राधा नाम को आधार,ललित लालवर रटत निरंतर, सरबस रस को सार ||सब गुण हीन मलीन दीन, अति पतितन में सरदार |ललित किशोरी तासु भरोसे सोवत पॉव पसार ||","hindi_text":"श्री ललित किशोरी जी कहते हैं की उनके जीवन का आधार एक मात्रा श्री राधा नाम ही है | यह वह दिव्य नाम है जो श्री लाल जी निरंतर रटन करते हैं एवं समस्त रस का मानो सार ही राधा नाम है | श्री ललित किशोरी जी\nके विनम्र शब्दों में, \"यूँ तो मैं गुण हीन, अशुद्ध हृदय युक्त, दीन एवं समस्त पतितों में शिरोमणि हूँ लेकिन केवल और केवल श्री राधा नाम एवं श्री किशोरीजी के बल से दोनों पॉंव पसार कर अर्थात निर्भय होकर सोता हूँ\" |","english_text":null,"english_translation":"Shri Lalit Kishori says, \"Shri Radha’s name is the foundation of his devotion. Shri Krishn the crest jewel of all the Rasiks, incessantly chants the same name, which is the essence of all the nectarian bliss. With humbleness, Shri Lalit Kishori says, although I am devoid of the entire expedient, my heart is awfully dirty and decayed. Thus I am an orphan from every point of view and leader of all the fallen souls. But still He says, simply by having a strong faith in Shri Radha’s name, he sleeps fearlessly.”","description":"https://www.brajrasik.org/hi/articles/5af9fc999f7ab760360f9c52/radha-naam-ko-aadhar-shri-lalit-kishori-abhilash-madhuri","author":"ललित किशोरी जी, अभिलाष माधुरी, विनय (२०५)","status":"published","content_text":"(राग देस)\nराधा नाम को आधार,\nललित लालवर रटत निरंतर, सरबस रस को सार ||\nसब गुण हीन मलीन दीन, अति पतितन में सरदार |\nललित किशोरी तासु भरोसे सोवत पॉव पसार ||\n- ललित किशोरी जी, अभिलाष माधुरी, विनय (२०५)\nश्री ललित किशोरी जी कहते हैं की उनके जीवन का आधार एक मात्रा श्री राधा नाम ही है | यह वह दिव्य नाम है जो श्री लाल जी निरंतर रटन करते हैं एवं समस्त रस का मानो सार ही राधा नाम है | श्री ललित किशोरी जी\nके विनम्र शब्दों में, \"यूँ तो मैं गुण हीन, अशुद्ध हृदय युक्त, दीन एवं समस्त पतितों में शिरोमणि हूँ लेकिन केवल और केवल श्री राधा नाम एवं श्री किशोरीजी के बल से दोनों पॉंव पसार कर अर्थात निर्भय होकर सोता हूँ\" |","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5af9fc999f7ab760360f9c52/radha-naam-ko-aadhar-shri-lalit-kishori-abhilash-madhuri","slug":"radha-nam-ko-adhara"},{"id":"local-3","title":"राधा नाम को उर धार","category":"Shloka","sanskrit_text":"राधा नाम को उर धार,मिलहिं रसिक मुकुटमणि मोहन आपहिं कुंजन द्वार,आठों जाम छकेंगी अँखियाँ छवि निकुंज विहार,ललित किशोरी फीके परिहैं सरवस सुख संसार ||","hindi_text":"आपको केवल राधा नाम को हृदय से धारण करना है, यह मान कर की किशोरीजी के नाम में वह बैठी हैं। आपको बिना प्रयास के ही श्याम सुन्दर कुञ्ज द्वार में मिल जाएंगे। श्री ललित किशोरीजी के शब्दों में राधा कृष्ण के रस को आठों याम अँखियाँ चखेंगी और निकुंज विहार रस प्राप्त होगा और संसार का समस्त बड़े से बड़ा सुख भी तुच्छ लगेगा।","english_text":null,"english_translation":"You have to keep Shri Radha's name in your heart all the time, believing the fact that she herself is seated in her name. You will be able to meet Shree Krishna on the gates of the Kunja, without any further efforts. In the words of Shri Lalit Kishoriji, your eyes will relish the ras (bliss) of Shri Radha Krishn at Nikunj Vihaar and even the greatest pleasures of the world will look immaterial (comparable to nothing).","description":"https://www.brajrasik.org/hi/articles/5a853a8b82274812fecf9694/radha-naam-ko-ur-dhar-pada-written-by-shri-lalit-kishori-abhilash-madhuri","author":"ललित किशोरी जी, अभिलाष माधुरी, विनय (२०४)","status":"published","content_text":"(राग देस)\nराधा नाम को उर धार,\nमिलहिं रसिक मुकुटमणि मोहन आपहिं कुंजन द्वार,\nआठों जाम छकेंगी अँखियाँ छवि निकुंज विहार,\nललित किशोरी फीके परिहैं सरवस सुख संसार ||\n- ललित किशोरी जी, अभिलाष माधुरी, विनय (२०४)\nआपको केवल राधा नाम को हृदय से धारण करना है, यह मान कर की किशोरीजी के नाम में वह बैठी हैं। आपको बिना प्रयास के ही श्याम सुन्दर कुञ्ज द्वार में मिल जाएंगे। श्री ललित किशोरीजी के शब्दों में राधा कृष्ण के रस को आठों याम अँखियाँ चखेंगी और निकुंज विहार रस प्राप्त होगा और संसार का समस्त बड़े से बड़ा सुख भी तुच्छ लगेगा।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5a853a8b82274812fecf9694/radha-naam-ko-ur-dhar-pada-written-by-shri-lalit-kishori-abhilash-madhuri","slug":"radha-nam-ko-ur-dhara"}]}]}]],null],null],null]},[null,["$","$Lb",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","content","children","$c","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$Lb",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","content","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"lang":"hi","children":["$","$Lb",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$Le",null,{"children":["$","$Lb",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: