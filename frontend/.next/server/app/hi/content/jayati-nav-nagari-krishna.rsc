f:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"जयति नव नागरी , कृष्ण | वृंदोपनिषद्"}],["$","meta","3",{"name":"description","content":"(राग केदारो व कामोद)\nजयति नव नागरी , कृष्ण-सुख-सागरी ,\nसकल गुन-आगरी , दीनन भोरी !\nजयति हरि-भामिनि , कृष्ण-घन-दामिनी ,\nमत्त गज-गामिनी , नव किशोरी !!\nजयति पि..."}],["$","link","4",{"rel":"canonical","href":"https://path.vrindopnishad.in/hi/content/jayati-nav-nagari-krishna"}],["$","meta","5",{"property":"og:title","content":"जयति नव नागरी , कृष्ण | वृंदोपनिषद्"}],["$","meta","6",{"property":"og:description","content":"(राग केदारो व कामोद)\nजयति नव नागरी , कृष्ण-सुख-सागरी ,\nसकल गुन-आगरी , दीनन भोरी !\nजयति हरि-भामिनि , कृष्ण-घन-दामिनी ,\nमत्त गज-गामिनी , नव किशोरी !!\nजयति पि..."}],["$","meta","7",{"property":"og:url","content":"https://path.vrindopnishad.in/hi/content/jayati-nav-nagari-krishna"}],["$","meta","8",{"property":"og:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}],["$","meta","9",{"property":"og:image:width","content":"800"}],["$","meta","10",{"property":"og:image:height","content":"600"}],["$","meta","11",{"property":"og:image:alt","content":"जयति नव नागरी , कृष्ण"}],["$","meta","12",{"property":"og:type","content":"article"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"जयति नव नागरी , कृष्ण | वृंदोपनिषद्"}],["$","meta","15",{"name":"twitter:description","content":"(राग केदारो व कामोद)\nजयति नव नागरी , कृष्ण-सुख-सागरी ,\nसकल गुन-आगरी , दीनन भोरी !\nजयति हरि-भामिनि , कृष्ण-घन-दामिनी ,\nमत्त गज-गामिनी , नव किशोरी !!\nजयति पि..."}],["$","meta","16",{"name":"twitter:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}]]
