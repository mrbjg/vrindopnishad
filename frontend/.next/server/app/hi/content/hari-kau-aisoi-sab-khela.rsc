f:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"हरि कौ ऐसोई सब खेल | वृंदोपनिषद्"}],["$","meta","3",{"name":"description","content":"मायिक जगत में श्री हरि का ऐसा ही विचित्र खेल है, जिसमें सुख का न कोई बीज है और न ही बेल।\nइसी वजह से समस्त व्यक्ति सांसारिक पदार्थों की आशाओं से सुखी होने क..."}],["$","link","4",{"rel":"canonical","href":"https://path.vrindopnishad.in/hi/content/hari-kau-aisoi-sab-khela"}],["$","meta","5",{"property":"og:title","content":"हरि कौ ऐसोई सब खेल | वृंदोपनिषद्"}],["$","meta","6",{"property":"og:description","content":"मायिक जगत में श्री हरि का ऐसा ही विचित्र खेल है, जिसमें सुख का न कोई बीज है और न ही बेल।\nइसी वजह से समस्त व्यक्ति सांसारिक पदार्थों की आशाओं से सुखी होने क..."}],["$","meta","7",{"property":"og:url","content":"https://path.vrindopnishad.in/hi/content/hari-kau-aisoi-sab-khela"}],["$","meta","8",{"property":"og:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}],["$","meta","9",{"property":"og:image:width","content":"800"}],["$","meta","10",{"property":"og:image:height","content":"600"}],["$","meta","11",{"property":"og:image:alt","content":"हरि कौ ऐसोई सब खेल"}],["$","meta","12",{"property":"og:type","content":"article"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"हरि कौ ऐसोई सब खेल | वृंदोपनिषद्"}],["$","meta","15",{"name":"twitter:description","content":"मायिक जगत में श्री हरि का ऐसा ही विचित्र खेल है, जिसमें सुख का न कोई बीज है और न ही बेल।\nइसी वजह से समस्त व्यक्ति सांसारिक पदार्थों की आशाओं से सुखी होने क..."}],["$","meta","16",{"name":"twitter:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}]]
