0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["hi",{"children":["content",{"children":[["slug","braj-bama-jab-seva-karen-shyam-shyama","d"],{"children":["__PAGE__?{\"slug\":\"braj-bama-jab-seva-karen-shyam-shyama\"}",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["hi",{"children":["content",{"children":[["slug","braj-bama-jab-seva-karen-shyam-shyama","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"ब्रज बामा जब सेवा करें श्याम श्यामा\",\"description\":\"https://www.brajrasik.org/hi/articles/58d555e211ec2c04484ebfa7/braj-bama-jab-seva-karen-shyam-shyama-jagadguru-shri-kripaluji\",\"articleBody\":\"ब्रज बामा जब सेवा करें श्याम श्यामा।सात्विक भाव दुरावें ब्रज बामा॥\\nजब भी ब्रज गोपियाँ श्यामा श्याम की सेवा करती हैं, तो वे अपने दिव्य प्रेम परमानंद (सत्विका भाव) की अपनी गतिविधियों को छिपाने और दबाने का हर संभव प्रयास करती हैं जिससे श्री राधा कृष्ण की नित्य ही उत्तम सेवा हो सके।\\n\",\"author\":{\"@type\":\"Person\",\"name\":\"जगद्गुरु श्री कृपालुजी महाराज, श्यामा श्याम गीत (247)\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"वृंदोपनिषद्\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://path.vrindopnishad.in/official-logo-dark.svg\"}}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"मुख्यपृष्ठ\",\"item\":\"https://path.vrindopnishad.in/hi\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"पुस्तकालय\",\"item\":\"https://path.vrindopnishad.in/hi/content\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"ब्रज बामा जब सेवा करें श्याम श्यामा\",\"item\":\"https://path.vrindopnishad.in/hi/content/braj-bama-jab-seva-karen-shyam-shyama\"}]}"}}],["$","div",null,{"className":"max-w-6xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/hi","className":"hover:text-amber-400 transition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],[["$","$L2",null,{"href":"/hi/content","className":"hover:text-amber-400 transition-colors","children":"पुस्तकालय"}],["$","span",null,{"children":"→"}]],["$","span",null,{"className":"text-white/80 font-medium truncate max-w-[200px]","children":"ब्रज बामा जब सेवा करें श्याम श्यामा"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialContent":{"id":"local-229","title":"ब्रज बामा जब सेवा करें श्याम श्यामा","category":"Shloka","sanskrit_text":"ब्रज बामा जब सेवा करें श्याम श्यामा।सात्विक भाव दुरावें ब्रज बामा॥","hindi_text":"जब भी ब्रज गोपियाँ श्यामा श्याम की सेवा करती हैं, तो वे अपने दिव्य प्रेम परमानंद (सत्विका भाव) की अपनी गतिविधियों को छिपाने और दबाने का हर संभव प्रयास करती हैं जिससे श्री राधा कृष्ण की नित्य ही उत्तम सेवा हो सके।","english_text":null,"english_translation":null,"description":"https://www.brajrasik.org/hi/articles/58d555e211ec2c04484ebfa7/braj-bama-jab-seva-karen-shyam-shyama-jagadguru-shri-kripaluji","author":"जगद्गुरु श्री कृपालुजी महाराज, श्यामा श्याम गीत (247)","status":"published","content_text":"ब्रज बामा जब सेवा करें श्याम श्यामा।\nसात्विक भाव दुरावें ब्रज बामा॥\n- जगद्गुरु श्री कृपालुजी महाराज, श्यामा श्याम गीत (247)\nजब भी ब्रज गोपियाँ श्यामा श्याम की सेवा करती हैं, तो वे अपने दिव्य प्रेम परमानंद (सत्विका भाव) की अपनी गतिविधियों को छिपाने और दबाने का हर संभव प्रयास करती हैं जिससे श्री राधा कृष्ण की नित्य ही उत्तम सेवा हो सके।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/58d555e211ec2c04484ebfa7/braj-bama-jab-seva-karen-shyam-shyama-jagadguru-shri-kripaluji","slug":"braj-bama-jab-seva-karen-shyam-shyama"},"initialRelatedSaint":{"name":"जगद्गुरु श्री कृपालु महाराज","hinglishName":"jagadguru shri kripalu maharaja","slug":"jagadguru-shri-kripalu-maharaja","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-109","title":"राधे कहे श्याम भजो श्याम कहे राधे, मेरी मानो भजो नित तुम श्याम राधे","category":"Shloka","sanskrit_text":"“राधे कहे श्याम भजो श्याम कहे राधे, मेरी मानो भजो नित तुम श्याम राधे। ”","hindi_text":"राधारानी कहती हैं, \"श्री कृष्ण की भक्ति करो\" और कृष्ण कहते हैं, \"श्री राधा की भक्ति करो\"। जगद्गुरु श्री कृपालुजी कहते हैं यदि मेरी बात मानो तो तुम दोनों की भक्ति एक साथ करो।","english_text":null,"english_translation":"Radharani says, “Do Shri Krishn’s devotion” and Krishn says, “Do Radha’s devotion”. However, My advice is to do devotion of both of them together!","description":"https://www.brajrasik.org/hi/articles/58fe4d4a11ec2c04484ebfeb/radhe-kahe-shyam-bhajo-shyam-kahe-radhe-meri-mano-bhajo-nita-tum-shyam-radhe-jagadguru-shri-kripaluji-maharaj","author":"जगद्गुरु श्री कृपालुजी महाराज","status":"published","content_text":"“राधे कहे श्याम भजो श्याम कहे राधे, मेरी मानो भजो नित तुम श्याम राधे। ”\n- जगद्गुरु श्री कृपालुजी महाराज\nराधारानी कहती हैं, \"श्री कृष्ण की भक्ति करो\" और कृष्ण कहते हैं, \"श्री राधा की भक्ति करो\"। जगद्गुरु श्री कृपालुजी कहते हैं यदि मेरी बात मानो तो तुम दोनों की भक्ति एक साथ करो।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/58fe4d4a11ec2c04484ebfeb/radhe-kahe-shyam-bhajo-shyam-kahe-radhe-meri-mano-bhajo-nita-tum-shyam-radhe-jagadguru-shri-kripaluji-maharaj","slug":"radhe-kahe-shyam-bhajo-shyam-kahe-radhe-meri-mano-bhajo-nit-tum-shyam-radhe"},{"id":"local-344","title":"श्याम हुन कबा ब्रज बसिहुं जाए","category":"Shloka","sanskrit_text":"\"श्याम हुन कबा ब्रज बसिहुं जाए | \"","hindi_text":"हे श्याम सुंदर, मुझे ब्रज में शाश्वत निवास के साथ कब आशीर्वाद मिलेगा।","english_text":null,"english_translation":"O Shyam Sundar, When would I be blessed with eternal dwelling in Braj.","description":"https://www.brajrasik.org/hi/articles/5b2b4dfe9f7ab760360f9cb2/shyam-haun-kaba-braj-basihaun-jai-jagadguru-shri-kripaluji-maharaj","author":"जगद्गुरु श्री कृपालुजी महाराज","status":"published","content_text":"\"श्याम हुन कबा ब्रज बसिहुं जाए | \"\n- जगद्गुरु श्री कृपालुजी महाराज\nहे श्याम सुंदर, मुझे ब्रज में शाश्वत निवास के साथ कब आशीर्वाद मिलेगा।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b2b4dfe9f7ab760360f9cb2/shyam-haun-kaba-braj-basihaun-jai-jagadguru-shri-kripaluji-maharaj","slug":"shyam-hun-kaba-braj-basihun-jae"},{"id":"local-537","title":"कब झूमत वृन्दावन कुंजानी","category":"Shloka","sanskrit_text":"\" कब झूमत वृन्दावन कुंजनी, फिरउँ हिये हुलसाई  |\"","hindi_text":"ऐसा कब होगा कि मैं प्रेम रस में विभोर ब्रज की कुंजों में विहरण करूँगा।","english_text":null,"english_translation":"When would I walk in a swaying mode, being intoxicated with divine love, in the groves of Braj.","description":"https://www.brajrasik.org/hi/articles/5a3652ff59e8c72a534d8612/kaba-jhoomata-vrindabana-kunjani-phiraun-hiye-hulasai-jagadguru-shri-kripalu-ji","author":"जगद्गुरु श्री कृपालुजी महाराज","status":"published","content_text":"\" कब झूमत वृन्दावन कुंजनी, फिरउँ हिये हुलसाई  |\"\n- जगद्गुरु श्री कृपालुजी महाराज\nऐसा कब होगा कि मैं प्रेम रस में विभोर ब्रज की कुंजों में विहरण करूँगा।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5a3652ff59e8c72a534d8612/kaba-jhoomata-vrindabana-kunjani-phiraun-hiye-hulasai-jagadguru-shri-kripalu-ji","slug":"kab-jhumat-vrindavan-kunjani"}],"books":[],"rawItem":null},"initialRelatedBook":null,"initialRelatedRaga":null,"initialRelatedVerses":[{"id":"local-0","title":"बनी श्रीराधा मोहन की जोरी","category":"Shloka","sanskrit_text":"बनी श्रीराधा मोहन की जोरी।इंद्र नील मनि स्याम मनोहर, सात कुंभ तनु गोरी।।भाल बिसाल तिलक हरि, कामिनि चिकुर चंद्र बिच रोरी।गज नाइक प्रभु चाल, गयंदनि गति वृषभानु किसोरी।।नील निचोल जुवति, मोहन पट पीत अरुन सिर खोरी।(जै श्री) हित हरिवंश रसिक राधा पति, सुरत रंग में बोरी।।","hindi_text":"भावार्थ-अति अनुपम जोड़ी है श्री राधा मोहन की। मनोहर श्याम सुन्दर इन्द्र नील मणि की भाँति हैं। तो वृषभानु किशोरी श्रीराधा काञ्चन तनु हैं।लाल के विशाल भाल पर तिलक शोभित है, तो कामिनि प्रिया की केश चन्द्रिका के मध्य (माँग) में रोरी लसित है। मोहन लाल की गति (चाल) मत्त गजराज जैसी मोहक और श्रीवृषभानु नन्दिनी की मत्त करिणी जैसी मद मथर है।नव तरुणि श्रीराधा के श्रीअंग में नीलाम्बर शोभित हैं और श्याम सुन्दर के श्यामाङ्ग पर पीत कौशेय धारण है। उपरोक्त नख शिख शृङ्गार की पूर्णता शिरोभाग पर लसित अरुण खोरी (छोर) कर रहा है। श्रीहित हरिवंश कहते हैं यह जोड़ी सौन्दर्थ्य एवं रस की सीमा है। राधापति श्रीकृष्ण रसिक चूडामणि हैं और श्रीराधा सूरत रस सिन्धु रूपा हैं जो रसिकों को नित्य रस देती हैं ।","english_text":null,"english_translation":"The divine couple, Shri Radha Krishn is all attractive and unique. All attractive Shri Shyam Sundar is effulgent like a blue sapphire and the daughter of Shri Vrishbhanu, Shri Radha is golden complexioned. The divine forehead of Shri Krishn is glorified with distinctive Tilak mark (his forehead is adorned by the mark of bright saffron), whereas beloved Radha rani has charming vermillion in her parting line of head. The walking style of Shri Krishn is most similar to that of the elephant, which is so captivating and Shri Radharani’s extraordinary style of walking is similar to that of an intoxicated elephant as well. Shri Radha wears attractive blue garments and Shri Krishn wears attractive yellow garments. Shri Hit Harivansh Mahaprabhu says, the beauty and bliss of this divine couple is limitless. Shri Krishn, the beloved one of Radha, is actually the crest jewel of all Rasiks and Shri Radha is never ending ocean of the blissful divine beauty who provides ceaseless bliss to the Rasiks.","description":"https://www.brajrasik.org/hi/articles/5b0d865c9f7ab760360f9c70/bani-shri-radha-mohan-ki-jori-shri-hita-harivansh-mahaprabhu-from-hit-chaturasi-09","author":"श्री हित हरिवंश , हित चतुरासी (09)","status":"published","content_text":"(राग बिलावल)\nबनी श्रीराधा मोहन की जोरी।\nइंद्र नील मनि स्याम मनोहर, सात कुंभ तनु गोरी।।\nभाल बिसाल तिलक हरि, कामिनि चिकुर चंद्र बिच रोरी।\nगज नाइक प्रभु चाल, गयंदनि गति वृषभानु किसोरी।।\nनील निचोल जुवति, मोहन पट पीत अरुन सिर खोरी।\n(जै श्री) हित हरिवंश रसिक राधा पति, सुरत रंग में बोरी।।\nश्री हित हरिवंश , हित चतुरासी (09)\nभावार्थ-अति अनुपम जोड़ी है श्री राधा मोहन की। मनोहर श्याम सुन्दर इन्द्र नील मणि की भाँति हैं। तो वृषभानु किशोरी श्रीराधा काञ्चन तनु हैं।लाल के विशाल भाल पर तिलक शोभित है, तो कामिनि प्रिया की केश चन्द्रिका के मध्य (माँग) में रोरी लसित है। मोहन लाल की गति (चाल) मत्त गजराज जैसी मोहक और श्रीवृषभानु नन्दिनी की मत्त करिणी जैसी मद मथर है।नव तरुणि श्रीराधा के श्रीअंग में नीलाम्बर शोभित हैं और श्याम सुन्दर के श्यामाङ्ग पर पीत कौशेय धारण है। उपरोक्त नख शिख शृङ्गार की पूर्णता शिरोभाग पर लसित अरुण खोरी (छोर) कर रहा है। श्रीहित हरिवंश कहते हैं यह जोड़ी सौन्दर्थ्य एवं रस की सीमा है। राधापति श्रीकृष्ण रसिक चूडामणि हैं और श्रीराधा सूरत रस सिन्धु रूपा हैं जो रसिकों को नित्य रस देती हैं ।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b0d865c9f7ab760360f9c70/bani-shri-radha-mohan-ki-jori-shri-hita-harivansh-mahaprabhu-from-hit-chaturasi-09","slug":"bani-shriradha-mohan-ki-jori"},{"id":"local-1","title":"राधा नाम को आधार","category":"Shloka","sanskrit_text":"राधा नाम को आधार,ललित लालवर रटत निरंतर, सरबस रस को सार ||सब गुण हीन मलीन दीन, अति पतितन में सरदार |ललित किशोरी तासु भरोसे सोवत पॉव पसार ||","hindi_text":"श्री ललित किशोरी जी कहते हैं की उनके जीवन का आधार एक मात्रा श्री राधा नाम ही है | यह वह दिव्य नाम है जो श्री लाल जी निरंतर रटन करते हैं एवं समस्त रस का मानो सार ही राधा नाम है | श्री ललित किशोरी जी\nके विनम्र शब्दों में, \"यूँ तो मैं गुण हीन, अशुद्ध हृदय युक्त, दीन एवं समस्त पतितों में शिरोमणि हूँ लेकिन केवल और केवल श्री राधा नाम एवं श्री किशोरीजी के बल से दोनों पॉंव पसार कर अर्थात निर्भय होकर सोता हूँ\" |","english_text":null,"english_translation":"Shri Lalit Kishori says, \"Shri Radha’s name is the foundation of his devotion. Shri Krishn the crest jewel of all the Rasiks, incessantly chants the same name, which is the essence of all the nectarian bliss. With humbleness, Shri Lalit Kishori says, although I am devoid of the entire expedient, my heart is awfully dirty and decayed. Thus I am an orphan from every point of view and leader of all the fallen souls. But still He says, simply by having a strong faith in Shri Radha’s name, he sleeps fearlessly.”","description":"https://www.brajrasik.org/hi/articles/5af9fc999f7ab760360f9c52/radha-naam-ko-aadhar-shri-lalit-kishori-abhilash-madhuri","author":"ललित किशोरी जी, अभिलाष माधुरी, विनय (२०५)","status":"published","content_text":"(राग देस)\nराधा नाम को आधार,\nललित लालवर रटत निरंतर, सरबस रस को सार ||\nसब गुण हीन मलीन दीन, अति पतितन में सरदार |\nललित किशोरी तासु भरोसे सोवत पॉव पसार ||\n- ललित किशोरी जी, अभिलाष माधुरी, विनय (२०५)\nश्री ललित किशोरी जी कहते हैं की उनके जीवन का आधार एक मात्रा श्री राधा नाम ही है | यह वह दिव्य नाम है जो श्री लाल जी निरंतर रटन करते हैं एवं समस्त रस का मानो सार ही राधा नाम है | श्री ललित किशोरी जी\nके विनम्र शब्दों में, \"यूँ तो मैं गुण हीन, अशुद्ध हृदय युक्त, दीन एवं समस्त पतितों में शिरोमणि हूँ लेकिन केवल और केवल श्री राधा नाम एवं श्री किशोरीजी के बल से दोनों पॉंव पसार कर अर्थात निर्भय होकर सोता हूँ\" |","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5af9fc999f7ab760360f9c52/radha-naam-ko-aadhar-shri-lalit-kishori-abhilash-madhuri","slug":"radha-nam-ko-adhara"},{"id":"local-3","title":"राधा नाम को उर धार","category":"Shloka","sanskrit_text":"राधा नाम को उर धार,मिलहिं रसिक मुकुटमणि मोहन आपहिं कुंजन द्वार,आठों जाम छकेंगी अँखियाँ छवि निकुंज विहार,ललित किशोरी फीके परिहैं सरवस सुख संसार ||","hindi_text":"आपको केवल राधा नाम को हृदय से धारण करना है, यह मान कर की किशोरीजी के नाम में वह बैठी हैं। आपको बिना प्रयास के ही श्याम सुन्दर कुञ्ज द्वार में मिल जाएंगे। श्री ललित किशोरीजी के शब्दों में राधा कृष्ण के रस को आठों याम अँखियाँ चखेंगी और निकुंज विहार रस प्राप्त होगा और संसार का समस्त बड़े से बड़ा सुख भी तुच्छ लगेगा।","english_text":null,"english_translation":"You have to keep Shri Radha's name in your heart all the time, believing the fact that she herself is seated in her name. You will be able to meet Shree Krishna on the gates of the Kunja, without any further efforts. In the words of Shri Lalit Kishoriji, your eyes will relish the ras (bliss) of Shri Radha Krishn at Nikunj Vihaar and even the greatest pleasures of the world will look immaterial (comparable to nothing).","description":"https://www.brajrasik.org/hi/articles/5a853a8b82274812fecf9694/radha-naam-ko-ur-dhar-pada-written-by-shri-lalit-kishori-abhilash-madhuri","author":"ललित किशोरी जी, अभिलाष माधुरी, विनय (२०४)","status":"published","content_text":"(राग देस)\nराधा नाम को उर धार,\nमिलहिं रसिक मुकुटमणि मोहन आपहिं कुंजन द्वार,\nआठों जाम छकेंगी अँखियाँ छवि निकुंज विहार,\nललित किशोरी फीके परिहैं सरवस सुख संसार ||\n- ललित किशोरी जी, अभिलाष माधुरी, विनय (२०४)\nआपको केवल राधा नाम को हृदय से धारण करना है, यह मान कर की किशोरीजी के नाम में वह बैठी हैं। आपको बिना प्रयास के ही श्याम सुन्दर कुञ्ज द्वार में मिल जाएंगे। श्री ललित किशोरीजी के शब्दों में राधा कृष्ण के रस को आठों याम अँखियाँ चखेंगी और निकुंज विहार रस प्राप्त होगा और संसार का समस्त बड़े से बड़ा सुख भी तुच्छ लगेगा।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5a853a8b82274812fecf9694/radha-naam-ko-ur-dhar-pada-written-by-shri-lalit-kishori-abhilash-madhuri","slug":"radha-nam-ko-ur-dhara"}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","content","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$u