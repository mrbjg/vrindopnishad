0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["hi",{"children":["saints",{"children":[["slug","mirabai","d"],{"children":["__PAGE__?{\"slug\":\"mirabai\"}",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["hi",{"children":["saints",{"children":[["slug","mirabai","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"मीराबाई\",\"alternateName\":\"mirabai\",\"description\":\"ब्रज परंपरा के वैष्णव संत।\",\"url\":\"https://path.vrindopnishad.in/hi/saints/mirabai\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"मुख्यपृष्ठ\",\"item\":\"https://path.vrindopnishad.in/hi\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"संत\",\"item\":\"https://path.vrindopnishad.in/hi/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"मीराबाई\",\"item\":\"https://path.vrindopnishad.in/hi/saints/mirabai\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/hi","className":"hover:text-amber-400 transition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/hi/saints","className":"hover:text-amber-400 transition-colors","children":"संत"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"मीराबाई"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"मीराबाई","hinglishName":"mirabai","slug":"mirabai","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-218","title":"चाकर रहसूं बाग़ लगासूं, नित उठ दरसन पासूं","category":"Shloka","sanskrit_text":"\"चाकर रहसूं बाग़ लगासूं, नित उठ दरसन पासूंब्रिन्दाबन की कुञ्ज गलिन में, तेरी लीला गासूं\"","hindi_text":"हे कृष्ण, मैं सदा आपकी दासी रहूँगी और आपके लिए एक बाग लगाउँगी। प्रतिदिन सुबह उठ कर आपका दर्शन करुँगी। वृंदावन की कुञ्ज गलियों में विचरण कर, मैं आपके दिव्य लीलाओं को गाऊँगी।","english_text":null,"english_translation":"Oh Krishn, I shall remain your servant and tend a garden for you. Everyday, I shall wake up and get to see you. In the bowers and lanes of Vrindavan, I shall roam and sing of your divine leelas (sports).","description":"https://www.brajrasik.org/hi/articles/5da992fb0384260060487b0d/chaakar-rahsun-baag-lagaasun-nit-uth-darsan-paasun-meerabai","author":"मीराबाई","status":"published","content_text":"\"चाकर रहसूं बाग़ लगासूं, नित उठ दरसन पासूं\nब्रिन्दाबन की कुञ्ज गलिन में, तेरी लीला गासूं\"\n- मीराबाई\nहे कृष्ण, मैं सदा आपकी दासी रहूँगी और आपके लिए एक बाग लगाउँगी। प्रतिदिन सुबह उठ कर आपका दर्शन करुँगी। वृंदावन की कुञ्ज गलियों में विचरण कर, मैं आपके दिव्य लीलाओं को गाऊँगी।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5da992fb0384260060487b0d/chaakar-rahsun-baag-lagaasun-nit-uth-darsan-paasun-meerabai","slug":"chakar-rahasun-ba-lagasun-nit-uth-darasan-pasun"},{"id":"local-343","title":"आली म्हाँने लागे बृन्दावन नीकौ","category":"Shloka","sanskrit_text":"आली म्हाँने लागे बृन्दावन नीकौ।घर घर तुलसी ठाकुर पूजादरसण गोविन्द जी को ॥निर्मल नीर बहत जमुना मेंभोजन दूध दही को।रतनसिंघासन आप विराजैमुकट धर्यो तुलसी को॥कुंजन कुंजन फिरत राधिकासबद सुणत मुरली को।मीरा के प्रभु गिरधर नागरभजन बिना नर फीको॥","hindi_text":"हे सखी, मुझे वृंदावन अति प्रिय लगता है। यहाँ हर घर में श्री तुलसी जी विराजमान हैं एवं श्री ठाकुर जी की पूजा होती है एवं नित्य दर्शन होता है। श्री जमुना जी में निर्मल एवं स्वच्छ जल बह रहा है एवं यहाँ पर दूध एवं दही का भोग श्री ठाकुर जी को लगाया जा रहा है। श्री ठाकुर जी रत्न एवं मणियों के सिंहासन पर विराजमान हैं परंतु श्री तुलसी जी के पत्रों से निर्मीत मुकुट धारण किया है। श्री राधिका जी विभिन्न कुंजों में विचरण कर रहीं हैं जहाँ मुरली की मधुर धुन सुनाई दे रही है। श्री मीराबाई कह रहीं हैं \"प्रभु श्री गिरिधर नागर के भजन के बिना यह मनुष्य शरीर फीका एवं निरर्थक है।\"","english_text":null,"english_translation":"O Sakhi, I love Vrindavan from the bottom of my heart. There is Tulasi in every house, worship of Shri Thakurji and their Darshan in every house.\nThe water of river Yamuna is holy and dairy products like Milk and curd is easily available.\nShri Thakurji is gorgeously adorned in the gem-studded throne, wearing the dazzling crown of Tulasi.\nShri Radha is wandering in various groves of Vrindavan to listen to the beautiful melodies of Thakurji’s flute.\nShri Mirabai says, “Shri Giridhar Nagar Krishn is the Lord of my life and without Bhajana (devotion) this human form is utterly useless”.","description":"https://www.brajrasik.org/hi/articles/5d852b906851f9006900c88c/aali-mhane-laage-brindavan-neekau-meerabai","author":"मीराबाई","status":"published","content_text":"आली म्हाँने लागे बृन्दावन नीकौ।\nघर घर तुलसी ठाकुर पूजा\nदरसण गोविन्द जी को ॥\nनिर्मल नीर बहत जमुना में\nभोजन दूध दही को।\nरतनसिंघासन आप विराजै\nमुकट धर्यो तुलसी को॥\nकुंजन कुंजन फिरत राधिका\nसबद सुणत मुरली को।\nमीरा के प्रभु गिरधर नागर\nभजन बिना नर फीको॥\n- मीराबाई\nहे सखी, मुझे वृंदावन अति प्रिय लगता है। यहाँ हर घर में श्री तुलसी जी विराजमान हैं एवं श्री ठाकुर जी की पूजा होती है एवं नित्य दर्शन होता है। श्री जमुना जी में निर्मल एवं स्वच्छ जल बह रहा है एवं यहाँ पर दूध एवं दही का भोग श्री ठाकुर जी को लगाया जा रहा है। श्री ठाकुर जी रत्न एवं मणियों के सिंहासन पर विराजमान हैं परंतु श्री तुलसी जी के पत्रों से निर्मीत मुकुट धारण किया है। श्री राधिका जी विभिन्न कुंजों में विचरण कर रहीं हैं जहाँ मुरली की मधुर धुन सुनाई दे रही है। श्री मीराबाई कह रहीं हैं \"प्रभु श्री गिरिधर नागर के भजन के बिना यह मनुष्य शरीर फीका एवं निरर्थक है।\"","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5d852b906851f9006900c88c/aali-mhane-laage-brindavan-neekau-meerabai","slug":"ali-mhanne-lage-brindavan-nikau"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"lang":"hi","children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L8",null,{"children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],