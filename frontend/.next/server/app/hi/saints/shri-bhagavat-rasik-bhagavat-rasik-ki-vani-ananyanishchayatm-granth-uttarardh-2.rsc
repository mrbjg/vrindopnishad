sition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/hi/saints","className":"hover:text-amber-400 transition-colors","children":"संत"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"श्री भगवत रसिक, भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ  उत्तरार्ध (2)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री भगवत रसिक, भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ  उत्तरार्ध (2)","hinglishName":"shri bhagavat rasik, bhagavat rasik ki vani, ananyanishchayatm granth uttarardh (2)","slug":"shri-bhagavat-rasik-bhagavat-rasik-ki-vani-ananyanishchayatm-granth-uttarardh-2","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-98","title":"नैननि देखीं और नहीं","category":"Shloka","sanskrit_text":"नैननि देखीं और नहीं, श्रवण सुने नहीं और |घ्राण न सूघोँ और कछु, रसना कहौं न और ||रसना कहौं न और, त्वचा परसौं नहीं औरे |कुंज बिहारी केलि झेलि, इन्द्रिन सब ठौरे ||भगवत रसिक अनन्य, कोक उपदेसौं सैननि |बैनन मैन जगाय, रैन दिन देखौं नैननि ||","hindi_text":"नैननि देखीं और नहीं, श्रवण सुने नहीं और |\nघ्राण न सूघोँ और कछु, रसना कहौं न और ||\nरसना कहौं न और, त्वचा परसौं नहीं औरे |\nकुंज बिहारी केलि झेलि, इन्द्रिन सब ठौरे ||\nभगवत रसिक अनन्य, कोक उपदेसौं सैननि |\nबैनन मैन जगाय, रैन दिन देखौं नैननि ||\n- श्री भगवत रसिक, भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ - उत्तरार्ध (2)\nभगवत रसिक जी कहते हैं कि मैं अब (श्रीयुगल की नित्य केलि के अतिरिक्त) न तो अपनी आँखों से कुछ और देखता हूँ, न कानों से कुछ और सुनता हूँ, न नासिका से कुछ और सूंघता हैं, न ही कानों से कुछ और सुनता हैं, न नासिका से कुछ और सूंघता हूँ, न जिह्वा (जीभ) से कुछ और कहता हूँ और न त्वचा से कुछ और छूता हैं। इस प्रकार में सदा सर्वत्र अपनी समस्त पांचों ज्ञानेन्द्रियों को श्रीश्यामा- कुंजबिहारी की नित्य कीड़ा में निमग्न करके उन्हें (प्रिया प्रियतम को) नयन संकेतों से अनवरत केलि का उपदेश करता रहता हूँ, वाणी से इस नित्य अनंग क्रीडा का रात दिन गान कर उसे उद्दीपन बनता हुआ मैं नेत्रों से इसी केलि को निहारता रहता हूँ।","english_text":null,"english_translation":"\"Nainani Dekhein Aur Nahin, Shravan Sune Nahin Aur.\nGhraan Na Songhon Aur Kachhu, Rasana Kahaun Na Aur.\nRasana Kahaun Na Aur, Tvacha Parsaun Nahin Aure.\nKunj Bihaaree Keli Jheli, Indrin Sab Thaure.\nBhagavat Rasik Anany, Kok Upadesaun Sainani.\nBainan Main Jagaay, Rain Din Dekhaun Nainani.”\n- Shri Bhagwat Rasik, Bhagwat Rasik Ki Vaani, AnanyaNishchayatma Granth - Uttarardh (2)\nIn the words of Shri Bhagwat Rasik Ji, despite Shree Yugal Sarkar’s Nitya Vihar Keli Leela, he is unwilling to see anything, unwilling to smell anything or unwilling to hear anything. Neither He speaks anything else with his tongue nor he is willing to touch anything. In this way at all times and all places, by indulging all his all five sense organs in the divine Nitya Vihaar Keli Leela of Shri Shyama and Kunj Bihari, He is preaching the Keli Leelas to them alone (Shri Radha Krishn) as the eyes are being absorbed day and night in the rarest vision of the divine couple.","description":"https://www.brajrasik.org/hi/articles/5ac7344e9f7ab760360f9c20/nainani-dekhein-aur-nahin-shravan-sune-nahin-aur-shri-bhagwat-rasik-bhagwat-rasik-ki-vaani","author":"श्री भगवत रसिक, भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ  उत्तरार्ध (2)","status":"published","content_text":"नैननि देखीं और नहीं, श्रवण सुने नहीं और |\nघ्राण न सूघोँ और कछु, रसना कहौं न और ||\nरसना कहौं न और, त्वचा परसौं नहीं औरे |\nकुंज बिहारी केलि झेलि, इन्द्रिन सब ठौरे ||\nभगवत रसिक अनन्य, कोक उपदेसौं सैननि |\nबैनन मैन जगाय, रैन दिन देखौं नैननि ||\n- श्री भगवत रसिक, भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ - उत्तरार्ध (2)\nभगवत रसिक जी कहते हैं कि मैं अब (श्रीयुगल की नित्य केलि के अतिरिक्त) न तो अपनी आँखों से कुछ और देखता हूँ, न कानों से कुछ और सुनता हूँ, न नासिका से कुछ और सूंघता हैं, न ही कानों से कुछ और सुनता हैं, न नासिका से कुछ और सूंघता हूँ, न जिह्वा (जीभ) से कुछ और कहता हूँ और न त्वचा से कुछ और छूता हैं। इस प्रकार में सदा सर्वत्र अपनी समस्त पांचों ज्ञानेन्द्रियों को श्रीश्यामा- कुंजबिहारी की नित्य कीड़ा में निमग्न करके उन्हें (प्रिया प्रियतम को) नयन संकेतों से अनवरत केलि का उपदेश करता रहता हूँ, वाणी से इस नित्य अनंग क्रीडा का रात दिन गान कर उसे उद्दीपन बनता हुआ मैं नेत्रों से इसी केलि को निहारता रहता हूँ।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5ac7344e9f7ab760360f9c20/nainani-dekhein-aur-nahin-shravan-sune-nahin-aur-shri-bhagwat-rasik-bhagwat-rasik-ki-vaani","slug":"nainani-dekhin-aur-nahin"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"lang":"hi","children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/