0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["hi",{"children":["saints",{"children":[["slug","shri-svami-haridas-ashtadash-pad-13","d"],{"children":["__PAGE__?{\"slug\":\"shri-svami-haridas-ashtadash-pad-13\"}",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["hi",{"children":["saints",{"children":[["slug","shri-svami-haridas-ashtadash-pad-13","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री स्वामी हरिदास, अष्टादश पद (13)\",\"alternateName\":\"shri svami haridas, ashtadash pad (13)\",\"description\":\"ब्रज परंपरा के वैष्णव संत।\",\"url\":\"https://path.vrindopnishad.in/hi/saints/shri-svami-haridas-ashtadash-pad-13\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"मुख्यपृष्ठ\",\"item\":\"https://path.vrindopnishad.in/hi\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"संत\",\"item\":\"https://path.vrindopnishad.in/hi/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"श्री स्वामी हरिदास, अष्टादश पद (13)\",\"item\":\"https://path.vrindopnishad.in/hi/saints/shri-svami-haridas-ashtadash-pad-13\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/hi","className":"hover:text-amber-400 transition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/hi/saints","className":"hover:text-amber-400 transition-colors","children":"संत"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"श्री स्वामी हरिदास, अष्टादश पद (13)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री स्वामी हरिदास, अष्टादश पद (13)","hinglishName":"shri svami haridas, ashtadash pad (13)","slug":"shri-svami-haridas-ashtadash-pad-13","biography":"","metadata":{"lineageEn":"Haridasi Sampradaya (Sakhi Sampradaya)","lineageHi":"हरिदासी संप्रदाय (सखी संप्रदाय)","timelineEn":"1478–1573 AD (Vikram Samvat 1535 - 1630)","timelineHi":"1478–1573 ईस्वी (विक्रम संवत 1535 - 1630)","associatedPlacesEn":"Nidhivan, Vrindavan","associatedPlacesHi":"निधिवन, वृंदावन","discipleOfEn":"Shri Ashudhir Dev Ji (his father and guru)","discipleOfHi":"श्री आशुधीर देव जी (पिता एवं गुरु)","influencedByEn":"Nimbarka Sampradaya philosophy","influencedByHi":"निम्बार्क संप्रदाय सिद्धांत","associatedSampradayaEn":"Haridasi Sampradaya (Sakhi Sampradaya)","associatedSampradayaHi":"हरिदासी संप्रदाय (सखी संप्रदाय)","devotionalMoodEn":"Nitya Vihar, Sakhi Bhava (Lalita Sakhi incarnate)","devotionalMoodHi":"नित्य विहार, सखी भाव (ललिता सखी अवतार)","teachingsEn":"Worship of the Divine Couple in the mood of Lalita Sakhi; focused purely on the eternal love-play (Nitya Vihar) in the secluded bowers (Nikunj) of Vrindavan, entirely devoid of majesty (aishwarya) or physical separation (viraha).","teachingsHi":"ललिता सखी के भाव में युगल उपासना; वृंदावन के निकुंजों में होने वाले अखंड नित्य विहार रस पर पूर्ण ध्यान, जिसमें ऐश्वर्य भाव या वियोग का कोई स्थान नहीं है।","literaryStyleEn":"Composed Kelimal (केलिमाल) and Siddhanta Pada (सिद्धान्त के पद) in sweet Braj Bhasha, characterized by deep musicality, classical raag notations, and intimate description of the Divine Couple's pastimes.","literaryStyleHi":"मधुर ब्रजभाषा में 'केलिमाल' और 'सिद्धान्त के पद' की रचना की, जो राग-रागिनियों की शास्त्रीय विधा और निकुंज लीलाओं के सूक्ष्म चित्रण से परिपूर्ण हैं।","biographyEn":"Swami Haridas was a spiritual master, classical music pioneer, and the founding acharya of the Haridasi Sampradaya. He is widely revered as the direct incarnation of Lalita Sakhi, the chief confidante of Srimati Radharani. Swami Haridas performed his intense bhajan in the sacred grove of Nidhivan in Vrindavan. His musical devotion was so deep and pure that the Divine Couple, Shri Radha and Krishna, appeared before him and manifested themselves in a single, combined deity form—Sri Bankey Bihari Ji. Swami Haridas taught that the ultimate spiritual destination is not cosmic liberation or majestic worship, but witnessing the confidential loving service of the Divine Couple in the eternal groves of Braj.","biographyHi":"स्वामी हरिदास वृंदावन के रसिक शिरोमणि संत और भारतीय शास्त्रीय संगीत के महान आचार्य थे। उन्हें श्री राधा जी की प्रधान सखी श्री ललिता जी का साक्षात् अवतार माना जाता है। उन्होंने वृंदावन के निधिवन को अपनी साधना स्थली बनाया, जहाँ उनके संगीत अनुराग से खिंचकर युगल सरकार ने बांके बिहारी जी के रूप में प्रकट होकर दर्शन दिए। तानसेन और बैजू बावरा जैसे संगीत सम्राट इनके शिष्य थे। स्वामी जी ने सिद्ध किया कि भक्ति शुष्क तपस्या नहीं, बल्कि राग-रागिनियों के माध्यम से प्रभु चरणों में पूर्ण आत्मसमर्पण है।","relatedSaints":[{"nameEn":"Shri Hit Harivansh","nameHi":"श्री हित हरिवंश","slug":"hit-harivansh"},{"nameEn":"Shri Hariram Vyas","nameHi":"श्री हरिराम व्यास","slug":"hariram-vyas"}],"relatedGranthas":[{"nameEn":"Kelimal","nameHi":"केलिमाल","slug":"kelimal"},{"nameEn":"Siddhanta Pada","nameHi":"सिद्धान्त के पद","slug":"siddhanta-pada"}],"associatedGlossary":[{"termEn":"Nitya Vihar","termHi":"नित्य विहार","slug":"nitya-vihar"},{"termEn":"Nikunj","termHi":"निकुंज","slug":"nikunj"},{"termEn":"Sakhi Bhava","termHi":"सखी भाव","slug":"sakhi-bhava"}],"faq":[{"qEn":"Who was Swami Haridas?","aEn":"Swami Haridas was a 16th-century rasik saint, musicologist, and founder of the Haridasi Sampradaya, renowned for manifesting the Bankey Bihari deity through his music in Nidhivan.","qHi":"स्वामी हरिदास कौन थे?","aHi":"स्वामी हरिदास 16वीं शताब्दी के एक महान रसिक संत, संगीतकार और हरिदासी संप्रदाय के प्रवर्तक थे, जिन्होंने अपने संगीत साधना से निधिवन में ठाकुर बांके बिहारी जी को प्रकट किया था।"},{"qEn":"Who were the famous disciples of Swami Haridas?","aEn":"The legendary musicians Tansen (the royal singer of Akbar's court) and Baiju Bawra were disciples of Swami Haridas.","qHi":"स्वामी हरिदास के प्रसिद्ध शिष्य कौन थे?","aHi":"अकबर के दरबार के नवरत्नों में से एक संगीत सम्राट तानसेन और बैजू बावरा स्वामी हरिदास जी के प्रमुख शिष्य थे।"}]},"imageUrl":null,"verses":[{"id":"local-476","title":"हरि कौ ऐसोई सब खेल","category":"Shloka","sanskrit_text":"हरि कौ ऐसोई सब खेल।मृग तृष्णा जग ब्यापि रह्यों है कहूँ बिजौरौ न बेल॥ [1]धन-मद जोवन-मद राज-मद ज्यौं पंछिन में डेल।कहें श्री हरिदास यहै जिय जानौ तीरथ कैसौ मेल॥ [2]","hindi_text":"मायिक जगत में श्री हरि का ऐसा ही विचित्र खेल है, जिसमें सुख का न कोई बीज है और न ही बेल।\nइसी वजह से समस्त व्यक्ति सांसारिक पदार्थों की आशाओं से सुखी होने के लिए ऐसे लालायित हैं जैसे रेगिस्तान में कोई मृग सूर्य की किरणों को जल समझ कर भागता ही जा रहा है परन्तु वहां एक भी बूँद जल नहीं है। [1]\nयह संसार का मेल क्षणिक है, फिर भी जीव अभिमान युक्त होकर इस क्षणिक धन मद, यौवन मद और राज मद में फंसा हुआ रहता है परन्तु यह सब मद व्यर्थ हैं । यह सब ऐसे उड़ जायेगा जैसे एक डाल पर बैठे हुए पंछी उड़ जाते हैं।\nस्वामी श्री हरिदास जी महराज कहते हैं कि यह मायिक सुख सम्बन्धियों को ऐसे जानो जैसे तीर्थ पर अनेक तरह के यात्री एकत्रित हो गए हैं, परन्तु दो चार दिनों में ही सब अपने अपने घर चले जाएंगे। इसलिए श्री हरि को छोड़कर कोई भी तुम्हारा अपना नहीं है। [2]","english_text":null,"english_translation":"Shri Hari’s material world is truly bizarre, where there is neither a seed nor a vine of happiness—there is no trace of real happiness in this material realm. Everyone here is chasing material desires, but it is like a deer trying to quench its thirst by imagining water in the desert. In reality, the entire world is a mirage, offering no true happiness. [1]\nAll souls become trapped in the pride of wealth, youth, and power, but all of that is utterly meaningless and fleeting. It disappears as quickly as birds flying from one branch to another.\nSwami Shri Haridas Ji Maharaj says that material connections and relationships should be seen like pilgrims gathered at a pilgrimage—within a few days, they will part and return to their respective homes according to their karma. Thus, no one except Shri Hari is truly yours. [2]","description":"https://www.brajrasik.org/hi/articles/5d9f4cdd707a670060edff26/hari-kau-aisoi-sab-khel-shri-swami-haridas-ashtadash-pada-13","author":"श्री स्वामी हरिदास, अष्टादश पद (13)","status":"published","content_text":"(राग कल्याण)\nहरि कौ ऐसोई सब खेल।\nमृग तृष्णा जग ब्यापि रह्यों है कहूँ बिजौरौ न बेल॥ [1]\nधन-मद जोवन-मद राज-मद ज्यौं पंछिन में डेल।\nकहें श्री हरिदास यहै जिय जानौ तीरथ कैसौ मेल॥ [2]\n- श्री स्वामी हरिदास, अष्टादश पद (13)\nमायिक जगत में श्री हरि का ऐसा ही विचित्र खेल है, जिसमें सुख का न कोई बीज है और न ही बेल।\nइसी वजह से समस्त व्यक्ति सांसारिक पदार्थों की आशाओं से सुखी होने के लिए ऐसे लालायित हैं जैसे रेगिस्तान में कोई मृग सूर्य की किरणों को जल समझ कर भागता ही जा रहा है परन्तु वहां एक भी बूँद जल नहीं है। [1]\nयह संसार का मेल क्षणिक है, फिर भी जीव अभिमान युक्त होकर इस क्षणिक धन मद, यौवन मद और राज मद में फंसा हुआ रहता है परन्तु यह सब मद व्यर्थ हैं । यह सब ऐसे उड़ जायेगा जैसे एक डाल पर बैठे हुए पंछी उड़ जाते हैं।\nस्वामी श्री हरिदास जी महराज कहते हैं कि यह मायिक सुख सम्बन्धियों को ऐसे जानो जैसे तीर्थ पर अनेक तरह के यात्री एकत्रित हो गए हैं, परन्तु दो चार दिनों में ही सब अपने अपने घर चले जाएंगे। इसलिए श्री हरि को छोड़कर कोई भी तुम्हारा अपना नहीं है। [2]","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5d9f4cdd707a670060edff26/hari-kau-aisoi-sab-khel-shri-swami-haridas-ashtadash-pada-13","slug":"hari-kau-aisoi-sab-khela"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$",