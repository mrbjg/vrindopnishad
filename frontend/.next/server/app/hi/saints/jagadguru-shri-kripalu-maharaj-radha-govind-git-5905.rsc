children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"जगद्गुरु श्री कृपालु  महाराज , राधा गोविंद गीत  5905"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"जगद्गुरु श्री कृपालु  महाराज , राधा गोविंद गीत  5905","hinglishName":"jagadguru shri kripalu maharaj , radha govind git 5905","slug":"jagadguru-shri-kripalu-maharaj-radha-govind-git-5905","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-579","title":"श्याम धाम नंदगाम गोविन्द राधे","category":"Shloka","sanskrit_text":"“ श्याम धाम नंदगाम गोविन्द राधे, श्यामा जू को धाम बरसानो बता दे |श्यामा श्याम दोनों का ही गोविन्द राधे, लीला धाम तो है वृन्दावन बता दे || ”","hindi_text":"“ श्याम धाम नंदगाम गोविन्द राधे, श्यामा जू को धाम बरसानो बता दे |\nश्यामा श्याम दोनों का ही गोविन्द राधे, लीला धाम तो है वृन्दावन बता दे || ”\n- जगद्गुरु श्री कृपालु जी महाराज , राधा गोविंद गीत - 5905\nब्रज में, श्री कृष्ण का निवास नंदगाँव है, श्री राधा का निवास बरसाना है। लेकिन दोनों युगल का (श्री कृष्ण और श्री राधा रानी) लीला धाम श्री वृंदावन धाम है ।","english_text":null,"english_translation":"\"Shyam Dham Nandgaon Govind Radhey, Shyama Ju Ko Dham Barsano Bata De,\nShyama Shyam Dono Ka Hi Govind Radhey, Leela Dham To Hai Vrindavan Bata De\"\n- Jagadguru Shri Kripalu Ji Maharaj , Radha Govind Geet - 5905\nIn Braj, Shri Krishn’s abode is Nandgaon while Shri Radha’s abode is Barsana. But both of them together perform pastimes at Shri Vrindavan Dham.","description":"https://www.brajrasik.org/hi/articles/5a4ed02b59e8c72a534d86d4/shyam-dham-nandgaon-govind-radhey-shyama-ju-ko-dham-barsano-bata-de-shyama-shyam-dono-ka-hi-govind-radhey-leela-dham-to-hai-vrindavan-bata-de-jagadguru-shri-kripalu-ji-maharaj-radha-govind-geet-5905","author":"जगद्गुरु श्री कृपालु जी महाराज , राधा गोविंद गीत  5905","status":"published","content_text":"“ श्याम धाम नंदगाम गोविन्द राधे, श्यामा जू को धाम बरसानो बता दे |\nश्यामा श्याम दोनों का ही गोविन्द राधे, लीला धाम तो है वृन्दावन बता दे || ”\n- जगद्गुरु श्री कृपालु जी महाराज , राधा गोविंद गीत - 5905\nब्रज में, श्री कृष्ण का निवास नंदगाँव है, श्री राधा का निवास बरसाना है। लेकिन दोनों युगल का (श्री कृष्ण और श्री राधा रानी) लीला धाम श्री वृंदावन धाम है ।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5a4ed02b59e8c72a534d86d4/shyam-dham-nandgaon-govind-radhey-shyama-ju-ko-dham-barsano-bata-de-shyama-shyam-dono-ka-hi-govind-radhey-leela-dham-to-hai-vrindavan-bata-de-jagadguru-shri-kripalu-ji-maharaj-radha-govind-geet-5905","slug":"shyam-dham-nndagam-govind-radhe"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"lang":"hi","children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"n