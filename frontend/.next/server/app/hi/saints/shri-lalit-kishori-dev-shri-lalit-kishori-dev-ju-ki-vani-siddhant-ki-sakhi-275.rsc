0 transition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/hi/saints","className":"hover:text-amber-400 transition-colors","children":"संत"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"श्री ललित किशोरी देव, श्री ललित किशोरी देव जू की वाणी, सिद्धान्त की साखी (२७५)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री ललित किशोरी देव, श्री ललित किशोरी देव जू की वाणी, सिद्धान्त की साखी (२७५)","hinglishName":"shri lalit kishori dev, shri lalit kishori dev ju ki vani, siddhant ki sakhi (275)","slug":"shri-lalit-kishori-dev-shri-lalit-kishori-dev-ju-ki-vani-siddhant-ki-sakhi-275","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-473","title":"हम हमरी है लाडली","category":"Shloka","sanskrit_text":"हम हमरी है लाडली, कहें सुनें चितलाई।कुंज केली निरखे सदा, महा परम सुख पाइ ।।","hindi_text":"हमारी प्रान श्रीलाड़िली राधा ही है, इसीलिए हम चित् लगाकर सदाकाल इनके ही केवल गुन गुनाते हैं एवं श्रवण करते हैं (बातें कहते सुनते हैं) । इन्हीं की कुंज केली को निहार निहार के महा परम सुख (नित्य विहार) पाते हैं।","english_text":null,"english_translation":"Our soul life is Shri Radha alone. That's why we lovingly and exclusively sing and listen her glories, day and night. Beholding her Keli Leela, our mind is inebriated with the supreme bliss (Nitya Vihar).","description":"https://www.brajrasik.org/hi/articles/5d9197a289c4660060055e01/ham-hamari-hai-ladili-shri-lalit-kishori-dev-shri-lalit-kishori-dev-ju-ki-vani-275","author":"श्री ललित किशोरी देव, श्री ललित किशोरी देव जू की वाणी, सिद्धान्त की साखी (२७५)","status":"published","content_text":"हम हमरी है लाडली, कहें सुनें चितलाई।\nकुंज केली निरखे सदा, महा परम सुख पाइ ।।\n- श्री ललित किशोरी देव, श्री ललित किशोरी देव जू की वाणी, सिद्धान्त की साखी (२७५)\nहमारी प्रान श्रीलाड़िली राधा ही है, इसीलिए हम चित् लगाकर सदाकाल इनके ही केवल गुन गुनाते हैं एवं श्रवण करते हैं (बातें कहते सुनते हैं) । इन्हीं की कुंज केली को निहार निहार के महा परम सुख (नित्य विहार) पाते हैं।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5d9197a289c4660060055e01/ham-hamari-hai-ladili-shri-lalit-kishori-dev-shri-lalit-kishori-dev-ju-ki-vani-275","slug":"ham-hamari-hai-ladali"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"lang":"hi","children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antial