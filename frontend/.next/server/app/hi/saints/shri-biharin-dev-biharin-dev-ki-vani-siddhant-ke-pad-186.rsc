0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["hi",{"children":["saints",{"children":[["slug","shri-biharin-dev-biharin-dev-ki-vani-siddhant-ke-pad-186","d"],{"children":["__PAGE__?{\"slug\":\"shri-biharin-dev-biharin-dev-ki-vani-siddhant-ke-pad-186\"}",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["hi",{"children":["saints",{"children":[["slug","shri-biharin-dev-biharin-dev-ki-vani-siddhant-ke-pad-186","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री बिहारिन देव, बिहारिन देव की वाणी, सिद्धान्त के पद (186)\",\"alternateName\":\"shri biharin dev, biharin dev ki vani, siddhant ke pad (186)\",\"description\":\"ब्रज परंपरा के वैष्णव संत।\",\"url\":\"https://path.vrindopnishad.in/hi/saints/shri-biharin-dev-biharin-dev-ki-vani-siddhant-ke-pad-186\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"मुख्यपृष्ठ\",\"item\":\"https://path.vrindopnishad.in/hi\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"संत\",\"item\":\"https://path.vrindopnishad.in/hi/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"श्री बिहारिन देव, बिहारिन देव की वाणी, सिद्धान्त के पद (186)\",\"item\":\"https://path.vrindopnishad.in/hi/saints/shri-biharin-dev-biharin-dev-ki-vani-siddhant-ke-pad-186\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/hi","className":"hover:text-amber-400 transition-colors","children":"मुख्यपृष्ठ"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/hi/saints","className":"hover:text-amber-400 transition-colors","children":"संत"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"श्री बिहारिन देव, बिहारिन देव की वाणी, सिद्धान्त के पद (186)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री बिहारिन देव, बिहारिन देव की वाणी, सिद्धान्त के पद (186)","hinglishName":"shri biharin dev, biharin dev ki vani, siddhant ke pad (186)","slug":"shri-biharin-dev-biharin-dev-ki-vani-siddhant-ke-pad-186","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-208","title":"प्यारी जू मोकों कृपा करो","category":"Shloka","sanskrit_text":"प्यारी जू मोकों कृपा करो,ऐसी रूचि उपजै जिए मेरे तुम्हीं न छिन्न बिसरो ॥ [1]आपुन अपनी करि प्रेम बढ़ावहु, निज रस रीति सौं हियौ भरो ।श्री बिहारी बिहारिनि दासी कहत यौं, विपिन विहार ढ़रो ॥ [2]","hindi_text":"हे प्यारी जू (श्री राधा)! मुझ पर कृपा करें कि मेरे हृदय में ऐसी प्रेम-रुचि उत्पन्न हो जाए कि आप कभी भी, क्षणमात्र के लिए भी, विस्मृत न हों। [1]\nआप स्वयं अपनी कृपा से मेरे प्रेम को बढ़ाइए और अपने दिव्य रस की रीति से मेरे हृदय को पूर्णत: भर दीजिए। श्री बिहारी-बिहारिनि की दासी कहती है—हे राधा-कृष्ण! कृपया मुझे अपने वृंदावन के नित्य विहार-रस में पूर्णत: डुबा दीजिए। [2]","english_text":null,"english_translation":"(Raag Gauri)\nPyaari Ju Mokon Kripa Karo,\nAisi Ruchi Upajai Jiye Mere Tumheen Na Chhin Bisaro. [1]\nAapun Apni Kari Prem Badhaavahu, Nij Ras Reeti Soun Hiyau Bharo.\nShri Bihaari Bihaarini Daasi Kahat Yaun, Vipin Vihaar Dharo. [2]\n- Shri Biharin Dev - Biharin Dev Ki Vaani, Siddhant Ke Pad (186)\nO Beloved (Radha), please bestow Your mercy upon me,\nLet such a taste of your rasa awaken in my heart that I may never forget You even for a moment. [1]\nPlease make me your very own and increase my love for you, filling my heart with the sweetness of your mode of rasa.\nSri Biharin Dev, servant of Shri Bihari Biharini says, \"May you provide me the Nitya Vihara Rasa (eternal love-play) of Vrindavan\". [2]","description":"https://www.brajrasik.org/hi/articles/5ab3da4e9f7ab760360f9c06/pyari-ju-mokon-kripa-karo-shri-biharin-dev-biharin-dev-ki-vaani","author":"श्री बिहारिन देव, बिहारिन देव की वाणी, सिद्धान्त के पद (186)","status":"published","content_text":"(राग गौरी)\nप्यारी जू मोकों कृपा करो,\nऐसी रूचि उपजै जिए मेरे तुम्हीं न छिन्न बिसरो ॥ [1]\nआपुन अपनी करि प्रेम बढ़ावहु, निज रस रीति सौं हियौ भरो ।\nश्री बिहारी बिहारिनि दासी कहत यौं, विपिन विहार ढ़रो ॥ [2]\n- श्री बिहारिन देव, बिहारिन देव की वाणी, सिद्धान्त के पद (186)\nहे प्यारी जू (श्री राधा)! मुझ पर कृपा करें कि मेरे हृदय में ऐसी प्रेम-रुचि उत्पन्न हो जाए कि आप कभी भी, क्षणमात्र के लिए भी, विस्मृत न हों। [1]\nआप स्वयं अपनी कृपा से मेरे प्रेम को बढ़ाइए और अपने दिव्य रस की रीति से मेरे हृदय को पूर्णत: भर दीजिए। श्री बिहारी-बिहारिनि की दासी कहती है—हे राधा-कृष्ण! कृपया मुझे अपने वृंदावन के नित्य विहार-रस में पूर्णत: डुबा दीजिए। [2]","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5ab3da4e9f7ab760360f9c06/pyari-ju-mokon-kripa-karo-shri-biharin-dev-biharin-dev-ki-vaani","slug":"pyari-ju-mokon-kripa-karo"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","div",null,{"lang":"hi","children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","hi","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]}]],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L8",null,{"children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":"404"}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",nu