dren":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri bhagavat rasik, bhagavat rasik ki vani, ananyanishchayatm granth, purvarddh (33)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री भगवत रसिक, भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ, पूर्वार्द्ध (33)","hinglishName":"shri bhagavat rasik, bhagavat rasik ki vani, ananyanishchayatm granth, purvarddh (33)","slug":"shri-bhagavat-rasik-bhagavat-rasik-ki-vani-ananyanishchayatm-granth-purvarddh-33","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-381","title":"जावक जुत जुग चरण लली के","category":"Shloka","sanskrit_text":"जावक जुत जुग चरण लली के । [1]अद्भुत, अमल, अनूप, दिवाकर, मोहन मानस कंज कली के  ॥ [2]मंजुल, मृदुल मनोहर, सुखनिधि, सुभग सिंगार निकुंज गली के । [3]सुरतरु कामधेनु, चिंतामणि, भगवत रसिक अनन्य अली के  ॥ [4]","hindi_text":"श्री किशोरी जी के महाबर से युक्त दोनों चरणारविंद अद्भुत निर्मल एवं अनुपम हैं। [1]\nये प्रियतम की हृदय रूपी कमल कलिका को विकसित करने वाले सूर्य हैं । [2]\nसुन्दर, कोमल मनोहर और आनंद के पारावार ये (चरणारविन्द) निकुंज गली के सुभग श्रृंगार है। [3]\nभगवत रसिक जी कहते हैं कि (मनोकामनाओं को पूरा करने वाले होने के कारण) मेरे जैसी अनन्य सखी के लिए तो ये ही कल्पवृक्ष है, ये ही कामधेनु हैं और ये ही चिंतामणि हैं। मेरी तो ये ही सब कुछ है || ३३ ||","english_text":null,"english_translation":"$5","description":"https://www.brajrasik.org/hi/articles/5b1112689f7ab760360f9c75/avakjuta-jug-charan-lali-ke-shri-bhagwat-rasik-shri-bhagwat-rasik-ki-vani-33","author":"श्री भगवत रसिक, भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ, पूर्वार्द्ध (33)","status":"published","content_text":"जावक जुत जुग चरण लली के । [1]\nअद्भुत, अमल, अनूप, दिवाकर, मोहन मानस कंज कली के  ॥ [2]\nमंजुल, मृदुल मनोहर, सुखनिधि, सुभग सिंगार निकुंज गली के । [3]\nसुरतरु कामधेनु, चिंतामणि, भगवत रसिक अनन्य अली के  ॥ [4]\n- श्री भगवत रसिक, भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ, पूर्वार्द्ध (33)\nश्री किशोरी जी के महाबर से युक्त दोनों चरणारविंद अद्भुत निर्मल एवं अनुपम हैं। [1]\nये प्रियतम की हृदय रूपी कमल कलिका को विकसित करने वाले सूर्य हैं । [2]\nसुन्दर, कोमल मनोहर और आनंद के पारावार ये (चरणारविन्द) निकुंज गली के सुभग श्रृंगार है। [3]\nभगवत रसिक जी कहते हैं कि (मनोकामनाओं को पूरा करने वाले होने के कारण) मेरे जैसी अनन्य सखी के लिए तो ये ही कल्पवृक्ष है, ये ही कामधेनु हैं और ये ही चिंतामणि हैं। मेरी तो ये ही सब कुछ है || ३३ ||","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b1112689f7ab760360f9c75/avakjuta-jug-charan-lali-ke-shri-bhagwat-rasik-shri-bhagwat-rasik-ki-vani-33","slug":"javak-jut-jug-charan-lali-ke"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L6",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$7","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L8",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L6",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L8",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en",