0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","shri-lalit-kishori-abhilash-madhuri-vinay-233","d"],{"children":["__PAGE__?{\"slug\":\"shri-lalit-kishori-abhilash-madhuri-vinay-233\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","shri-lalit-kishori-abhilash-madhuri-vinay-233","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री ललित किशोरी, अभिलाष माधुरी, विनय (233)\",\"alternateName\":\"shri lalit kishori, abhilash madhuri, vinay (233)\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/shri-lalit-kishori-abhilash-madhuri-vinay-233\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"shri lalit kishori, abhilash madhuri, vinay (233)\",\"item\":\"https://path.vrindopnishad.in/saints/shri-lalit-kishori-abhilash-madhuri-vinay-233\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri lalit kishori, abhilash madhuri, vinay (233)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री ललित किशोरी, अभिलाष माधुरी, विनय (233)","hinglishName":"shri lalit kishori, abhilash madhuri, vinay (233)","slug":"shri-lalit-kishori-abhilash-madhuri-vinay-233","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-502","title":"जब श्रीवनवास मिलो सजनी तब तीरथ आन गए न गए","category":"Shloka","sanskrit_text":"जब श्रीवनवास मिलो सजनी, तब तीरथ आन गए न गए।जब लाड़लीलाल को नाम लयो, तव नाम न आन लये न लये॥ [1]पदकंज किशोरीहि चित्त पग्यो, तव पायन आन नए न नए।जब नैन लगे मनमोहनसों, तब औगुन आन भये न भये ॥ [2]","hindi_text":"यदि श्रीवृन्दावन में वास मिल गया, तब अन्य तीर्थों पर जाने की आवश्यकता नहीं रही।\nयदि लाड़लीलाल का नाम ले लिया, तब किसी और नाम को लेने की जरूरत नहीं रही। [1]\nयदि हृदय श्री राधा के चरण-कमलों में लग गया, तब किसी अन्य पथ या किसी अन्य के चरणों में झुकने की आवश्यकता नहीं रही।\nयदि नयन मनमोहन (श्रीकृष्ण) में लग गए, तब बाकी सभी अवगुण अपने आप मिट गए। [2]","english_text":null,"english_translation":"If one gains residence in Śrī Vṛndāvana, no other holy site is needed. If one chants the divine Couple’s name, no other name matters. [1]\nIf the mind fixes at Śrī Rādhā’s lotus feet, no other path or shelters are worth seeking. If eyes are absorbed in beholding Manmohana (Śrī Kṛṣṇa), all faults vanish on their own. [2]","description":"https://www.brajrasik.org/hi/articles/5b1e8a529f7ab760360f9c8d/jab-shrivan-vas-milo-sajanee-shri-lalit-kishori-abhilash-madhuri-233","author":"श्री ललित किशोरी, अभिलाष माधुरी, विनय (233)","status":"published","content_text":"(राग जिला झिंझोटी)\nजब श्रीवनवास मिलो सजनी, तब तीरथ आन गए न गए।\nजब लाड़लीलाल को नाम लयो, तव नाम न आन लये न लये॥ [1]\nपदकंज किशोरीहि चित्त पग्यो, तव पायन आन नए न नए।\nजब नैन लगे मनमोहनसों, तब औगुन आन भये न भये ॥ [2]\n- श्री ललित किशोरी, अभिलाष माधुरी, विनय (233)\nयदि श्रीवृन्दावन में वास मिल गया, तब अन्य तीर्थों पर जाने की आवश्यकता नहीं रही।\nयदि लाड़लीलाल का नाम ले लिया, तब किसी और नाम को लेने की जरूरत नहीं रही। [1]\nयदि हृदय श्री राधा के चरण-कमलों में लग गया, तब किसी अन्य पथ या किसी अन्य के चरणों में झुकने की आवश्यकता नहीं रही।\nयदि नयन मनमोहन (श्रीकृष्ण) में लग गए, तब बाकी सभी अवगुण अपने आप मिट गए। [2]","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b1e8a529f7ab760360f9c8d/jab-shrivan-vas-milo-sajanee-shri-lalit-kishori-abhilash-madhuri-233","slug":"jab-shrivanavas-milo-sajani-tab-tirath-an-gae-n-gae"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L8",null,{"children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$un