0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","shri-ali-kishori-shri-kishori-ali-grnthavali","d"],{"children":["__PAGE__?{\"slug\":\"shri-ali-kishori-shri-kishori-ali-grnthavali\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","shri-ali-kishori-shri-kishori-ali-grnthavali","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री अली किशोरी, श्री किशोरी अली ग्रंथवाली\",\"alternateName\":\"shri ali kishori, shri kishori ali grnthavali\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/shri-ali-kishori-shri-kishori-ali-grnthavali\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"shri ali kishori, shri kishori ali grnthavali\",\"item\":\"https://path.vrindopnishad.in/saints/shri-ali-kishori-shri-kishori-ali-grnthavali\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri ali kishori, shri kishori ali grnthavali"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री अली किशोरी, श्री किशोरी अली ग्रंथवाली","hinglishName":"shri ali kishori, shri kishori ali grnthavali","slug":"shri-ali-kishori-shri-kishori-ali-grnthavali","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-37","title":"स्वामिनी कब यौं तुम्हे लड़ाऊँ","category":"Shloka","sanskrit_text":"स्वामिनी कब यौं तुम्हे लड़ाऊँ,सटकारे कारे केशनी में, सुरभित तेल लगाऊं ||","hindi_text":"श्री राधे, ऐसा कब होगा कि आपकी प्रेम पूर्वक मैं सेवा और लाड़ लड़ाउंगी और आपके चिकने और लम्बे कारे केशों में सुगन्धित तेल लगाउंगी ?","english_text":null,"english_translation":"Oh Shri Radhey Ju, When will that day come, when I will lovingly serve you and apply aromatic oil in your long black hairs!","description":"https://www.brajrasik.org/hi/articles/5b66990ef96927004faaba74/swamini-kab-yon-tumhe-ladaun-shri-kishori-ali-kishori-ali-granthwali","author":"श्री अली किशोरी, श्री किशोरी अली ग्रंथवाली","status":"published","content_text":"स्वामिनी कब यौं तुम्हे लड़ाऊँ,\nसटकारे कारे केशनी में, सुरभित तेल लगाऊं ||\n- श्री अली किशोरी, श्री किशोरी अली ग्रंथवाली\nश्री राधे, ऐसा कब होगा कि आपकी प्रेम पूर्वक मैं सेवा और लाड़ लड़ाउंगी और आपके चिकने और लम्बे कारे केशों में सुगन्धित तेल लगाउंगी ?","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b66990ef96927004faaba74/swamini-kab-yon-tumhe-ladaun-shri-kishori-ali-kishori-ali-granthwali","slug":"svamini-kab-yaun-tumhe-laaun"},{"id":"local-631","title":"जय जय श्री वृन्दावन धाम","category":"Shloka","sanskrit_text":"जय जय श्री वृन्दावन धाम,सब सुख दैंन परम हितकारी, रसिकन कौ विश्राम |अली किशोरी कौन कहे गुन, निज गुन गावत श्याम |","hindi_text":"श्री अली किशोरी जी कहते हैं, श्री वृन्दावन धाम की जय हो जय हो, क्योंकि श्री वृन्दावन धाम परम हितकारी है, यह सब सुखों को देने वाला एवं रसिको का विश्राम है । जिस वृन्दावन धाम के गुणगान स्वयं श्री कृष्ण करते है तो फिर इसके बारे में कौन क्या कहे ?","english_text":null,"english_translation":"All Glories to Shri Vrindavan Dham. The divine place provides ultimate bliss, is supreme auspicious and resting place of the Rasik saints. Shri Ali Kishori says, What else I or anyone else can say, Even Shri Krishn himself sings the glories of Vrindavan all the time.","description":"https://www.brajrasik.org/hi/articles/5b27f0c39f7ab760360f9ca4/jai-jai-shri-vrindavan-dham-sab-sukh-dain-param-hitakari-rasikan-kou-vishram-ali-kishori-kaun-kahe-gun-nij-gun-gavat-shyam-shri-ali-kishori-shri-kishori-ali-granthawali","author":"श्री अली किशोरी, श्री किशोरी अली ग्रंथवाली","status":"published","content_text":"जय जय श्री वृन्दावन धाम,\nसब सुख दैंन परम हितकारी, रसिकन कौ विश्राम |\nअली किशोरी कौन कहे गुन, निज गुन गावत श्याम |\n- श्री अली किशोरी, श्री किशोरी अली ग्रंथवाली\nश्री अली किशोरी जी कहते हैं, श्री वृन्दावन धाम की जय हो जय हो, क्योंकि श्री वृन्दावन धाम परम हितकारी है, यह सब सुखों को देने वाला एवं रसिको का विश्राम है । जिस वृन्दावन धाम के गुणगान स्वयं श्री कृष्ण करते है तो फिर इसके बारे में कौन क्या कहे ?","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b27f0c39f7ab760360f9ca4/jai-jai-shri-vrindavan-dham-sab-sukh-dain-param-hitakari-rasikan-kou-vishram-ali-kishori-kaun-kahe-gun-nij-gun-gavat-shyam-shri-ali-kishori-shri-kishori-ali-granthawali","slug":"jay-jay-shri-vrindavan-dhama"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","