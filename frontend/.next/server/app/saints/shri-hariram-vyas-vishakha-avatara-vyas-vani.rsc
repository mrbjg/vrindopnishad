0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","shri-hariram-vyas-vishakha-avatara-vyas-vani","d"],{"children":["__PAGE__?{\"slug\":\"shri-hariram-vyas-vishakha-avatara-vyas-vani\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","shri-hariram-vyas-vishakha-avatara-vyas-vani","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी\",\"alternateName\":\"shri hariram vyas (vishakha avatara) vyas vani\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/shri-hariram-vyas-vishakha-avatara-vyas-vani\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"shri hariram vyas (vishakha avatara) vyas vani\",\"item\":\"https://path.vrindopnishad.in/saints/shri-hariram-vyas-vishakha-avatara-vyas-vani\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri hariram vyas (vishakha avatara) vyas vani"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी","hinglishName":"shri hariram vyas (vishakha avatara) vyas vani","slug":"shri-hariram-vyas-vishakha-avatara-vyas-vani","biography":"","metadata":{"lineageEn":"Vaishnav Rasik Tradition (Haritrayi)","lineageHi":"वैष्णव रसिक परंपरा (हरित्रयी)","timelineEn":"1510–1612 AD","timelineHi":"1510–1612 ईस्वी","associatedPlacesEn":"Vyas Ghera, Vrindavan","associatedPlacesHi":"व्यास घेरा, वृंदावन","discipleOfEn":"Shri Madhavdas Bhatta (disciple of Hit Harivansh)","discipleOfHi":"श्री माधवदास भट्ट जी (हित हरिवंश महाप्रभु के शिष्य)","influencedByEn":"Swami Haridas and Shri Hit Harivansh Mahaprabhu (forming the Haritrayi)","influencedByHi":"स्वामी हरिदास एवं श्री हित हरिवंश महाप्रभु (हरित्रयी परंपरा)","associatedSampradayaEn":"Radhavallabh / Haritrayi Tradition","associatedSampradayaHi":"राधावल्लभ / हरित्रयी परंपरा","devotionalMoodEn":"Humility, Raganuga Bhakti, Sakhi Bhava","devotionalMoodHi":"परम विनम्रता, रागानुगा भक्ति, सखी भाव","teachingsEn":"Emphasized pure, unadorned devotion based on absolute humility, rejection of caste pride, and criticism of ritualistic hypocrisy. Believed that only a humble heart can experience the sweet nectar of Vrindavan.","teachingsHi":"जाति-पाति के अभिमान का त्याग, बाह्य कर्मकांडों का विरोध और परम विनम्रता पर आधारित भक्ति। उनका मानना था कि केवल अहंकार रहित हृदय ही वृंदावन रस का अधिकारी है।","literaryStyleEn":"Author of Vyas Vani (व्यास वाणी), written in bold, direct Braj Bhasha. His verses contain both ecstatic descriptions of the Divine Couple and sharp, instructional remarks on behavior and sincerity.","literaryStyleHi":"'Vyas Vani' के रचयिता, जो अपनी स्पष्टवादिता और ठेठ ब्रजभाषा के लिए जानी जाती है। इनके पदों में लीला रस के साथ-साथ साधकों के लिए व्यावहारिक उपदेश भी प्रचुरता में हैं।","biographyEn":"Shri Hariram Vyas, affectionately known as Vyas Ji, was a prominent contemporary of Swami Haridas and Hit Harivansh Mahaprabhu. Together, these three saints are celebrated as the \"Haritrayi\" (spiritual triad) of Vrindavan, who established the foundations of Rasik theology. Born in Orchha, Madhya Pradesh, Hariram Vyas left his high royal position and vast scholarship to live as a humble beggar in the dust of Vrindavan. He established his ashram at Vyas Ghera and worshiped the deity of Jugal Kishor Ji. His writings are famously candid, warning devotees against spiritual vanity and urging them to seek the shelter of true saintly association (Sadhu Sanga).","biographyHi":"श्री हरिराम व्यास (व्यास जी) वृंदावन के ऐतिहासिक त्रिमूर्ति 'हरित्रयी' के तीसरे स्तम्भ थे। वे ओरछा के एक प्रतिष्ठित विद्वान थे, परंतु सब कुछ त्यागकर वृंदावन की धूल में आ बसे। उन्होंने व्यास घेरा में रहकर युगल किशोर जी की सेवा की। व्यास जी अपनी बेबाक और स्पष्ट टिप्पणियों के लिए प्रसिद्ध थे। उन्होंने संतों के प्रति अपराध और वैष्णवों में आपसी भेद का कड़ा विरोध किया और सरल प्रेम मार्ग को ही सर्वोत्तम बताया।","relatedSaints":[{"nameEn":"Swami Haridas","nameHi":"स्वामी हरिदास","slug":"haridas"},{"nameEn":"Shri Hit Harivansh","nameHi":"श्री हित हरिवंश","slug":"hit-harivansh"}],"relatedGranthas":[{"nameEn":"Vyas Vani","nameHi":"व्यास वाणी","slug":"vyas-vani"}],"associatedGlossary":[{"termEn":"Sadhana","termHi":"साधना","slug":"sadhana"},{"termEn":"Saranagati","termHi":"शरणागति","slug":"saranagati"},{"termEn":"Braj Bhasha","termHi":"ब्रजभाषा","slug":"braj-bhasha"}],"faq":[{"qEn":"Where is Vyas Ghera located?","aEn":"Vyas Ghera is located in Vrindavan near the Yamuna river, serving as the historical bhajan site and samadhi of Hariram Vyas Ji.","qHi":"व्यास घेरा कहाँ स्थित है?","aHi":"व्यास घेरा वृंदावन में यमुना नदी के समीप स्थित है, जो हरीराम व्यास जी की भजन स्थली और उनकी समाधि स्थली है।"}]},"imageUrl":null,"verses":[{"id":"local-359","title":"वृन्दावन के रूख हमारो मात पिता गुरु बंधु","category":"Shloka","sanskrit_text":"\"वृन्दावन के रूख हमारो मात पिता गुरु बंधु  ||\"","hindi_text":"- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\nवृंदावन के वृक्ष हमारे माता, पिता, आध्यात्मिक गुरु और भाई हैं।","english_text":null,"english_translation":"- Shri Hariram Vyas (Vishakha Avtaar) - Vyas Vani\nThe trees of Vrindavan are our mother, father, spiritual master and brother.","description":"https://www.brajrasik.org/hi/articles/5aeaabef9f7ab760360f9c45/vrindavan-ke-rookh-humaro-mat-pita-guru-bandhu-his-holiness-shri-hariram-vyas-vishakha-avtaar-vyas-vaani","author":"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी","status":"published","content_text":"\"वृन्दावन के रूख हमारो मात पिता गुरु बंधु  ||\"\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\nवृंदावन के वृक्ष हमारे माता, पिता, आध्यात्मिक गुरु और भाई हैं।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5aeaabef9f7ab760360f9c45/vrindavan-ke-rookh-humaro-mat-pita-guru-bandhu-his-holiness-shri-hariram-vyas-vishakha-avtaar-vyas-vaani","slug":"vrindavan-ke-rukh-hamaro-mat-pita-guru-bndhu"},{"id":"local-412","title":"‘व्यास’ आस छाँड़हु सब ही की","category":"Shloka","sanskrit_text":"‘व्यास’ आस छाँड़हु सब ही की, कृपा करी राधा-नंदनदन |","hindi_text":"- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\nश्री हरिराम व्यास (श्री विशाखा अवतार) कहते हैं, किसी व्यक्ति एवं संसारी पदार्थ की आस मत रखो और पूर्ण रूप से मन से मान लो कि केवल और केवल श्री राधा कृष्ण ही तुम्हारे अपने हैं और उन्ही से ही समस्त आशाएं रखो |","english_text":null,"english_translation":"Shri Hariram Vyas, descension of Vishakha sakhi says, Do not expect any favor from anyone and realize it wholeheartedly that only Shri Radha Krishn is yours and let all your hopes confined to them alone.","description":"https://www.brajrasik.org/hi/articles/5aeab0a29f7ab760360f9c48/vyaas-aas-chodhu-sab-ki-kripa-kari-radhanandanadan","author":"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी","status":"published","content_text":"‘व्यास’ आस छाँड़हु सब ही की, कृपा करी राधा-नंदनदन |\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\nश्री हरिराम व्यास (श्री विशाखा अवतार) कहते हैं, किसी व्यक्ति एवं संसारी पदार्थ की आस मत रखो और पूर्ण रूप से मन से मान लो कि केवल और केवल श्री राधा कृष्ण ही तुम्हारे अपने हैं और उन्ही से ही समस्त आशाएं रखो |","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5aeab0a29f7ab760360f9c48/vyaas-aas-chodhu-sab-ki-kripa-kari-radhanandanadan","slug":"vyasa-as-chhandahu-sab-hi-ki"},{"id":"local-442","title":"गौर स्याम सोभा सागर कौ, नाँहिन वारापारु","category":"Shloka","sanskrit_text":"गौर स्याम सोभा सागर कौ, नाँहिन वारापारु |व्यास स्वामिनी की छबि आगैं, सकल सरूप उगारु ||","hindi_text":"गौर स्याम सोभा सागर कौ, नाँहिन वारापारु |\nव्यास स्वामिनी की छबि आगैं, सकल सरूप उगारु ||\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\n\"युगल सरकार की शोभा रुपी समुद्र, जो नित्य प्रतिदिन बढ़ता रहता है उसका आंकलन करना (मापना) असंभव है।  श्री हरिराम व्यास जी कहते है कि किशोरी जू की छवि के प्रकाश के आगे सब प्रकाश फीके है।\"","english_text":null,"english_translation":"The ocean of the ever-increasing glimpses of divine couple Shri Radha Krishn is impossible to measure. Shri Hariram Vyas says, All other Glimpses looks insignificant compared to the charming glimpse of Swami Shri Radharani!","description":"https://www.brajrasik.org/hi/articles/5b3da4669f7ab760360f9ccf/gaur-shyam-shobha-sagar-kou-nahin-varaparu-vyas-swamini-ki-chabhi-aagein-sakal-saroop-ugaru-vishakha-avtar-shri-hariram-vyas-shri-vyas-vani","author":"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी","status":"published","content_text":"गौर स्याम सोभा सागर कौ, नाँहिन वारापारु |\nव्यास स्वामिनी की छबि आगैं, सकल सरूप उगारु ||\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\n\"युगल सरकार की शोभा रुपी समुद्र, जो नित्य प्रतिदिन बढ़ता रहता है उसका आंकलन करना (मापना) असंभव है।  श्री हरिराम व्यास जी कहते है कि किशोरी जू की छवि के प्रकाश के आगे सब प्रकाश फीके है।\"","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b3da4669f7ab760360f9ccf/gaur-shyam-shobha-sagar-kou-nahin-varaparu-vyas-swamini-ki-chabhi-aagein-sakal-saroop-ugaru-vishakha-avtar-shri-hariram-vyas-shri-vyas-vani","slug":"gaur-syam-sobha-sagar-kau-nanhin-varaparu"},{"id":"local-517","title":"तब मेरे नैंन सिरात किसोरी जब तेरे नैंन निहारौं","category":"Shloka","sanskrit_text":"तब मेरे नैंन सिरात किसोरी जब तेरे नैंन निहारौं","hindi_text":"- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\nहे किशोरी राधा, मेरे नयन रस में केवल तभी विसर्जित होती हैं जब मैं आपके रसीले नयनों को निहारता हूं।","english_text":null,"english_translation":"O Kishori Radha, My eyes are immersed in bliss only when I see your nectarean eyes.","description":"https://www.brajrasik.org/hi/articles/5b0bba229f7ab760360f9c6b/tab-mere-nain-siraat-kisori-jab-tere-nain-niharon-vishakha-avtar-shri-hariram-vyas-vyas-vani","author":"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी","status":"published","content_text":"तब मेरे नैंन सिरात किसोरी जब तेरे नैंन निहारौं\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\nहे किशोरी राधा, मेरे नयन रस में केवल तभी विसर्जित होती हैं जब मैं आपके रसीले नयनों को निहारता हूं।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b0bba229f7ab760360f9c6b/tab-mere-nain-siraat-kisori-jab-tere-nain-niharon-vishakha-avtar-shri-hariram-vyas-vyas-vani","slug":"tab-mere-nainn-sirat-kisori-jab-tere-nainn-niharaun"},{"id":"local-551","title":"श्री राधा ललितादिक मेरे जीवनी प्राण आधार, सर्वेषु व्यास दास को वन है वृन्दावनहि अभार ||","category":"Katha","sanskrit_text":"श्री राधा ललितादिक मेरे जीवनी प्राण आधार,सर्वेषु व्यास दास को वन है वृन्दावनहि अभार ||","hindi_text":"श्री राधा ललितादिक मेरे जीवनी प्राण आधार,\nसर्वेषु व्यास दास को वन है वृन्दावनहि अभार ||\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\nश्री राधा और ललिता आदि उनकी साखियां मेरे जीवन का प्राण हैं। विशाखा अवतार श्री हरिराम व्यास का कहना है, श्री वृंदावन की महिमा अपरम्पार है जहां वह हर पल उपस्थित हैं ।","english_text":null,"english_translation":"Shri Radha Lalitadik Mere Jeevani Praan Aadhar,\nSarveshu Vyaas Das Ko Van Hai, Vrindavanhi Abhaar\"\n- His Holiness Shri Hariram Vyas (Vishakha Avtaar) - Vyas Vaani\nShri Radha and her sakhis like Lalita are the treasure of my life. Shri Hariram Vyas descencion of Vishakha sakhi says, All glories to Shri Vrindavan, the place where she is present every moment.","description":"https://www.brajrasik.org/hi/articles/5acbcf039f7ab760360f9c26/shri-radha-lalitadik-mere-jeevani-praan-aadhar-quote-by-shri-hariram-vyas","author":"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी","status":"published","content_text":"श्री राधा ललितादिक मेरे जीवनी प्राण आधार,\nसर्वेषु व्यास दास को वन है वृन्दावनहि अभार ||\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\nश्री राधा और ललिता आदि उनकी साखियां मेरे जीवन का प्राण हैं। विशाखा अवतार श्री हरिराम व्यास का कहना है, श्री वृंदावन की महिमा अपरम्पार है जहां वह हर पल उपस्थित हैं ।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5acbcf039f7ab760360f9c26/shri-radha-lalitadik-mere-jeevani-praan-aadhar-quote-by-shri-hariram-vyas","slug":"shri-radha-lalitadik-mere-jivani-pran-adhar-sarveshu-vyas-das-ko-van-hai-vrindavanahi-abhar"},{"id":"local-557","title":"यहै अनन्य धर्म पटपाटी यहै","category":"Shloka","sanskrit_text":"\" यहै अनन्य धर्म पटपाटी यहै, वृन्दावन तजि अनत न जाइए | \"","hindi_text":"- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\nयह रसिक अनन्य धर्म है कि वृन्दावन को त्याग कर अन्य कहीं मत जाइए।","english_text":null,"english_translation":"- Shri Hariram Vyas (Vishakha Avtar) - Vyas Vani\n\"Never leave Vrindavan at any cost\", is the exclusive devotion cum religion of Rasik Saints towards Vrindavan.","description":"https://www.brajrasik.org/hi/articles/5ad064b09f7ab760360f9c2c/yahi-ananya-dharm-patpaati-yehi-vrindavan-taji-anat-na-jaayie-shri-hariram-vyas-vishakha-avtar-vyas-vaani","author":"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी","status":"published","content_text":"\" यहै अनन्य धर्म पटपाटी यहै, वृन्दावन तजि अनत न जाइए | \"\n- श्री हरिराम व्यास (विशाखा अवतार) - व्यास वाणी\nयह रसिक अनन्य धर्म है कि वृन्दावन को त्याग कर अन्य कहीं मत जाइए।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5ad064b09f7ab760360f9c2c/yahi-ananya-dharm-patpaati-yehi-vrindavan-taji-anat-na-jaayie-shri-hariram-vyas-vishakha-avtar-vyas-vaani","slug":"yahai-anany-dharm-patapati-yahai"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L8",null,{"children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":