0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","shri-lalit-kishori-abhilash-madhuri","d"],{"children":["__PAGE__?{\"slug\":\"shri-lalit-kishori-abhilash-madhuri\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","shri-lalit-kishori-abhilash-madhuri","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री ललित किशोरी  अभिलाष माधुरी\",\"alternateName\":\"shri lalit kishori abhilash madhuri\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/shri-lalit-kishori-abhilash-madhuri\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"shri lalit kishori abhilash madhuri\",\"item\":\"https://path.vrindopnishad.in/saints/shri-lalit-kishori-abhilash-madhuri\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri lalit kishori abhilash madhuri"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री ललित किशोरी  अभिलाष माधुरी","hinglishName":"shri lalit kishori abhilash madhuri","slug":"shri-lalit-kishori-abhilash-madhuri","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-65","title":"राधे राधे जो जन कहै। महा प्रेम रस सोई लहै","category":"Shloka","sanskrit_text":"राधे राधे जो जन कहै। महा प्रेम रस सोई लह||प्रिया लाल तिनके सुख ढरें। रीझि रीझि अंक में भरें||छिन छिन अति आनंद बढ़ाये। श्री कुंज बिहारिनि निरखि सिहावें||यही बात सब सुख को सार। रसिकनी जीवन प्रान अधार||","hindi_text":"राधे राधे जो जन कहै। महा प्रेम रस सोई लह||\nप्रिया लाल तिनके सुख ढरें। रीझि रीझि अंक में भरें||\nछिन छिन अति आनंद बढ़ाये। श्री कुंज बिहारिनि निरखि सिहावें||\nयही बात सब सुख को सार। रसिकनी जीवन प्रान अधार||\n- श्री ललित किशोरी - अभिलाष माधुरी\nललित किशोरी जी के शब्दों में जो जन श्री \"राधे राधे\" कहता है (यह मानकर की किशोरीजी उनके नाम में बैठी हैं ) वह महा प्रेम रस प्राप्त करता है। प्रिया लाल उनसे रीझ कर उनको परम सुख प्रदान करते हैं और अपनी निज सेवा देते हैं। उनका हर क्षण आनंद बढ़ता ही जाता है, इस राधा नाम के प्रभाव से और कुंज बिहारिनि श्री राधा के रूप की छवि उनके हृदय में छाई रहती है। श्री ललित किशोरी जी के शब्दों में यह राधा नाम सब रस एवम सुख का मानो सार ही है और रसिकों के प्राण जीवन का आधार है।","english_text":null,"english_translation":"In the words of Shri Lalit Kishori, the person who chants as 'Radhe Radhe' (Assuming that Shri Radha herself is seated in her name) he gets nectar of ultimate divine bliss. With this chant, both Radha Krishn gets pleased with the person and shower him the ultimate bliss and bless that devotee with their personal service. Each and every moment, the devotee's bliss keeps on increasing, with the effect of this 'Radha' name chanting and the image of the divine form of Biharini Shri Radha, is continually reflected in his heart. In the words of Shri Lalit Kishori, this 'Radha' name is the essence of all of the divine nectarine bliss cum pleasures and for all Rasik saints, this 'Radha' name is the basis of their life and soul.","description":"https://www.brajrasik.org/hi/articles/5aac0abc9f7ab760360f9bf9/radhey-radhey-jo-jana-kahe-maha-prem-ras-soi-lahe-shri-lalit-kishori-abhilash-madhuri","author":"श्री ललित किशोरी  अभिलाष माधुरी","status":"published","content_text":"राधे राधे जो जन कहै। महा प्रेम रस सोई लह||\nप्रिया लाल तिनके सुख ढरें। रीझि रीझि अंक में भरें||\nछिन छिन अति आनंद बढ़ाये। श्री कुंज बिहारिनि निरखि सिहावें||\nयही बात सब सुख को सार। रसिकनी जीवन प्रान अधार||\n- श्री ललित किशोरी - अभिलाष माधुरी\nललित किशोरी जी के शब्दों में जो जन श्री \"राधे राधे\" कहता है (यह मानकर की किशोरीजी उनके नाम में बैठी हैं ) वह महा प्रेम रस प्राप्त करता है। प्रिया लाल उनसे रीझ कर उनको परम सुख प्रदान करते हैं और अपनी निज सेवा देते हैं। उनका हर क्षण आनंद बढ़ता ही जाता है, इस राधा नाम के प्रभाव से और कुंज बिहारिनि श्री राधा के रूप की छवि उनके हृदय में छाई रहती है। श्री ललित किशोरी जी के शब्दों में यह राधा नाम सब रस एवम सुख का मानो सार ही है और रसिकों के प्राण जीवन का आधार है।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5aac0abc9f7ab760360f9bf9/radhey-radhey-jo-jana-kahe-maha-prem-ras-soi-lahe-shri-lalit-kishori-abhilash-madhuri","slug":"radhe-radhe-jo-jan-kahai-maha-prem-ras-soi-lahai"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[