0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","hari-bhakti-vilas-11676","d"],{"children":["__PAGE__?{\"slug\":\"hari-bhakti-vilas-11676\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","hari-bhakti-vilas-11676","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"हरी भक्ति विलास (11.676)\",\"alternateName\":\"hari bhakti vilas (11.676)\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/hari-bhakti-vilas-11676\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"hari bhakti vilas (11.676)\",\"item\":\"https://path.vrindopnishad.in/saints/hari-bhakti-vilas-11676\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"hari bhakti vilas (11.676)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"हरी भक्ति विलास (11.676)","hinglishName":"hari bhakti vilas (11.676)","slug":"hari-bhakti-vilas-11676","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-404","title":"शरणागति के 6 लक्षण","category":"Shloka","sanskrit_text":"अनुकूलस्य संकल्प: प्रतिकूलस्य वर्जनम् ।रक्षिस्यतीति विश्वासो, गोप्तृत्व वरणं तथा ।।आत्म निपेक्ष कापीव्यं षड्विद्या शरणागति: ।।","hindi_text":"शरणागति के 6 लक्षण हैं जिन्हें श्री सनातन गोस्वामी जी ने अपने ग्रंथ हरीभक्ति विलास में बताया है। यदि यह 6 लक्षण हैं तो इसी के आधार पर ही माना जा सकता है कि जीव भगवान के शरणागत है या नहीं।\n1. सर्वप्रथम है अपने शरण्य के अनुकूल ही सोचना। क्रिया तो बहुत दूर की बात है भीतर से भी अपने शरण्य के विपरीत नहीं सोचना।\n2. दूसरा है प्रतिकूल वर्जनम। इसका तात्पर्य है कि जो भी भक्ति के अनुरूप ना हो उसका पूर्ण रूप से परित्याग।\n3. तीसरा यह की हर समय विश्वास रहे कि भगवान मेरी रक्षा करेंगे।\n4. चौथा है भगवान के प्रति हर समय हृदय से आभार प्रकट होता रहे। अर्थात अभी तक जो हुआ है और आगे भी जो साधना होगी वह केवल और केवल श्री भगवान की कृपा से ही हुआ है एवं होगा।\n5. पांचवा है यह मानना कि जो भी मिला है वह भगवान का दिया हुआ है और अपना कुछ भी ना मानना।\n6. छठवां है शरणागति के अभिमान का भी त्याग कर देना। यह सबसे महत्वपूर्ण है।","english_text":null,"english_translation":"The above verse explains the six aspects of surrender to God:\n1) To desire only in accordance with the desire of God.\n2) Reject what is not in favor of devotion.\n3) The faith that God will surely protect me.\n4) To maintain an attitude of gratitude toward God.\n5) To see everything we possess as belonging to God.\n6) To give up the pride of having surrendered.","description":"https://www.brajrasik.org/hi/articles/59a6ea0959e8c72a534d85b7/six-aspects-of-surrender-to-god-sanatan-goswami","author":"हरी भक्ति विलास (11.676)","status":"published","content_text":"अनुकूलस्य संकल्प: प्रतिकूलस्य वर्जनम् ।\nरक्षिस्यतीति विश्वासो, गोप्तृत्व वरणं तथा ।।\nआत्म निपेक्ष कापीव्यं षड्विद्या शरणागति: ।।\n-\nहरी भक्ति विलास (11.676)\nशरणागति के 6 लक्षण हैं जिन्हें श्री सनातन गोस्वामी जी ने अपने ग्रंथ हरीभक्ति विलास में बताया है। यदि यह 6 लक्षण हैं तो इसी के आधार पर ही माना जा सकता है कि जीव भगवान के शरणागत है या नहीं।\n1. सर्वप्रथम है अपने शरण्य के अनुकूल ही सोचना। क्रिया तो बहुत दूर की बात है भीतर से भी अपने शरण्य के विपरीत नहीं सोचना।\n2. दूसरा है प्रतिकूल वर्जनम। इसका तात्पर्य है कि जो भी भक्ति के अनुरूप ना हो उसका पूर्ण रूप से परित्याग।\n3. तीसरा यह की हर समय विश्वास रहे कि भगवान मेरी रक्षा करेंगे।\n4. चौथा है भगवान के प्रति हर समय हृदय से आभार प्रकट होता रहे। अर्थात अभी तक जो हुआ है और आगे भी जो साधना होगी वह केवल और केवल श्री भगवान की कृपा से ही हुआ है एवं होगा।\n5. पांचवा है यह मानना कि जो भी मिला है वह भगवान का दिया हुआ है और अपना कुछ भी ना मानना।\n6. छठवां है शरणागति के अभिमान का भी त्याग कर देना। यह सबसे महत्वपूर्ण है।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/59a6ea0959e8c72a534d85b7/six-aspects-of-surrender-to-god-sanatan-goswami","slug":"sharanagati-ke-6-lakshana"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_ne