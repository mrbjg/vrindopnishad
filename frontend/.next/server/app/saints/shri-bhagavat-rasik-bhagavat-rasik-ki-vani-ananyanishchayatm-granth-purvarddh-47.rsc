0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","shri-bhagavat-rasik-bhagavat-rasik-ki-vani-ananyanishchayatm-granth-purvarddh-47","d"],{"children":["__PAGE__?{\"slug\":\"shri-bhagavat-rasik-bhagavat-rasik-ki-vani-ananyanishchayatm-granth-purvarddh-47\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","shri-bhagavat-rasik-bhagavat-rasik-ki-vani-ananyanishchayatm-granth-purvarddh-47","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री भगवत रसिक  भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ  पूर्वार्द्ध (47)\",\"alternateName\":\"shri bhagavat rasik bhagavat rasik ki vani, ananyanishchayatm granth purvarddh (47)\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/shri-bhagavat-rasik-bhagavat-rasik-ki-vani-ananyanishchayatm-granth-purvarddh-47\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"shri bhagavat rasik bhagavat rasik ki vani, ananyanishchayatm granth purvarddh (47)\",\"item\":\"https://path.vrindopnishad.in/saints/shri-bhagavat-rasik-bhagavat-rasik-ki-vani-ananyanishchayatm-granth-purvarddh-47\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri bhagavat rasik bhagavat rasik ki vani, ananyanishchayatm granth purvarddh (47)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री भगवत रसिक  भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ  पूर्वार्द्ध (47)","hinglishName":"shri bhagavat rasik bhagavat rasik ki vani, ananyanishchayatm granth purvarddh (47)","slug":"shri-bhagavat-rasik-bhagavat-rasik-ki-vani-ananyanishchayatm-granth-purvarddh-47","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-593","title":"दुख सुख भुगतै देह, नहिं कछु संक है","category":"Shloka","sanskrit_text":"दुख सुख भुगतै देह, नहिं कछु संक है।निंदा अस्तुति करौ, राव क्या रंक है।।परमारथ व्यवहार, बनौ कि ना बनौ ।अंजन है मम नैन, रसिक भगवत सनौ।।","hindi_text":"दुख सुख भुगतै देह, नहिं कछु संक है।\nनिंदा अस्तुति करौ, राव क्या रंक है।।\nपरमारथ व्यवहार, बनौ कि ना बनौ ।\nअंजन है मम नैन, रसिक भगवत सनौ।।\n- श्री भगवत रसिक - भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ - पूर्वार्द्ध (47)\nभगवत रसिक जी कहते है कि मेरा शरीर सुख भोगता रहे अथवा दुःख, संसार मेरी निंदा करता रहे या स्तुति, मैं धन सम्पन्न हो जाऊँ अथवा कंगाल, परमार्थ या लोक व्यवहार मुझसे बने या न बने इन सब बातों की मुझे कोई परवाह नहीं। मेरी यही प्रार्थना है कि आप दोनों मेरी आँखों में अंजन बनकर लगे रहें, अर्थात वह रस दृष्टि मिली रहे, जिससे प्रिया प्रियतम के नित्य विहार का अवलोकन बना रहे ।।","english_text":null,"english_translation":"Dukh Sukh Bhugate Deh, Nahin Kachu Sank Hai.\nNinda Astuti Karo, Raav Kya Rank Hai.\nParmarth Vyavhaar Bano Ki Na Bano.\nAnjan Hai Mam Nain, Rasik Bhagwat Suno.\n- Bhagwat Rasik Ji Ki Vani, AnanyaNishchayatma Granth - Purvardh (47)\nShri Bhagwat Rasik says, I do not care if my material body suffers great pain or my senses are fed with the extremity of material enjoyment. I do not care if you condemn me or praise me. I do not care if I become poor or rich. I do not care if I progress spiritually or not, I do not care if I can obey social formalities or not. I do not care for anything at all. But Oh My well-wisher Shri Radha Krishn, Please listen my plea, My only request is to be with me like a collyrium in my eyes and I only wish to have the incessant nectarean vision of 'Nitya Vihar' ( i.e Eternal evergoing leela of Yugal Sarkar).","description":"https://www.brajrasik.org/hi/articles/5bd97eca8123da005683b2ea/dukh-sukh-bhugate-deh-nahin-kachu-sank-hai-shri-bhagwat-rasik-bhagwat-rasik-ji-ki-vani-47","author":"श्री भगवत रसिक  भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ  पूर्वार्द्ध (47)","status":"published","content_text":"दुख सुख भुगतै देह, नहिं कछु संक है।\nनिंदा अस्तुति करौ, राव क्या रंक है।।\nपरमारथ व्यवहार, बनौ कि ना बनौ ।\nअंजन है मम नैन, रसिक भगवत सनौ।।\n- श्री भगवत रसिक - भगवत रसिक की वाणी, अनन्यनिश्चयात्म ग्रन्थ - पूर्वार्द्ध (47)\nभगवत रसिक जी कहते है कि मेरा शरीर सुख भोगता रहे अथवा दुःख, संसार मेरी निंदा करता रहे या स्तुति, मैं धन सम्पन्न हो जाऊँ अथवा कंगाल, परमार्थ या लोक व्यवहार मुझसे बने या न बने इन सब बातों की मुझे कोई परवाह नहीं। मेरी यही प्रार्थना है कि आप दोनों मेरी आँखों में अंजन बनकर लगे रहें, अर्थात वह रस दृष्टि मिली रहे, जिससे प्रिया प्रियतम के नित्य विहार का अवलोकन बना रहे ।।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5bd97eca8123da005683b2ea/dukh-sukh-bhugate-deh-nahin-kachu-sank-hai-shri-bhagwat-rasik-bhagwat-rasik-ji-ki-vani-47","slug":"dukh-sukh-bhugatai-deh-nahin-kachhu-snk-hai"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L8",null,{"children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fon