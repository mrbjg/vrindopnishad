f":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri lalit kishori dev, shri lalit kishori dev ju ki vani, ras ke pad (104)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री ललित किशोरी देव, श्री ललित किशोरी देव जू की वाणी, रस के पद (104)","hinglishName":"shri lalit kishori dev, shri lalit kishori dev ju ki vani, ras ke pad (104)","slug":"shri-lalit-kishori-dev-shri-lalit-kishori-dev-ju-ki-vani-ras-ke-pad-104","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-278","title":"हमारी लड़ैती साहिबिनी","category":"Shloka","sanskrit_text":"हमारी लड़ैती साहिबिनी,जाके लाल अधीन सदाई ऐसी है परवीनी।रोम रोम आनंद भरी है छिन्न छिन्न रूप नवीनी।।श्री हरिदासी रसिक सिरोमनि ललित केलि रस भीनी।","hindi_text":"श्री ललित किशोरी जी कहते हैं कि हमारी श्री राधा रानी ऐसी स्वामिनी हैं जिनके आधीन नित्य ही श्याम सुन्दर रहते हैं। श्री प्रिया जी के रोम रोम में आनंद ही आनंद है और उनका रूप सौंदर्य नित्य नव-नवायमान है। श्री ललित किशोरी कहते हैं कि रसिक शिरोमणि स्वामी श्री हरिदास के द्वारा बरसाया अंतरंग केलि रस बिना प्रयास के श्री राधारानी की करुणा से नित्य ही वह पीते हैं।","english_text":null,"english_translation":"Shri Lalit Kishori says that Shri Radharani is such a governess that Shri Krishn remains always under her control (he always follows the instructions of Shri Radha). The essence of nectar oozes from each and every pore of the body of Shri Radha, and her beauty is ever-new every moment. Shri Lalit Kishori says \"By the grace of one and only Shri Radha, He is drinking the nectar recommended & showered by the crest jewel of Rasiks i.e Lalita Avtaar Shri Haridas\".","description":"https://www.brajrasik.org/hi/articles/5c1366a2e3a92900583dfddc/humari-ladaiti-sahibini-shri-lalit-kishori-abhilash-madhuri","author":"श्री ललित किशोरी देव, श्री ललित किशोरी देव जू की वाणी, रस के पद (104)","status":"published","content_text":"हमारी लड़ैती साहिबिनी,\nजाके लाल अधीन सदाई ऐसी है परवीनी।\nरोम रोम आनंद भरी है छिन्न छिन्न रूप नवीनी।।\nश्री हरिदासी रसिक सिरोमनि ललित केलि रस भीनी।\n- श्री ललित किशोरी देव, श्री ललित किशोरी देव जू की वाणी, रस के पद (104)\nश्री ललित किशोरी जी कहते हैं कि हमारी श्री राधा रानी ऐसी स्वामिनी हैं जिनके आधीन नित्य ही श्याम सुन्दर रहते हैं। श्री प्रिया जी के रोम रोम में आनंद ही आनंद है और उनका रूप सौंदर्य नित्य नव-नवायमान है। श्री ललित किशोरी कहते हैं कि रसिक शिरोमणि स्वामी श्री हरिदास के द्वारा बरसाया अंतरंग केलि रस बिना प्रयास के श्री राधारानी की करुणा से नित्य ही वह पीते हैं।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5c1366a2e3a92900583dfddc/humari-ladaiti-sahibini-shri-lalit-kishori-abhilash-madhuri","slug":"hamari-laaiti-sahibini"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","