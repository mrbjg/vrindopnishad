0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","jagadguru-shri-kripalu-maharaj-prem-ras-madira-siddhanta-madhuri-101","d"],{"children":["__PAGE__?{\"slug\":\"jagadguru-shri-kripalu-maharaj-prem-ras-madira-siddhanta-madhuri-101\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","jagadguru-shri-kripalu-maharaj-prem-ras-madira-siddhanta-madhuri-101","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"जगद्गुरु श्री कृपालु  महाराज, प्रेम रस मदिरा, सिद्धान्त  माधुरी (101)\",\"alternateName\":\"jagadguru shri kripalu maharaj, prem ras madira, siddhanta madhuri (101)\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/jagadguru-shri-kripalu-maharaj-prem-ras-madira-siddhanta-madhuri-101\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"jagadguru shri kripalu maharaj, prem ras madira, siddhanta madhuri (101)\",\"item\":\"https://path.vrindopnishad.in/saints/jagadguru-shri-kripalu-maharaj-prem-ras-madira-siddhanta-madhuri-101\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"jagadguru shri kripalu maharaj, prem ras madira, siddhanta madhuri (101)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"जगद्गुरु श्री कृपालु  महाराज, प्रेम रस मदिरा, सिद्धान्त  माधुरी (101)","hinglishName":"jagadguru shri kripalu maharaj, prem ras madira, siddhanta madhuri (101)","slug":"jagadguru-shri-kripalu-maharaj-prem-ras-madira-siddhanta-madhuri-101","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-144","title":"श्यामा श्याम शरण गहु रे मन","category":"Shloka","sanskrit_text":"श्यामा श्याम शरण गहु रे मन ।युगल माधुरी ध्यान धरे उर, गाउ नाम गुन रहु वृंदावन ॥सखीभाव संतन अनुगत ह्वै, प्रेम सुधा पिवु लहु जीवनधन ।ह्वै निष्काम धाम-निष्ठा गहि, गहवर वन विचरहु गोवर्धन ॥भरि भरि अंक लतन आनँद जल, झरझर झरि लावहु जनु सावन ।इमि ‘कृपालु’ मदमत रैन दिन, नित नव रस चाखहु मनभावन ॥","hindi_text":"अरे मन ! तू राधा-कृष्ण के चरण-कमलों की शरण में जा, तथा राधा-कृष्ण का स्वरूप अपने हृदय में रखकर उनके विविध नाम गुणादिकों को प्रेम-विभोर होकर गाता हुआ निरन्तर वृन्दावन में ही निवास कर |  [1]\nप्रेम प्राप्त सखी भावयुक्त महापुरुषों की शरण होकर उस दिव्य प्रेमामृत का पान कर, जो तेरे जीवन का सर्वस्व है | निष्काम भाव रखते हुए श्री कृष्णधाम में चिन्मय दृष्टि रखकर गह्वरवन एवं गोवर्धन में घूमते हुए विचरण कर | [2]\nब्रज की लताओं का बार-बार आलिंगन करके नेत्रों से आनन्द के आँसुओं की श्रावण की तरह झड़ी लगाते हुए वर्षा कर | ‘श्री कृपालु जी’ कहते हैं – इस प्रकार तू प्रेम-रस में उन्मत होकर दिन-रात नित्य-प्रति नवीन-नवीन दिव्य रसों का मनमाना आस्वादन कर | [3]","english_text":null,"english_translation":"O my mind! Take shelter of Shri Radha Krishna. Meditate upon the magnificence of the divine couple. Keep singing their names and attributes and thus always dwell in Vrindavan. [1]\nFollow the saints of \"Sakhi-Bhav\" (One who have attained the nectar of divine bliss as a female friend or servant of Radharani) and drink the nectar of love. Thus achieve the real treasure of your life.\nBe selfless, cultivate reverence for the divine abode, ramble around Gahavarban and Goverdhan. [2]\nEmbrace the creepers of Braj , their divine abode and shed tears out of ecstasy of love-bliss as fluently as the heavy rainfall of the rainy season.\nJagadguru Shri Kripalu Ji Maharaj says, thus being intoxicated in love- trance throughout the day and night, taste the sweetness of ever new nectar of love of your choice. [3]","description":"https://www.brajrasik.org/hi/articles/59a44e8d59e8c72a534d85b6/shyama-shyam-sharana-gahu-re-mana-pad-written-by-jagadguru-shri-kripalu-ji-maharaj","author":"जगद्गुरु श्री कृपालु जी महाराज, प्रेम रस मदिरा, सिद्धान्त  माधुरी (101)","status":"published","content_text":"श्यामा श्याम शरण गहु रे मन ।\nयुगल माधुरी ध्यान धरे उर, गाउ नाम गुन रहु वृंदावन ॥\nसखीभाव संतन अनुगत ह्वै, प्रेम सुधा पिवु लहु जीवनधन ।\nह्वै निष्काम धाम-निष्ठा गहि, गहवर वन विचरहु गोवर्धन ॥\nभरि भरि अंक लतन आनँद जल, झरझर झरि लावहु जनु सावन ।\nइमि ‘कृपालु’ मदमत रैन दिन, नित नव रस चाखहु मनभावन ॥\n- जगद्गुरु श्री कृपालु जी महाराज, प्रेम रस मदिरा, सिद्धान्त  माधुरी (101)\nअरे मन ! तू राधा-कृष्ण के चरण-कमलों की शरण में जा, तथा राधा-कृष्ण का स्वरूप अपने हृदय में रखकर उनके विविध नाम गुणादिकों को प्रेम-विभोर होकर गाता हुआ निरन्तर वृन्दावन में ही निवास कर |  [1]\nप्रेम प्राप्त सखी भावयुक्त महापुरुषों की शरण होकर उस दिव्य प्रेमामृत का पान कर, जो तेरे जीवन का सर्वस्व है | निष्काम भाव रखते हुए श्री कृष्णधाम में चिन्मय दृष्टि रखकर गह्वरवन एवं गोवर्धन में घूमते हुए विचरण कर | [2]\nब्रज की लताओं का बार-बार आलिंगन करके नेत्रों से आनन्द के आँसुओं की श्रावण की तरह झड़ी लगाते हुए वर्षा कर | ‘श्री कृपालु जी’ कहते हैं – इस प्रकार तू प्रेम-रस में उन्मत होकर दिन-रात नित्य-प्रति नवीन-नवीन दिव्य रसों का मनमाना आस्वादन कर | [3]","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/59a44e8d59e8c72a534d85b6/shyama-shyam-sharana-gahu-re-mana-pad-written-by-jagadguru-shri-kripalu-ji-maharaj","slug":"shyama-shyam-sharan-gahu-re-mana"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L8",null,{"children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":"404"}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"notFoundStyles":[]}]}]}]}]],null],null],["$L9",null]]]]
