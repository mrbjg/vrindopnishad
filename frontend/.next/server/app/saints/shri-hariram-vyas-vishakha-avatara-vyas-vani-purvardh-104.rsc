0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","shri-hariram-vyas-vishakha-avatara-vyas-vani-purvardh-104","d"],{"children":["__PAGE__?{\"slug\":\"shri-hariram-vyas-vishakha-avatara-vyas-vani-purvardh-104\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","shri-hariram-vyas-vishakha-avatara-vyas-vani-purvardh-104","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी, पूर्वार्ध (104)\",\"alternateName\":\"shri hariram vyas (vishakha avatara) vyas vani, purvardh (104)\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/shri-hariram-vyas-vishakha-avatara-vyas-vani-purvardh-104\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"shri hariram vyas (vishakha avatara) vyas vani, purvardh (104)\",\"item\":\"https://path.vrindopnishad.in/saints/shri-hariram-vyas-vishakha-avatara-vyas-vani-purvardh-104\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri hariram vyas (vishakha avatara) vyas vani, purvardh (104)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी, पूर्वार्ध (104)","hinglishName":"shri hariram vyas (vishakha avatara) vyas vani, purvardh (104)","slug":"shri-hariram-vyas-vishakha-avatara-vyas-vani-purvardh-104","biography":"","metadata":{"lineageEn":"Vaishnav Rasik Tradition (Haritrayi)","lineageHi":"वैष्णव रसिक परंपरा (हरित्रयी)","timelineEn":"1510–1612 AD","timelineHi":"1510–1612 ईस्वी","associatedPlacesEn":"Vyas Ghera, Vrindavan","associatedPlacesHi":"व्यास घेरा, वृंदावन","discipleOfEn":"Shri Madhavdas Bhatta (disciple of Hit Harivansh)","discipleOfHi":"श्री माधवदास भट्ट जी (हित हरिवंश महाप्रभु के शिष्य)","influencedByEn":"Swami Haridas and Shri Hit Harivansh Mahaprabhu (forming the Haritrayi)","influencedByHi":"स्वामी हरिदास एवं श्री हित हरिवंश महाप्रभु (हरित्रयी परंपरा)","associatedSampradayaEn":"Radhavallabh / Haritrayi Tradition","associatedSampradayaHi":"राधावल्लभ / हरित्रयी परंपरा","devotionalMoodEn":"Humility, Raganuga Bhakti, Sakhi Bhava","devotionalMoodHi":"परम विनम्रता, रागानुगा भक्ति, सखी भाव","teachingsEn":"Emphasized pure, unadorned devotion based on absolute humility, rejection of caste pride, and criticism of ritualistic hypocrisy. Believed that only a humble heart can experience the sweet nectar of Vrindavan.","teachingsHi":"जाति-पाति के अभिमान का त्याग, बाह्य कर्मकांडों का विरोध और परम विनम्रता पर आधारित भक्ति। उनका मानना था कि केवल अहंकार रहित हृदय ही वृंदावन रस का अधिकारी है।","literaryStyleEn":"Author of Vyas Vani (व्यास वाणी), written in bold, direct Braj Bhasha. His verses contain both ecstatic descriptions of the Divine Couple and sharp, instructional remarks on behavior and sincerity.","literaryStyleHi":"'Vyas Vani' के रचयिता, जो अपनी स्पष्टवादिता और ठेठ ब्रजभाषा के लिए जानी जाती है। इनके पदों में लीला रस के साथ-साथ साधकों के लिए व्यावहारिक उपदेश भी प्रचुरता में हैं।","biographyEn":"Shri Hariram Vyas, affectionately known as Vyas Ji, was a prominent contemporary of Swami Haridas and Hit Harivansh Mahaprabhu. Together, these three saints are celebrated as the \"Haritrayi\" (spiritual triad) of Vrindavan, who established the foundations of Rasik theology. Born in Orchha, Madhya Pradesh, Hariram Vyas left his high royal position and vast scholarship to live as a humble beggar in the dust of Vrindavan. He established his ashram at Vyas Ghera and worshiped the deity of Jugal Kishor Ji. His writings are famously candid, warning devotees against spiritual vanity and urging them to seek the shelter of true saintly association (Sadhu Sanga).","biographyHi":"श्री हरिराम व्यास (व्यास जी) वृंदावन के ऐतिहासिक त्रिमूर्ति 'हरित्रयी' के तीसरे स्तम्भ थे। वे ओरछा के एक प्रतिष्ठित विद्वान थे, परंतु सब कुछ त्यागकर वृंदावन की धूल में आ बसे। उन्होंने व्यास घेरा में रहकर युगल किशोर जी की सेवा की। व्यास जी अपनी बेबाक और स्पष्ट टिप्पणियों के लिए प्रसिद्ध थे। उन्होंने संतों के प्रति अपराध और वैष्णवों में आपसी भेद का कड़ा विरोध किया और सरल प्रेम मार्ग को ही सर्वोत्तम बताया।","relatedSaints":[{"nameEn":"Swami Haridas","nameHi":"स्वामी हरिदास","slug":"haridas"},{"nameEn":"Shri Hit Harivansh","nameHi":"श्री हित हरिवंश","slug":"hit-harivansh"}],"relatedGranthas":[{"nameEn":"Vyas Vani","nameHi":"व्यास वाणी","slug":"vyas-vani"}],"associatedGlossary":[{"termEn":"Sadhana","termHi":"साधना","slug":"sadhana"},{"termEn":"Saranagati","termHi":"शरणागति","slug":"saranagati"},{"termEn":"Braj Bhasha","termHi":"ब्रजभाषा","slug":"braj-bhasha"}],"faq":[{"qEn":"Where is Vyas Ghera located?","aEn":"Vyas Ghera is located in Vrindavan near the Yamuna river, serving as the historical bhajan site and samadhi of Hariram Vyas Ji.","qHi":"व्यास घेरा कहाँ स्थित है?","aHi":"व्यास घेरा वृंदावन में यमुना नदी के समीप स्थित है, जो हरीराम व्यास जी की भजन स्थली और उनकी समाधि स्थली है।"}]},"imageUrl":null,"verses":[{"id":"local-84","title":"हम कब होहिंगे ब्रजवासी","category":"Shloka","sanskrit_text":"हम कब होहिंगे ब्रजवासी।ठाकुर नंदकिशोर हमारे, ठकुराइनि राधा सी।।कब मिलि हैं वे सखी सहेली, हरिवंशी हरिदासी।वंशीवट की शीतल छहियाँ, सुभग नदी जमुना सी।।जाकी वैभव करत लालसा, कर-मीत कमलासी।इतनी आस व्यास की पुजवहु वृन्दाविपिन विलासी |","hindi_text":"$5","english_text":null,"english_translation":"(Raag Sarang)\nHum Kab Hoinge Brajwasi,\nThakur Yugal Kishor Humare Thakurani Radha Si,\nKab Mili Hain Ve Sakhi Saheli Harivanshi Haridasi,\nBanshivata Ki Sheetal Chahiyan, Subhag Nadi Yamunasi,\nJaaki Vaibhav Karata Lalsa, Kar Meeta Kamla Si,\nItni Aas Vyas Ki Pujvahu, Vrindavipin Vilasi.\n-Shri Hariram Vyas (Vishakha Avtaar) - From Vyas Vani, Purvardh (104)\nWhen will we become true Brajwasis (i.e residents of Braj), since Shri Nand Kishor is our master, and our Queen is one and only Shri Radha rani. When will we meet our dearest sakhi friends like Harivanshi (Hita Sakhi) and Haridasi (Lalita sakhi). When will we dwell in Banshivat, sit under Banshivat shade where nearby charming Yamuna is flowing. The same land which is always desired by Goddess like Maha lakshmi and she is humbly standing to get access to this divine land by holding both the hands pressed together. Shri Hariram Vyas incarnation of Shri Vishakha sakhi says, my only desire is to remain in this land called \"Vrindavan\" and serve it incessantly!","description":"https://www.brajrasik.org/hi/articles/5b0906ff9f7ab760360f9c5f/hum-kab-hohinge-brajwasi-shri-hariram-vyas-vishakha-avtaar-from-vyas-vani","author":"श्री हरिराम व्यास (विशाखा अवतार)  व्यास वाणी, पूर्वार्ध (104)","status":"published","content_text":"$6","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b0906ff9f7ab760360f9c5f/hum-kab-hohinge-brajwasi-shri-hariram-vyas-vishakha-avtaar-from-vyas-vani","slug":"ham-kab-hohinge-brajavasi"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L7",nul