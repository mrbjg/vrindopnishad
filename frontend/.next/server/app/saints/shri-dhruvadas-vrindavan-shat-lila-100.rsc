0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","shri-dhruvadas-vrindavan-shat-lila-100","d"],{"children":["__PAGE__?{\"slug\":\"shri-dhruvadas-vrindavan-shat-lila-100\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","shri-dhruvadas-vrindavan-shat-lila-100","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री ध्रुवदास , वृन्दावन शत लीला (100)\",\"alternateName\":\"shri dhruvadas , vrindavan shat lila (100)\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/shri-dhruvadas-vrindavan-shat-lila-100\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"shri dhruvadas , vrindavan shat lila (100)\",\"item\":\"https://path.vrindopnishad.in/saints/shri-dhruvadas-vrindavan-shat-lila-100\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri dhruvadas , vrindavan shat lila (100)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री ध्रुवदास , वृन्दावन शत लीला (100)","hinglishName":"shri dhruvadas , vrindavan shat lila (100)","slug":"shri-dhruvadas-vrindavan-shat-lila-100","biography":"","metadata":{"lineageEn":"Radhavallabh Sampradaya","lineageHi":"राधावल्लभ संप्रदाय","timelineEn":"17th Century AD","timelineHi":"17वीं शताब्दी","associatedPlacesEn":"Vrindavan","associatedPlacesHi":"वृंदावन","discipleOfEn":"Shri Hit Harilal Ji (disciplic lineage of Shri Hit Harivansh)","discipleOfHi":"श्री हित हरिलाल जी (श्री हित हरिवंश महाप्रभु की शिष्य परंपरा)","influencedByEn":"Shri Hit Harivansh Mahaprabhu","influencedByHi":"श्री हित हरिवंश महाप्रभु","associatedSampradayaEn":"Radhavallabh Sampradaya","associatedSampradayaHi":"राधावल्लभ संप्रदाय","devotionalMoodEn":"Manjari Bhava, Sahachari Bhava","devotionalMoodHi":"मंजरी भाव, सहचरी भाव","teachingsEn":"Detailed categorization of the levels of devotion (Bhakti), descriptions of the beauty of Srimati Radharani, and instructions on how to meditate on the pastimes of the Nikunj.","teachingsHi":"भक्ति के विभिन्न चरणों का वर्गीकरण, श्री राधारानी के नख-शिख सौंदर्य का वर्णन और निकुंज लीलाओं के ध्यान की क्रमिक विधि का प्रतिपादन।","literaryStyleEn":"Author of the monumental Bayalees Leela (बयालीस लीला), written in structured, elegant Braj Bhasha poetry. His style is highly descriptive, analytical, and serving as a study guide for sadhakas.","literaryStyleHi":"महान ग्रंथ 'बयालीस लीला' के रचयिता, जो सरल, सुबोध और शास्त्रीय ब्रजभाषा काव्य में रचित है। उनका लेखन विश्लेषणात्मक है जो साधकों को ध्यान की गहराइयों में ले जाता है।","biographyEn":"Shri Dhruvdas was a stellar saint and one of the most prolific writers in the history of the Radhavallabh Sampradaya. Living in the 17th century, he took it upon himself to systematically record and explain the esoteric teachings of the earlier rasik acharyas. His life was spent in quiet meditation and literary composition in the groves of Vrindavan. His masterpiece, the \"Bayalees Leela\" (Forty-Two Lilas), is a collection of 42 separate tracts covering theological concepts, meditation guidelines, descriptions of Vrindavan forest, and intimate love pastimes of the Divine Couple. His works remain the most accessed manuals for studying the philosophy of Braj Ras.","biographyHi":"श्री ध्रुवदास राधावल्लभ संप्रदाय के सर्वाधिक रचनाकार संतों में से एक हैं। उन्होंने पूर्ववर्ती आचार्यों के सिद्धांतों को साधकों के लिए सुलभ बनाने हेतु 'बयालीस लीला' ग्रंथ की रचना की। ध्रुवदास जी ने शांत स्वभाव से वृंदावन के कुंजों में रहकर केवल लेखन और स्मरण किया। उनके ग्रंथों में भक्ति के सैद्धांतिक पक्ष और निकुंज लीला के व्यावहारिक अनुभव का ऐसा संगम है जो अन्यत्र मिलना दुर्लभ है।","relatedSaints":[{"nameEn":"Shri Hit Harivansh","nameHi":"श्री हित हरिवंश","slug":"hit-harivansh"},{"nameEn":"Shri Premanand Ji Maharaj","nameHi":"श्री प्रेमानंद जी महाराज","slug":"premanand-ji-maharaj"}],"relatedGranthas":[{"nameEn":"Bayalees Leela","nameHi":"बयालीस लीला","slug":"bayalees-leela"}],"associatedGlossary":[{"termEn":"Manjari Bhava","termHi":"मंजरी भाव","slug":"manjari-bhava"},{"termEn":"Lila","termHi":"लीला","slug":"lila"},{"termEn":"Seva","termHi":"सेवा","slug":"seva"}],"faq":[{"qEn":"What is the Bayalees Leela?","aEn":"The Bayalees Leela is a collection of 42 distinct poetic works composed by Dhruvdas Ji, covering everything from Vrindavan glory to details of aesthetic devotion.","qHi":"बयालीस लीला क्या है?","aHi":"'बयालीस लीला' श्री ध्रुवदास जी द्वारा रचित ४२ अलग-अलग लीला-काव्यों का संग्रह है, जिसमें वृंदावन धाम की महिमा से लेकर सखी भाव की साधना का सम्पूर्ण विवेचन है।"}]},"imageUrl":null,"verses":[{"id":"local-132","title":"इत बौना अकाश फल","category":"Shloka","sanskrit_text":"इत बौना अकाश फल, चाहत है मन मांहि।ताकौ एक कृपा बिना, और जतन कछु नाहिं॥","hindi_text":"बौना आदमी यदि आकाश-फल को (वृन्दावन को) प्राप्त करना चाहे तो एक मात्र कृपा के बिना इसका अन्य कोई उपाय नहीं।","english_text":null,"english_translation":"Most insignificant person like me aims at achieving fruits (Vrindavan) higher than the sky, but, I am certain that it cannot be attained without the blessings of Radha-Krishn.","description":"https://www.brajrasik.org/hi/articles/5d9b7695da8fa90060518bda/it-bauna-akaash-phal-shri-dhruvdas-ji-vrindavan-shat-leela-100","author":"श्री ध्रुवदास जी, वृन्दावन शत लीला (100)","status":"published","content_text":"इत बौना अकाश फल, चाहत है मन मांहि।\nताकौ एक कृपा बिना, और जतन कछु नाहिं॥\n- श्री ध्रुवदास जी, वृन्दावन शत लीला (100)\nबौना आदमी यदि आकाश-फल को (वृन्दावन को) प्राप्त करना चाहे तो एक मात्र कृपा के बिना इसका अन्य कोई उपाय नहीं।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5d9b7695da8fa90060518bda/it-bauna-akaash-phal-shri-dhruvdas-ji-vrindavan-shat-leela-100","slug":"it-bauna-akash-fala"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","