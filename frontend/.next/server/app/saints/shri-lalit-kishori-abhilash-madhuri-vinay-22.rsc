0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","shri-lalit-kishori-abhilash-madhuri-vinay-22","d"],{"children":["__PAGE__?{\"slug\":\"shri-lalit-kishori-abhilash-madhuri-vinay-22\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","shri-lalit-kishori-abhilash-madhuri-vinay-22","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री ललित किशोरी, अभिलाष माधुरी, विनय (22)\",\"alternateName\":\"shri lalit kishori, abhilash madhuri, vinay (22)\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/shri-lalit-kishori-abhilash-madhuri-vinay-22\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"shri lalit kishori, abhilash madhuri, vinay (22)\",\"item\":\"https://path.vrindopnishad.in/saints/shri-lalit-kishori-abhilash-madhuri-vinay-22\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri lalit kishori, abhilash madhuri, vinay (22)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री ललित किशोरी, अभिलाष माधुरी, विनय (22)","hinglishName":"shri lalit kishori, abhilash madhuri, vinay (22)","slug":"shri-lalit-kishori-abhilash-madhuri-vinay-22","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-364","title":"श्री वृन्दावन वास दीजिये अब यही हमारी आशा है","category":"Shloka","sanskrit_text":"श्री वृन्दावन वास दीजिये, अब यही हमारी आशा है।यमुना तीर सुछाय माधुरी, जहँ रसिकों का वासा है ॥ [1]सेवाकुञ्ज मनोहर निधि वन, जहाँ इक रस बारो मासा है ।'ललित किशोरी' अब यह दिल बेकल, जुगल रूप रस प्यासा है ॥ [2]","hindi_text":"श्री ललित किशोरी श्री राधा से विनम्र प्रार्थना करती हैं—\nहे राधे! हमें श्रीवृन्दावन का वास प्रदान करें। यही हमारी एकमात्र अभिलाषा है—जहाँ यमुना का सुरम्य तट और रसिकजन का आनंदमय संग है। [1]\nजहाँ सेवाकुञ्ज और मनोहर निधिवन हैं, जहाँ बारहों महीने युगल-रस की अविरल धारा प्रवाहित होती है। ‘ललित किशोरी’ कहती हैं—यह हृदय अब अत्यंत व्याकुल है और श्री युगल के रूप-रस का प्यासा है। [2]","english_text":null,"english_translation":"Śrī Lalita Kiśorī humbly prays to Śrī Rādhā—\nO Śrī Rādhe! Grant me abode in Śrī Vṛndāvana, on Yamunā’s enchanting banks amid rasika saints’ company—this alone my heart’s longing. [1]\nWhere Sevā Kuñja and delightful Nidhivana lie, and yugala rasa flows ceaselessly through all twelve months. Lalita Kiśorī says: My heart grows restless, yearning for Śrī Rādhā Kṛṣṇa’s beauty and nectar. [2]","description":"https://www.brajrasik.org/hi/articles/5a19003559e8c72a534d85db/shri-vrindavan-vaas-dijiye-ab-yehi-humari-asha-hai-pad-by-shri-lalit-kishori","author":"श्री ललित किशोरी, अभिलाष माधुरी, विनय (22)","status":"published","content_text":"(राग जिला)\nश्री वृन्दावन वास दीजिये, अब यही हमारी आशा है।\nयमुना तीर सुछाय माधुरी, जहँ रसिकों का वासा है ॥ [1]\nसेवाकुञ्ज मनोहर निधि वन, जहाँ इक रस बारो मासा है ।\n'ललित किशोरी' अब यह दिल बेकल, जुगल रूप रस प्यासा है ॥ [2]\n- श्री ललित किशोरी, अभिलाष माधुरी, विनय (22)\nश्री ललित किशोरी श्री राधा से विनम्र प्रार्थना करती हैं—\nहे राधे! हमें श्रीवृन्दावन का वास प्रदान करें। यही हमारी एकमात्र अभिलाषा है—जहाँ यमुना का सुरम्य तट और रसिकजन का आनंदमय संग है। [1]\nजहाँ सेवाकुञ्ज और मनोहर निधिवन हैं, जहाँ बारहों महीने युगल-रस की अविरल धारा प्रवाहित होती है। ‘ललित किशोरी’ कहती हैं—यह हृदय अब अत्यंत व्याकुल है और श्री युगल के रूप-रस का प्यासा है। [2]","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5a19003559e8c72a534d85db/shri-vrindavan-vaas-dijiye-ab-yehi-humari-asha-hai-pad-by-shri-lalit-kishori","slug":"shri-vrindavan-vas-dijiye-ab-yahi-hamari-asha-hai"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L8",null,{"children":["$","$L5",null,{"parallelRouterKey":"children",