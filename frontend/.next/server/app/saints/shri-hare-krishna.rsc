0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","shri-hare-krishna","d"],{"children":["__PAGE__?{\"slug\":\"shri-hare-krishna\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","shri-hare-krishna","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री हरे कृष्ण\",\"alternateName\":\"shri hare krishna\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/shri-hare-krishna\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"shri hare krishna\",\"item\":\"https://path.vrindopnishad.in/saints/shri-hare-krishna\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri hare krishna"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री हरे कृष्ण","hinglishName":"shri hare krishna","slug":"shri-hare-krishna","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-356","title":"रस रूप मयी रस की सरिता","category":"Shloka","sanskrit_text":"रस रूप मयी रस की सरिता, सुख रूप सदा सुख कंदनी के। [1]वसुधा की सुधा वृज की सुषमा, वृषभानु सुता जग बंदनी के॥ [2]जल मीनन मान विभंजनी के, मृग खंजन नैन निकंदनी के। [3]जिनको जग बंदन देखो वही, पग बन्दत कीरति नन्दिनी के॥ [4]","hindi_text":"श्रीराधा रस का मूर्त स्वरूप हैं, रस की सरिता हैं, और सदा सुख की मूल स्रोत हैं। [1]\nवे पृथ्वी में अमृत बरसाने वाली ब्रज की शोभा हैं, वृषभानु की पुत्री और सम्पूर्ण जगत की वंदनीय हैं। [2]\nउनकी चंचल दृष्टि मीन के गर्व को तोड़ देती है और उनकी नेत्र-भंगिमा मृग और खंजन की चपलता को मात कर देती है। [3]\nजिनको समस्त संसार वंदन करता है, वे भगवान श्रीकृष्ण, श्रीराधा के चरणों में वंदन करते हैं। [4]","english_text":null,"english_translation":"Śrī Rādhā is the embodiment of rasa, the flowing river of rasa, and ever the very source of bliss. [1]\nShe is the splendour of Vraj that pours nectar upon the earth, the daughter of Vṛṣabhānu, and revered by the entire universe. [2]\nHer playful gaze shatters the pride of the fish, and the expression of her eyes surpasses the swiftness of deer and khanjan birds. [3]\nThe One worshipped by the entire world, Lord Śrī Kṛṣṇa Himself, bows at Śrī Rādhā’s lotus feet. [4]","description":"https://www.brajrasik.org/hi/articles/5da3a0581276e7006036cff8/ras-roop-mayi-ras-ki-sarita-braj-rasik","author":"श्री हरे कृष्ण जी","status":"published","content_text":"(सवैया)\nरस रूप मयी रस की सरिता, सुख रूप सदा सुख कंदनी के। [1]\nवसुधा की सुधा वृज की सुषमा, वृषभानु सुता जग बंदनी के॥ [2]\nजल मीनन मान विभंजनी के, मृग खंजन नैन निकंदनी के। [3]\nजिनको जग बंदन देखो वही, पग बन्दत कीरति नन्दिनी के॥ [4]\n- श्री हरे कृष्ण जी\nश्रीराधा रस का मूर्त स्वरूप हैं, रस की सरिता हैं, और सदा सुख की मूल स्रोत हैं। [1]\nवे पृथ्वी में अमृत बरसाने वाली ब्रज की शोभा हैं, वृषभानु की पुत्री और सम्पूर्ण जगत की वंदनीय हैं। [2]\nउनकी चंचल दृष्टि मीन के गर्व को तोड़ देती है और उनकी नेत्र-भंगिमा मृग और खंजन की चपलता को मात कर देती है। [3]\nजिनको समस्त संसार वंदन करता है, वे भगवान श्रीकृष्ण, श्रीराधा के चरणों में वंदन करते हैं। [4]","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5da3a0581276e7006036cff8/ras-roop-mayi-ras-ki-sarita-braj-rasik","slug":"ras-rup-mayi-ras-ki-sarita"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L8",null,{"children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color 