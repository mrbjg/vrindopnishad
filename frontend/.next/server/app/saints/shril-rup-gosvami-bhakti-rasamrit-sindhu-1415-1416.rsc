text-white/80 font-medium truncate","children":"shril rup gosvami, bhakti rasamrit sindhu (1.4.15 1.4.16)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्रील रूप गोस्वामी,  भक्ति रसामृत सिंधु  (1.4.15 1.4.16)","hinglishName":"shril rup gosvami, bhakti rasamrit sindhu (1.4.15 1.4.16)","slug":"shril-rup-gosvami-bhakti-rasamrit-sindhu-1415-1416","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-89","title":"भक्ति के क्रमिक विकास का वर्णन","category":"Shloka","sanskrit_text":"आदौ श्रद्धा ततः साधुसंगोऽथ भजनक्रिया। ततोऽनर्थनिवृत्तिः स्यात्तत्तो निष्ठा रुचिस्ततः।।अथासक्तिस्ततो भावस्ततः प्रेमाऽभ्युदञ्चति। साधकानामयं प्रेम्णः प्रादुर्भावे भवेत् क्रमः।।","hindi_text":"भक्तिरसामृत सिन्धु में श्रील रूपगोस्वामी, भक्ति के क्रमिक विकास का वर्णन करते हुए कहते हैं कि:-\nआदौ श्रद्धा ततः साधुसंगोऽथ भजनक्रिया। ततोऽनर्थनिवृत्तिः स्यात्तत्तो निष्ठा रुचिस्ततः।।\nअथासक्तिस्ततो भावस्ततः प्रेमाऽभ्युदञ्चति। साधकानामयं प्रेम्णः प्रादुर्भावे भवेत् क्रमः।।\n- श्रील रूप गोस्वामी,  भक्ति रसामृत सिंधु  (1.4.15- 1.4.16)\nअर्थातः- सर्वप्रथम श्रद्धा अर्थात शास्त्र वचनों में विश्वास होता है, उसके बाद साधु-संग होता है, फिर भजन क्रिया प्रारम्भ होती है, भजन क्रिया के बाद अनर्थ-निवृति, फिर निष्ठा, फिर रूचि, तदनन्तर आसक्ति और फिर भाव का उदय होता है । उसके बाद प्रेम प्राप्त होता है रसिक गुरु की शरण में रहकर, तदनन्तर जीव कृत कृत हो जाता है, एवं श्री भगवान् के धाम पहुँचता है।","english_text":null,"english_translation":"$5","description":"https://www.brajrasik.org/hi/articles/599dd92159e8c72a534d85b4/the-nine-stages-of-bhakti-yoga-bhakti-rasamrit-sindhu-by-shri-roop-goswami","author":"श्रील रूप गोस्वामी,  भक्ति रसामृत सिंधु  (1.4.15 1.4.16)","status":"published","content_text":"भक्तिरसामृत सिन्धु में श्रील रूपगोस्वामी, भक्ति के क्रमिक विकास का वर्णन करते हुए कहते हैं कि:-\nआदौ श्रद्धा ततः साधुसंगोऽथ भजनक्रिया। ततोऽनर्थनिवृत्तिः स्यात्तत्तो निष्ठा रुचिस्ततः।।\nअथासक्तिस्ततो भावस्ततः प्रेमाऽभ्युदञ्चति। साधकानामयं प्रेम्णः प्रादुर्भावे भवेत् क्रमः।।\n- श्रील रूप गोस्वामी,  भक्ति रसामृत सिंधु  (1.4.15- 1.4.16)\nअर्थातः- सर्वप्रथम श्रद्धा अर्थात शास्त्र वचनों में विश्वास होता है, उसके बाद साधु-संग होता है, फिर भजन क्रिया प्रारम्भ होती है, भजन क्रिया के बाद अनर्थ-निवृति, फिर निष्ठा, फिर रूचि, तदनन्तर आसक्ति और फिर भाव का उदय होता है । उसके बाद प्रेम प्राप्त होता है रसिक गुरु की शरण में रहकर, तदनन्तर जीव कृत कृत हो जाता है, एवं श्री भगवान् के धाम पहुँचता है।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/599dd92159e8c72a534d85b4/the-nine-stages-of-bhakti-yoga-bhakti-rasamrit-sindhu-by-shri-roop-goswami","slug":"bhakti-ke-kramik-vikas-ka-varnana"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L6",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$7","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L8",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L6",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L8",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L9",null,{"children":["$","$L6",null,{"parallelRouterKey":"ch