0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","shri-bhori-sakhi-prem-ki-pir-45","d"],{"children":["__PAGE__?{\"slug\":\"shri-bhori-sakhi-prem-ki-pir-45\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","shri-bhori-sakhi-prem-ki-pir-45","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"श्री भोरी सखी, प्रेम की पीर (45)\",\"alternateName\":\"shri bhori sakhi, prem ki pir (45)\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/shri-bhori-sakhi-prem-ki-pir-45\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"shri bhori sakhi, prem ki pir (45)\",\"item\":\"https://path.vrindopnishad.in/saints/shri-bhori-sakhi-prem-ki-pir-45\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"shri bhori sakhi, prem ki pir (45)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"श्री भोरी सखी, प्रेम की पीर (45)","hinglishName":"shri bhori sakhi, prem ki pir (45)","slug":"shri-bhori-sakhi-prem-ki-pir-45","biography":"","metadata":null,"imageUrl":null,"verses":[{"id":"local-320","title":"कब मेरी सुधि करि हौ वृषभानु लड़ैती राधा","category":"Shloka","sanskrit_text":"कब मेरी सुधि करि हौ वृषभानु लड़ैती राधा। [1]कोमल चित्त किशोरी प्यारी, करुणा सिंधु अगाधा॥ [2]अधम उधारणि पतित पावनी, हरन सकल भव बाधा। [3]धर्म कर्म तजि कोटि पाप किय, साधन कछू न साधा॥ [4]टेर सुनत ऐसेहु पतितन की, विरमत नहिं पल आधा। [5]भोरी अब सब भाँति भरोसौ, चरण कमल सौं बांधा॥ [6]","hindi_text":"हे वृषभानु लाडिली श्री राधा, आप कब मेरा स्मरण करोगी? [1]\nआप सरल-हृदया हो और अकारण दया की अथाह सागर हो। [2]\nआप पतित जीवों को पावन करने वाली एवं उनका उद्धार करने वाली हो। कृपया मेरी उन सभी बाधाओं को दूर कर दीजिये जो मुझे आपकी कृपा पाने में बाधा है। [3]\nमैंने सभी प्रकार के धर्म (वैदिक अनुष्ठान), कर्म को त्याग दिया है और अनन्त पाप किए हैं। मैं संपूर्ण साधनों से रहित हूँ। [4]\nआप तो पतित जीवों की पुकार सुनकर तत्क्षण उनके कष्ट को दूर करने उपस्थित हो जाती हो। [5]\nश्री भोरी सखी कहती हैं कि \"हे राधा! मुझे आपके सिवा किसी और पर भरोसा नहीं है, इसलिए मैंने अपना पूरा विश्वास आपके चरण कमलों से बांध दिया है।\" [6]","english_text":null,"english_translation":null,"description":"https://www.brajrasik.org/hi/articles/5db1b89a8d4cd60060465022/kab-meri-sudhi-kari-hau-vrishbhaanu-ladaiti-radha-shri-bhori-sakhi-prem-ki-peer-45","author":"श्री भोरी सखी, प्रेम की पीर (45)","status":"published","content_text":"कब मेरी सुधि करि हौ वृषभानु लड़ैती राधा। [1]\nकोमल चित्त किशोरी प्यारी, करुणा सिंधु अगाधा॥ [2]\nअधम उधारणि पतित पावनी, हरन सकल भव बाधा। [3]\nधर्म कर्म तजि कोटि पाप किय, साधन कछू न साधा॥ [4]\nटेर सुनत ऐसेहु पतितन की, विरमत नहिं पल आधा। [5]\nभोरी अब सब भाँति भरोसौ, चरण कमल सौं बांधा॥ [6]\n- श्री भोरी सखी, प्रेम की पीर (45)\nहे वृषभानु लाडिली श्री राधा, आप कब मेरा स्मरण करोगी? [1]\nआप सरल-हृदया हो और अकारण दया की अथाह सागर हो। [2]\nआप पतित जीवों को पावन करने वाली एवं उनका उद्धार करने वाली हो। कृपया मेरी उन सभी बाधाओं को दूर कर दीजिये जो मुझे आपकी कृपा पाने में बाधा है। [3]\nमैंने सभी प्रकार के धर्म (वैदिक अनुष्ठान), कर्म को त्याग दिया है और अनन्त पाप किए हैं। मैं संपूर्ण साधनों से रहित हूँ। [4]\nआप तो पतित जीवों की पुकार सुनकर तत्क्षण उनके कष्ट को दूर करने उपस्थित हो जाती हो। [5]\nश्री भोरी सखी कहती हैं कि \"हे राधा! मुझे आपके सिवा किसी और पर भरोसा नहीं है, इसलिए मैंने अपना पूरा विश्वास आपके चरण कमलों से बांध दिया है।\" [6]","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5db1b89a8d4cd60060465022/kab-meri-sudhi-kari-hau-vrishbhaanu-ladaiti-radha-shri-bhori-sakhi-prem-ki-peer-45","slug":"kab-meri-sudhi-kari-hau-vrishabhanu-ladaiti-radha"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L8",null,{"children":["