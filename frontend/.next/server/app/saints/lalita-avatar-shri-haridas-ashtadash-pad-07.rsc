0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["saints",{"children":[["slug","lalita-avatar-shri-haridas-ashtadash-pad-07","d"],{"children":["__PAGE__?{\"slug\":\"lalita-avatar-shri-haridas-ashtadash-pad-07\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["saints",{"children":[["slug","lalita-avatar-shri-haridas-ashtadash-pad-07","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"ललिता अवतार श्री हरिदास , अष्टादश पद (07)\",\"alternateName\":\"lalita avatar shri haridas , ashtadash pad (07)\",\"description\":\"Vaishnava saint of the Braj tradition.\",\"url\":\"https://path.vrindopnishad.in/saints/lalita-avatar-shri-haridas-ashtadash-pad-07\",\"knowsAbout\":[\"Vaishnavism\",\"Bhakti Yoga\",\"Braj Rasik Heritage\",\"Vrindavan\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Saints\",\"item\":\"https://path.vrindopnishad.in/saints\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"lalita avatar shri haridas , ashtadash pad (07)\",\"item\":\"https://path.vrindopnishad.in/saints/lalita-avatar-shri-haridas-ashtadash-pad-07\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/saints","className":"hover:text-amber-400 transition-colors","children":"Saints"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"lalita avatar shri haridas , ashtadash pad (07)"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialSaint":{"name":"ललिता अवतार श्री हरिदास , अष्टादश पद (07)","hinglishName":"lalita avatar shri haridas , ashtadash pad (07)","slug":"lalita-avatar-shri-haridas-ashtadash-pad-07","biography":"","metadata":{"lineageEn":"Haridasi Sampradaya (Sakhi Sampradaya)","lineageHi":"हरिदासी संप्रदाय (सखी संप्रदाय)","timelineEn":"1478–1573 AD (Vikram Samvat 1535 - 1630)","timelineHi":"1478–1573 ईस्वी (विक्रम संवत 1535 - 1630)","associatedPlacesEn":"Nidhivan, Vrindavan","associatedPlacesHi":"निधिवन, वृंदावन","discipleOfEn":"Shri Ashudhir Dev Ji (his father and guru)","discipleOfHi":"श्री आशुधीर देव जी (पिता एवं गुरु)","influencedByEn":"Nimbarka Sampradaya philosophy","influencedByHi":"निम्बार्क संप्रदाय सिद्धांत","associatedSampradayaEn":"Haridasi Sampradaya (Sakhi Sampradaya)","associatedSampradayaHi":"हरिदासी संप्रदाय (सखी संप्रदाय)","devotionalMoodEn":"Nitya Vihar, Sakhi Bhava (Lalita Sakhi incarnate)","devotionalMoodHi":"नित्य विहार, सखी भाव (ललिता सखी अवतार)","teachingsEn":"Worship of the Divine Couple in the mood of Lalita Sakhi; focused purely on the eternal love-play (Nitya Vihar) in the secluded bowers (Nikunj) of Vrindavan, entirely devoid of majesty (aishwarya) or physical separation (viraha).","teachingsHi":"ललिता सखी के भाव में युगल उपासना; वृंदावन के निकुंजों में होने वाले अखंड नित्य विहार रस पर पूर्ण ध्यान, जिसमें ऐश्वर्य भाव या वियोग का कोई स्थान नहीं है।","literaryStyleEn":"Composed Kelimal (केलिमाल) and Siddhanta Pada (सिद्धान्त के पद) in sweet Braj Bhasha, characterized by deep musicality, classical raag notations, and intimate description of the Divine Couple's pastimes.","literaryStyleHi":"मधुर ब्रजभाषा में 'केलिमाल' और 'सिद्धान्त के पद' की रचना की, जो राग-रागिनियों की शास्त्रीय विधा और निकुंज लीलाओं के सूक्ष्म चित्रण से परिपूर्ण हैं।","biographyEn":"Swami Haridas was a spiritual master, classical music pioneer, and the founding acharya of the Haridasi Sampradaya. He is widely revered as the direct incarnation of Lalita Sakhi, the chief confidante of Srimati Radharani. Swami Haridas performed his intense bhajan in the sacred grove of Nidhivan in Vrindavan. His musical devotion was so deep and pure that the Divine Couple, Shri Radha and Krishna, appeared before him and manifested themselves in a single, combined deity form—Sri Bankey Bihari Ji. Swami Haridas taught that the ultimate spiritual destination is not cosmic liberation or majestic worship, but witnessing the confidential loving service of the Divine Couple in the eternal groves of Braj.","biographyHi":"स्वामी हरिदास वृंदावन के रसिक शिरोमणि संत और भारतीय शास्त्रीय संगीत के महान आचार्य थे। उन्हें श्री राधा जी की प्रधान सखी श्री ललिता जी का साक्षात् अवतार माना जाता है। उन्होंने वृंदावन के निधिवन को अपनी साधना स्थली बनाया, जहाँ उनके संगीत अनुराग से खिंचकर युगल सरकार ने बांके बिहारी जी के रूप में प्रकट होकर दर्शन दिए। तानसेन और बैजू बावरा जैसे संगीत सम्राट इनके शिष्य थे। स्वामी जी ने सिद्ध किया कि भक्ति शुष्क तपस्या नहीं, बल्कि राग-रागिनियों के माध्यम से प्रभु चरणों में पूर्ण आत्मसमर्पण है।","relatedSaints":[{"nameEn":"Shri Hit Harivansh","nameHi":"श्री हित हरिवंश","slug":"hit-harivansh"},{"nameEn":"Shri Hariram Vyas","nameHi":"श्री हरिराम व्यास","slug":"hariram-vyas"}],"relatedGranthas":[{"nameEn":"Kelimal","nameHi":"केलिमाल","slug":"kelimal"},{"nameEn":"Siddhanta Pada","nameHi":"सिद्धान्त के पद","slug":"siddhanta-pada"}],"associatedGlossary":[{"termEn":"Nitya Vihar","termHi":"नित्य विहार","slug":"nitya-vihar"},{"termEn":"Nikunj","termHi":"निकुंज","slug":"nikunj"},{"termEn":"Sakhi Bhava","termHi":"सखी भाव","slug":"sakhi-bhava"}],"faq":[{"qEn":"Who was Swami Haridas?","aEn":"Swami Haridas was a 16th-century rasik saint, musicologist, and founder of the Haridasi Sampradaya, renowned for manifesting the Bankey Bihari deity through his music in Nidhivan.","qHi":"स्वामी हरिदास कौन थे?","aHi":"स्वामी हरिदास 16वीं शताब्दी के एक महान रसिक संत, संगीतकार और हरिदासी संप्रदाय के प्रवर्तक थे, जिन्होंने अपने संगीत साधना से निधिवन में ठाकुर बांके बिहारी जी को प्रकट किया था।"},{"qEn":"Who were the famous disciples of Swami Haridas?","aEn":"The legendary musicians Tansen (the royal singer of Akbar's court) and Baiju Bawra were disciples of Swami Haridas.","qHi":"स्वामी हरिदास के प्रसिद्ध शिष्य कौन थे?","aHi":"अकबर के दरबार के नवरत्नों में से एक संगीत सम्राट तानसेन और बैजू बावरा स्वामी हरिदास जी के प्रमुख शिष्य थे।"}]},"imageUrl":null,"verses":[{"id":"local-307","title":"हित तौ कीजै कमलनैन सौं","category":"Shloka","sanskrit_text":"हित तौ कीजै कमलनैन सौं, जा हित के आगैं और हित लागै फ़ीकौ |कै हित कीजै साधु-संगति सौं, ज्यौं कलमष जाय सब जी कौ | |","hindi_text":"कमल के समान नेत्र हैं जिनके, ऐसे कमल नयन श्री बिहारीजी से ही हित -प्रेम करना चाहिए क्यूंकि उसके आगे सांसारिक एवं मोक्ष तक की कामना तुच्छ लगती है या साधु संतों की संगती से प्रेम करना चाहिए जिससे हृदय के समस्त कल्मष (अशुभ वासनाएं) सब प्रकार से नष्ट होती हैं।","english_text":null,"english_translation":"One should exclusively love Shri Bihariji whose eyes resemble that of a lotus petal, as all kinds of material pleasures, even salvation etc appear worthless in comparison to it. Or one should love the association of saints, due to which all kinds of inauspicious desires are destroyed.","description":"https://www.brajrasik.org/hi/articles/5b96b71f5a23dd00503fc877/hita-to-kije-kamalnain-son-lalita-avtar-shri-haridas-astadasha-pada-07","author":"ललिता अवतार श्री हरिदास जी, अष्टादश पद (07)","status":"published","content_text":"हित तौ कीजै कमलनैन सौं, जा हित के आगैं और हित लागै फ़ीकौ |\nकै हित कीजै साधु-संगति सौं, ज्यौं कलमष जाय सब जी कौ | |\n- ललिता अवतार श्री हरिदास जी, अष्टादश पद (07)\nकमल के समान नेत्र हैं जिनके, ऐसे कमल नयन श्री बिहारीजी से ही हित -प्रेम करना चाहिए क्यूंकि उसके आगे सांसारिक एवं मोक्ष तक की कामना तुच्छ लगती है या साधु संतों की संगती से प्रेम करना चाहिए जिससे हृदय के समस्त कल्मष (अशुभ वासनाएं) सब प्रकार से नष्ट होती हैं।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b96b71f5a23dd00503fc877/hita-to-kije-kamalnain-son-lalita-avtar-shri-haridas-astadasha-pada-07","slug":"hit-tau-kijai-kamalanain-saun"}],"books":[],"rawItem":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","saints","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L8",null,{"children":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexD