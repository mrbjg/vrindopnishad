f:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"राधेजू मेरौ जनम सुधारौ | Vrindopnishad"}],["$","meta","3",{"name":"description","content":"हे श्री राधाजू, मुझे वृंदावन वास प्रदान कर मेरे जीवन को सफल बना दीजिए। [1]\nमैं महापतित और समस्त अवगुणों की खान हूँ, परंतु यह जानकर आप मेरा त्याग न कीजिए। [..."}],["$","link","4",{"rel":"canonical","href":"https://path.vrindopnishad.in/content/radheju-merau-janam-sudharau"}],["$","meta","5",{"property":"og:title","content":"राधेजू मेरौ जनम सुधारौ | Vrindopnishad"}],["$","meta","6",{"property":"og:description","content":"हे श्री राधाजू, मुझे वृंदावन वास प्रदान कर मेरे जीवन को सफल बना दीजिए। [1]\nमैं महापतित और समस्त अवगुणों की खान हूँ, परंतु यह जानकर आप मेरा त्याग न कीजिए। [..."}],["$","meta","7",{"property":"og:url","content":"https://path.vrindopnishad.in/content/radheju-merau-janam-sudharau"}],["$","meta","8",{"property":"og:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}],["$","meta","9",{"property":"og:image:width","content":"800"}],["$","meta","10",{"property":"og:image:height","content":"600"}],["$","meta","11",{"property":"og:image:alt","content":"राधेजू मेरौ जनम सुधारौ"}],["$","meta","12",{"property":"og:type","content":"article"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"राधेजू मेरौ जनम सुधारौ | Vrindopnishad"}],["$","meta","15",{"name":"twitter:description","content":"हे श्री राधाजू, मुझे वृंदावन वास प्रदान कर मेरे जीवन को सफल बना दीजिए। [1]\nमैं महापतित और समस्त अवगुणों की खान हूँ, परंतु यह जानकर आप मेरा त्याग न कीजिए। [..."}],["$","meta","16",{"name":"twitter:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}]]
