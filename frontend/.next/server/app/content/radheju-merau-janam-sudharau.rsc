0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["content",{"children":[["slug","radheju-merau-janam-sudharau","d"],{"children":["__PAGE__?{\"slug\":\"radheju-merau-janam-sudharau\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["content",{"children":[["slug","radheju-merau-janam-sudharau","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Library\",\"item\":\"https://path.vrindopnishad.in/content\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"राधेजू मेरौ जनम सुधारौ\",\"item\":\"https://path.vrindopnishad.in/content/radheju-merau-janam-sudharau\"}]}"}}],["$","div",null,{"className":"max-w-6xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L3",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],[["$","$L3",null,{"href":"/content","className":"hover:text-amber-400 transition-colors","children":"Library"}],["$","span",null,{"children":"→"}]],["$","span",null,{"className":"text-white/80 font-medium truncate max-w-[200px]","children":"राधेजू मेरौ जनम सुधारौ"}]]}],["$","$L4",null,{"children":["$","$L5",null,{"initialContent":{"id":"local-57","title":"राधेजू मेरौ जनम सुधारौ","category":"Shloka","sanskrit_text":"राधेजू मेरौ जनम सुधारौ।अब मोंहि वृन्दावन में डारौ॥ [1]महा-अपावन खान औगुन की,ऐसी जान न बिसारौ। [2]निरबल दीन जान अपनावौ,ये ही बिरद संभारौ॥ [3]जनम - जनम घर जाई चेरी,अब कहा देत हो टारौ। [4]'गोविंदसरन' मोस्युँ कृपा कीज्यौ,गहौ क्यों न हाथ हमारौ॥ [5]","hindi_text":"हे श्री राधाजू, मुझे वृंदावन वास प्रदान कर मेरे जीवन को सफल बना दीजिए। [1]\nमैं महापतित और समस्त अवगुणों की खान हूँ, परंतु यह जानकर आप मेरा त्याग न कीजिए। [2]\nमेरे समान निर्बल और दीन कौन होगा, मुझे असहाय जानकर अपना लीजिए। आपके सिवा संसार में मेरा कोई नहीं है, मेरी यह प्रार्थना स्वीकार कर लीजिए। [3]\nअनन्त जन्मों से संसार के बंधन में भटक रहा हूँ, हे स्वामिनीजू, अब आप क्यों देरी कर रही हैं? [4]\nश्री गोविंद शरण जी कह रहे हैं, \"हे श्री राधाजू, मेरा हाथ पकड़ कर संसार से उबार कर मुझे अपनी शरण क्यों नहीं दे रही हो?\" [5]","english_text":null,"english_translation":"Oh Shri Radhey! Please put an end to my miserable plight. Please give me residence at your lotus feet at Vrindavan anyhow.\nAlthough I am the greatest sinner and a mine of sinfulness, yet please don't forget me, considering my bad qualities.\nOh Kishori Ji! accept me as your very own, as I am devoid of all means and absolutely destitute. You, on the other hand, are the unfathomable ocean of love and causeless mercy. Please think about your greatness!\nI am wandering aimlessly in this material world from uncountable lives, and waiting unceasingly for Your blissful sight, please don't delay it further.\nShri Govind Sharan says, \"Oh dear Kishori Ji, why don't you bless me with your grace and hold my hand forever.\"","description":"https://www.brajrasik.org/hi/articles/5d924fb489c4660060055e02/radheju-merau-janam-sudharau-shri-govindsharan-devachary-ji-shri-govindsharan-devachary-ji-ki-vani","author":"श्री गोविन्दशरण देवाचार्य जी, श्री गोविन्दशरण देवाचार्य जी की वाणी (69)","status":"published","content_text":"राधेजू मेरौ जनम सुधारौ।\nअब मोंहि वृन्दावन में डारौ॥ [1]\nमहा-अपावन खान औगुन की,\nऐसी जान न बिसारौ। [2]\nनिरबल दीन जान अपनावौ,\nये ही बिरद संभारौ॥ [3]\nजनम - जनम घर जाई चेरी,\nअब कहा देत हो टारौ। [4]\n'गोविंदसरन' मोस्युँ कृपा कीज्यौ,\nगहौ क्यों न हाथ हमारौ॥ [5]\n- श्री गोविन्दशरण देवाचार्य जी, श्री गोविन्दशरण देवाचार्य जी की वाणी (69)\nहे श्री राधाजू, मुझे वृंदावन वास प्रदान कर मेरे जीवन को सफल बना दीजिए। [1]\nमैं महापतित और समस्त अवगुणों की खान हूँ, परंतु यह जानकर आप मेरा त्याग न कीजिए। [2]\nमेरे समान निर्बल और दीन कौन होगा, मुझे असहाय जानकर अपना लीजिए। आपके सिवा संसार में मेरा कोई नहीं है, मेरी यह प्रार्थना स्वीकार कर लीजिए। [3]\nअनन्त जन्मों से संसार के बंधन में भटक रहा हूँ, हे स्वामिनीजू, अब आप क्यों देरी कर रही हैं? [4]\nश्री गोविंद शरण जी कह रहे हैं, \"हे श्री राधाजू, मेरा हाथ पकड़ कर संसार से उबार कर मुझे अपनी शरण क्यों नहीं दे रही हो?\" [5]","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5d924fb489c4660060055e02/radheju-merau-janam-sudharau-shri-govindsharan-devachary-ji-shri-govindsharan-devachary-ji-ki-vani","slug":"radheju-merau-janam-sudharau"},"initialRelatedSaint":{"name":"श्री गोविन्दशरण देवाचार्य , श्री गोविन्दशरण देवाचार्य  (69)","hinglishName":"shri govindasharan devachary , shri govindasharan devachary (69)","slug":"shri-govindasharan-devachary-shri-govindasharan-devachary-69","biography":"","metadata":null,"imageUrl":null,"verses":["$6"],"books":[],"rawItem":null},"initialRelatedBook":null,"initialRelatedRaga":null,"initialRelatedVerses":[{"id":"local-0","title":"बनी श्रीराधा मोहन की जोरी","category":"Shloka","sanskrit_text":"बनी श्रीराधा मोहन की जोरी।इंद्र नील मनि स्याम मनोहर, सात कुंभ तनु गोरी।।भाल बिसाल तिलक हरि, कामिनि चिकुर चंद्र बिच रोरी।गज नाइक प्रभु चाल, गयंदनि गति वृषभानु किसोरी।।नील निचोल जुवति, मोहन पट पीत अरुन सिर खोरी।(जै श्री) हित हरिवंश रसिक राधा पति, सुरत रंग में बोरी।।","hindi_text":"भावार्थ-अति अनुपम जोड़ी है श्री राधा मोहन की। मनोहर श्याम सुन्दर इन्द्र नील मणि की भाँति हैं। तो वृषभानु किशोरी श्रीराधा काञ्चन तनु हैं।लाल के विशाल भाल पर तिलक शोभित है, तो कामिनि प्रिया की केश चन्द्रिका के मध्य (माँग) में रोरी लसित है। मोहन लाल की गति (चाल) मत्त गजराज जैसी मोहक और श्रीवृषभानु नन्दिनी की मत्त करिणी जैसी मद मथर है।नव तरुणि श्रीराधा के श्रीअंग में नीलाम्बर शोभित हैं और श्याम सुन्दर के श्यामाङ्ग पर पीत कौशेय धारण है। उपरोक्त नख शिख शृङ्गार की पूर्णता शिरोभाग पर लसित अरुण खोरी (छोर) कर रहा है। श्रीहित हरिवंश कहते हैं यह जोड़ी सौन्दर्थ्य एवं रस की सीमा है। राधापति श्रीकृष्ण रसिक चूडामणि हैं और श्रीराधा सूरत रस सिन्धु रूपा हैं जो रसिकों को नित्य रस देती हैं ।","english_text":null,"english_translation":"The divine couple, Shri Radha Krishn is all attractive and unique. All attractive Shri Shyam Sundar is effulgent like a blue sapphire and the daughter of Shri Vrishbhanu, Shri Radha is golden complexioned. The divine forehead of Shri Krishn is glorified with distinctive Tilak mark (his forehead is adorned by the mark of bright saffron), whereas beloved Radha rani has charming vermillion in her parting line of head. The walking style of Shri Krishn is most similar to that of the elephant, which is so captivating and Shri Radharani’s extraordinary style of walking is similar to that of an intoxicated elephant as well. Shri Radha wears attractive blue garments and Shri Krishn wears attractive yellow garments. Shri Hit Harivansh Mahaprabhu says, the beauty and bliss of this divine couple is limitless. Shri Krishn, the beloved one of Radha, is actually the crest jewel of all Rasiks and Shri Radha is never ending ocean of the blissful divine beauty who provides ceaseless bliss to the Rasiks.","description":"https://www.brajrasik.org/hi/articles/5b0d865c9f7ab760360f9c70/bani-shri-radha-mohan-ki-jori-shri-hita-harivansh-mahaprabhu-from-hit-chaturasi-09","author":"श्री हित हरिवंश , हित चतुरासी (09)","status":"published","content_text":"(राग बिलावल)\nबनी श्रीराधा मोहन की जोरी।\nइंद्र नील मनि स्याम मनोहर, सात कुंभ तनु गोरी।।\nभाल बिसाल तिलक हरि, कामिनि चिकुर चंद्र बिच रोरी।\nगज नाइक प्रभु चाल, गयंदनि गति वृषभानु किसोरी।।\nनील निचोल जुवति, मोहन पट पीत अरुन सिर खोरी।\n(जै श्री) हित हरिवंश रसिक राधा पति, सुरत रंग में बोरी।।\nश्री हित हरिवंश , हित चतुरासी (09)\nभावार्थ-अति अनुपम जोड़ी है श्री राधा मोहन की। मनोहर श्याम सुन्दर इन्द्र नील मणि की भाँति हैं। तो वृषभानु किशोरी श्रीराधा काञ्चन तनु हैं।लाल के विशाल भाल पर तिलक शोभित है, तो कामिनि प्रिया की केश चन्द्रिका के मध्य (माँग) में रोरी लसित है। मोहन लाल की गति (चाल) मत्त गजराज जैसी मोहक और श्रीवृषभानु नन्दिनी की मत्त करिणी जैसी मद मथर है।नव तरुणि श्रीराधा के श्रीअंग में नीलाम्बर शोभित हैं और श्याम सुन्दर के श्यामाङ्ग पर पीत कौशेय धारण है। उपरोक्त नख शिख शृङ्गार की पूर्णता शिरोभाग पर लसित अरुण खोरी (छोर) कर रहा है। श्रीहित हरिवंश कहते हैं यह जोड़ी सौन्दर्थ्य एवं रस की सीमा है। राधापति श्रीकृष्ण रसिक चूडामणि हैं और श्रीराधा सूरत रस सिन्धु रूपा हैं जो रसिकों को नित्य रस देती हैं ।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5b0d865c9f7ab760360f9c70/bani-shri-radha-mohan-ki-jori-shri-hita-harivansh-mahaprabhu-from-hit-chaturasi-09","slug":"bani-shriradha-mohan-ki-jori"},{"id":"local-1","title":"राधा नाम को आधार","category":"Shloka","sanskrit_text":"राधा नाम को आधार,ललित लालवर रटत निरंतर, सरबस रस को सार ||सब गुण हीन मलीन दीन, अति पतितन में सरदार |ललित किशोरी तासु भरोसे सोवत पॉव पसार ||","hindi_text":"श्री ललित किशोरी जी कहते हैं की उनके जीवन का आधार एक मात्रा श्री राधा नाम ही है | यह वह दिव्य नाम है जो श्री लाल जी निरंतर रटन करते हैं एवं समस्त रस का मानो सार ही राधा नाम है | श्री ललित किशोरी जी\nके विनम्र शब्दों में, \"यूँ तो मैं गुण हीन, अशुद्ध हृदय युक्त, दीन एवं समस्त पतितों में शिरोमणि हूँ लेकिन केवल और केवल श्री राधा नाम एवं श्री किशोरीजी के बल से दोनों पॉंव पसार कर अर्थात निर्भय होकर सोता हूँ\" |","english_text":null,"english_translation":"Shri Lalit Kishori says, \"Shri Radha’s name is the foundation of his devotion. Shri Krishn the crest jewel of all the Rasiks, incessantly chants the same name, which is the essence of all the nectarian bliss. With humbleness, Shri Lalit Kishori says, although I am devoid of the entire expedient, my heart is awfully dirty and decayed. Thus I am an orphan from every point of view and leader of all the fallen souls. But still He says, simply by having a strong faith in Shri Radha’s name, he sleeps fearlessly.”","description":"https://www.brajrasik.org/hi/articles/5af9fc999f7ab760360f9c52/radha-naam-ko-aadhar-shri-lalit-kishori-abhilash-madhuri","author":"ललित किशोरी जी, अभिलाष माधुरी, विनय (२०५)","status":"published","content_text":"(राग देस)\nराधा नाम को आधार,\nललित लालवर रटत निरंतर, सरबस रस को सार ||\nसब गुण हीन मलीन दीन, अति पतितन में सरदार |\nललित किशोरी तासु भरोसे सोवत पॉव पसार ||\n- ललित किशोरी जी, अभिलाष माधुरी, विनय (२०५)\nश्री ललित किशोरी जी कहते हैं की उनके जीवन का आधार एक मात्रा श्री राधा नाम ही है | यह वह दिव्य नाम है जो श्री लाल जी निरंतर रटन करते हैं एवं समस्त रस का मानो सार ही राधा नाम है | श्री ललित किशोरी जी\nके विनम्र शब्दों में, \"यूँ तो मैं गुण हीन, अशुद्ध हृदय युक्त, दीन एवं समस्त पतितों में शिरोमणि हूँ लेकिन केवल और केवल श्री राधा नाम एवं श्री किशोरीजी के बल से दोनों पॉंव पसार कर अर्थात निर्भय होकर सोता हूँ\" |","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5af9fc999f7ab760360f9c52/radha-naam-ko-aadhar-shri-lalit-kishori-abhilash-madhuri","slug":"radha-nam-ko-adhara"},{"id":"local-3","title":"राधा नाम को उर धार","category":"Shloka","sanskrit_text":"राधा नाम को उर धार,मिलहिं रसिक मुकुटमणि मोहन आपहिं कुंजन द्वार,आठों जाम छकेंगी अँखियाँ छवि निकुंज विहार,ललित किशोरी फीके परिहैं सरवस सुख संसार ||","hindi_text":"आपको केवल राधा नाम को हृदय से धारण करना है, यह मान कर की किशोरीजी के नाम में वह बैठी हैं। आपको बिना प्रयास के ही श्याम सुन्दर कुञ्ज द्वार में मिल जाएंगे। श्री ललित किशोरीजी के शब्दों में राधा कृष्ण के रस को आठों याम अँखियाँ चखेंगी और निकुंज विहार रस प्राप्त होगा और संसार का समस्त बड़े से बड़ा सुख भी तुच्छ लगेगा।","english_text":null,"english_translation":"You have to keep Shri Radha's name in your heart all the time, believing the fact that she herself is seated in her name. You will be able to meet Shree Krishna on the gates of the Kunja, without any further efforts. In the words of Shri Lalit Kishoriji, your eyes will relish the ras (bliss) of Shri Radha Krishn at Nikunj Vihaar and even the greatest pleasures of the world will look immaterial (comparable to nothing).","description":"https://www.brajrasik.org/hi/articles/5a853a8b82274812fecf9694/radha-naam-ko-ur-dhar-pada-written-by-shri-lalit-kishori-abhilash-madhuri","author":"ललित किशोरी जी, अभिलाष माधुरी, विनय (२०४)","status":"published","content_text":"(राग देस)\nराधा नाम को उर धार,\nमिलहिं रसिक मुकुटमणि मोहन आपहिं कुंजन द्वार,\nआठों जाम छकेंगी अँखियाँ छवि निकुंज विहार,\nललित किशोरी फीके परिहैं सरवस सुख संसार ||\n- ललित किशोरी जी, अभिलाष माधुरी, विनय (२०४)\nआपको केवल राधा नाम को हृदय से धारण करना है, यह मान कर की किशोरीजी के नाम में वह बैठी हैं। आपको बिना प्रयास के ही श्याम सुन्दर कुञ्ज द्वार में मिल जाएंगे। श्री ललित किशोरीजी के शब्दों में राधा कृष्ण के रस को आठों याम अँखियाँ चखेंगी और निकुंज विहार रस प्राप्त होगा और संसार का समस्त बड़े से बड़ा सुख भी तुच्छ लगेगा।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5a853a8b82274812fecf9694/radha-naam-ko-ur-dhar-pada-written-by-shri-lalit-kishori-abhilash-madhuri","slug":"radha-nam-ko-ur-dhara"}]}]}]],null],null],null]},[null,["$","$Lb",null,{"parallelRouterKey":"children","segmentPath":["children","content","children","$c","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$Lb",null,{"parallelRouterKey":"children","segmentPath":["children","content","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.c