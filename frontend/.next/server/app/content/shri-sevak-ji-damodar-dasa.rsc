"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/598e01b259e8c72a534d85ae/shri-sewak-ji-damodar-das-rasik-saint-of-vrindavan","slug":"shri-sevak-ji-damodar-dasa"},"initialRelatedSaint":null,"initialRelatedBook":null,"initialRelatedRaga":null,"initialRelatedVerses":[{"id":"local-2","title":"नागा बाबा कदम्ब खंडी","category":"General","sanskrit_text":null,"hindi_text":"$9","english_text":null,"english_translation":"$a","description":"https://www.brajrasik.org/hi/articles/585f1f3e283dcc7a480eeb93/naga-ji-barsana-braj-yugal-swaroop-upasak-devotee.","author":"","status":"published","content_text":"$b","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/585f1f3e283dcc7a480eeb93/naga-ji-barsana-braj-yugal-swaroop-upasak-devotee.","slug":"naga-baba-kadamb-khndi"},{"id":"local-26","title":"मान सरोवर","category":"General","sanskrit_text":null,"hindi_text":"$c","english_text":null,"english_translation":"Maan sarovar is located on another side of Yamuna Devi, a small bridge is there to go to Maan Sarovar near Dheer Samir.","description":"https://www.brajrasik.org/hi/articles/594ed7e71350677a49620715/maan-sarovar-or-mana-sarovar-divine-pastimes","author":"","status":"published","content_text":"$d","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/594ed7e71350677a49620715/maan-sarovar-or-mana-sarovar-divine-pastimes","slug":"man-sarovara"},{"id":"local-34","title":"श्रीकृष्ण बलराम मंदिर","category":"General","sanskrit_text":null,"hindi_text":"श्रीकृष्ण बलराम मंदिर वृंदावन में रमणरेती क्षेत्र में स्थित है। 1975 में इस्कॉन संस्थापक ए सी भक्तिवेन्द्र स्वामी प्रभुपाद द्वारा व्यक्तिगत रूप से स्थापित किया गया था।","english_text":null,"english_translation":"Sri Krishna Balaram Mandir, situated in the Raman Reti area of Vrindavan was established personally by AC Bhaktivedanta Swami Prabhupada, founde