f:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"बने दोउ रसिक बिहारी बिहारनी | Vrindopnishad"}],["$","meta","3",{"name":"description","content":"(दोहा)\nश्रीहरि एवं प्रिया, मानों सुन्दरता रूपी साँचे में अच्छी प्रकार से ढले हुए सिंहासन पर सुशोभित हैं । ये दोनों रसिक बिहारी बिहारनी रूप तथा समस्त गुणों ..."}],["$","link","4",{"rel":"canonical","href":"https://path.vrindopnishad.in/content/bane-dou-rasik-bihari-biharani"}],["$","meta","5",{"property":"og:title","content":"बने दोउ रसिक बिहारी बिहारनी | Vrindopnishad"}],["$","meta","6",{"property":"og:description","content":"(दोहा)\nश्रीहरि एवं प्रिया, मानों सुन्दरता रूपी साँचे में अच्छी प्रकार से ढले हुए सिंहासन पर सुशोभित हैं । ये दोनों रसिक बिहारी बिहारनी रूप तथा समस्त गुणों ..."}],["$","meta","7",{"property":"og:url","content":"https://path.vrindopnishad.in/content/bane-dou-rasik-bihari-biharani"}],["$","meta","8",{"property":"og:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}],["$","meta","9",{"property":"og:image:width","content":"800"}],["$","meta","10",{"property":"og:image:height","content":"600"}],["$","meta","11",{"property":"og:image:alt","content":"बने दोउ रसिक बिहारी बिहारनी"}],["$","meta","12",{"property":"og:type","content":"article"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"बने दोउ रसिक बिहारी बिहारनी | Vrindopnishad"}],["$","meta","15",{"name":"twitter:description","content":"(दोहा)\nश्रीहरि एवं प्रिया, मानों सुन्दरता रूपी साँचे में अच्छी प्रकार से ढले हुए सिंहासन पर सुशोभित हैं । ये दोनों रसिक बिहारी बिहारनी रूप तथा समस्त गुणों ..."}],["$","meta","16",{"name":"twitter:image","content":"https://vrindopnishad.in/Vrindopnishad%20Web/class/logo/v-logo.png"}]]
