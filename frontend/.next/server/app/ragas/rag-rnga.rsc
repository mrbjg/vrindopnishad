0:["Xt0P2co0XkF6MKDXqPjpt",[[["",{"children":["ragas",{"children":[["slug","rag-rnga","d"],{"children":["__PAGE__?{\"slug\":\"rag-rnga\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["ragas",{"children":[["slug","rag-rnga","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ItemList\",\"name\":\"राग रंग\",\"description\":\"List of songs composed in Raga rag rnga\",\"numberOfItems\":1,\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"url\":\"https://path.vrindopnishad.in/content/bane-dou-rasik-bihari-biharani\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://path.vrindopnishad.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ragas\",\"item\":\"https://path.vrindopnishad.in/ragas\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"rag rnga\",\"item\":\"https://path.vrindopnishad.in/ragas/rag-rnga\"}]}"}}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 pt-4 mb-2 flex items-center gap-1.5 text-xs text-white/50 select-none","children":[["$","$L2",null,{"href":"/","className":"hover:text-amber-400 transition-colors","children":"Home"}],["$","span",null,{"children":"→"}],["$","$L2",null,{"href":"/ragas","className":"hover:text-amber-400 transition-colors","children":"Ragas"}],["$","span",null,{"children":"→"}],["$","span",null,{"className":"text-white/80 font-medium truncate","children":"rag rnga"}]]}],["$","$L3",null,{"children":["$","$L4",null,{"initialRaga":{"name":"राग रंग","hinglishName":"rag rnga","slug":"rag-rnga","verses":[{"id":"local-168","title":"बने दोउ रसिक बिहारी बिहारनी","category":"Shloka","sanskrit_text":"सिंहासन श्रीहरिप्रिया, सोहत सुढर ढरे।रसिक बिहारी बिहारनी, दोउ गुन रूप भरे ॥","hindi_text":"(दोहा)\nश्रीहरि एवं प्रिया, मानों सुन्दरता रूपी साँचे में अच्छी प्रकार से ढले हुए सिंहासन पर सुशोभित हैं । ये दोनों रसिक बिहारी बिहारनी रूप तथा समस्त गुणों से भरपूर हैं।\n(पद)\nये दोनों रसिक बिहारी बिहारनि रूप तथा समस्त गुणों से भरपूर हैं। इनके अंग प्रत्यंग अनुराग रंग से रंजित हैं और ये रत्न जड़ित आभूषण पहने हुए हैं। सुन्दर रंग-बिरंगे वस्त्रों को धारण किये हुए इनकी छबि सब के मनों को हरण करने वाली है। मानों यह किसी अनिर्वचनीय सुन्दरता रूपी साँचे में ढले हुए हों। श्रीहरि एवं प्रिया इस समय सिंहासन पर बैठे हुए परस्पर ढरारे नेत्र कमलों से देख रहे हैं।","english_text":null,"english_translation":"(Doha)\nThe ocean of Beauty, the divine couple Shri Radha Krishn are sitting on a throne. Both the Rasiks, Bihari, and Biharini are bright with fine qualities.\n(Pada)\nBoth the Rasiks, Shri Bihari (Krishn) and Shri Biharni (Shri Radha) whose forms are filled with the sweetest bliss, are adept in fine qualities. Their limbs are submerged in the color of divine love and are naturally adorned with many Gem-studded jewels. The glimpses of their beautiful form wearing colorful clothes forcibly enchant the mind of all, as if their form were cast in a mold of inexplicable beauty. At this moment, Shri Hari and Priya (The Divine couple) are sitting on a throne and looking at each other with unblinking eyes.","description":"https://www.brajrasik.org/hi/articles/5d81239daa02b8006926fef2/bane-dou-rasik-bihari-biharni-shri-harivyas-devacharya-mahavani-sewa-sukh-58","author":"श्री हरिव्यास देवाचार्य, महावाणी, सेवा सुख (58)","status":"published","content_text":"(दोहा)\nसिंहासन श्रीहरिप्रिया, सोहत सुढर ढरे।\nरसिक बिहारी बिहारनी, दोउ गुन रूप भरे ॥\n(पद)\nबने दोउ रसिक बिहारी बिहारनी रूप भरे गुन भरे ।\nअंग अंग सोहें रंग भीने अभरन रतन जरे ॥\nपहरें बसन सुबरनी छबि मनहरनी ढरनि ढरे।\nश्रीहरिप्रिया बैठे सिंहासन निरखति नैन ठरे ॥\n- श्री हरिव्यास देवाचार्य, महावाणी, सेवा सुख (58)\n(दोहा)\nश्रीहरि एवं प्रिया, मानों सुन्दरता रूपी साँचे में अच्छी प्रकार से ढले हुए सिंहासन पर सुशोभित हैं । ये दोनों रसिक बिहारी बिहारनी रूप तथा समस्त गुणों से भरपूर हैं।\n(पद)\nये दोनों रसिक बिहारी बिहारनि रूप तथा समस्त गुणों से भरपूर हैं। इनके अंग प्रत्यंग अनुराग रंग से रंजित हैं और ये रत्न जड़ित आभूषण पहने हुए हैं। सुन्दर रंग-बिरंगे वस्त्रों को धारण किये हुए इनकी छबि सब के मनों को हरण करने वाली है। मानों यह किसी अनिर्वचनीय सुन्दरता रूपी साँचे में ढले हुए हों। श्रीहरि एवं प्रिया इस समय सिंहासन पर बैठे हुए परस्पर ढरारे नेत्र कमलों से देख रहे हैं।","tags":["Braj Rasik","Mass Import"],"image_urls":[],"video_urls":[],"media_links":[],"source_url":"https://www.brajrasik.org/hi/articles/5d81239daa02b8006926fef2/bane-dou-rasik-bihari-biharni-shri-harivyas-devacharya-mahavani-sewa-sukh-58","slug":"bane-dou-rasik-bihari-biharani"}],"imageUrl":null}}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","ragas","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","ragas","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/cbf73327883ccb7f.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/fe995a1e4635138b.css","precedence":"next","crossOrigin":"$undefined"}],["$","link","2",{"rel":"stylesheet","href":"/_next/static/css/848f1edf91a8622f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"dark","children":["$","body",null,{"className":"antialiased","children":["$","$L8",null,{"children":["$","$L5",null,{"pa