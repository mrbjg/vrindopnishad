{
  "ignoreCommand": "if [ -d \"frontend\" ]; then git diff --quiet HEAD^ HEAD -- frontend vercel.json; else git diff --quiet HEAD^ HEAD -- . ../vercel.json; fi",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemaps/:sub.xml",
      "destination": "/api/sitemap?sub=:sub"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/google27b1a7fc60901288.html",
      "destination": "/google27b1a7fc60901288.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([gG]ooglebot|[bB]ing|[yY]andex|[bB]aidu|[tT]witter|[fF]acebook|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram|[sS]lack|[dD]iscord|[aA]pple|[cC]url|[wW]get|[lL]ighthouse|[sS]creaming|[pP]ostman).*"
        }
      ],
      "destination": "/api/seo-handler?type=static"
    },
    {
      "source": "/hi",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([gG]ooglebot|[bB]ing|[yY]andex|[bB]aidu|[tT]witter|[fF]acebook|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram|[sS]lack|[dD]iscord|[aA]pple|[cC]url|[wW]get|[lL]ighthouse|[sS]creaming|[pP]ostman).*"
        }
      ],
      "destination": "/api/seo-handler?type=static&lang=hi"
    },
    {
      "source": "/:slug(about|editorial-policy|sources|contact|search|granthas|what-is-vrindopnishad|meaning|origin|philosophy|teachings|importance|devotion|faq|comparison-with-upanishads|guide|braj-rasik-heritage|what-is-radha-snata|nitya-vihar-vs-nikunj-vihar|glossary|places|saints|books|ragas|content|who-is-harirae-ji|what-is-madhurya-and-sakhi-bhava|radhavallabh-vs-gaudiya-sampradaya|vrindavan-parikrama-guide|history-of-radhavallabh-sampradaya|major-rasik-saints-of-braj)",
      "destination": "/api/seo-handler?type=static&slug=:slug"
    },
    {
      "source": "/hi/:slug(about|editorial-policy|sources|contact|search|granthas|what-is-vrindopnishad|meaning|origin|philosophy|teachings|importance|devotion|faq|comparison-with-upanishads|guide|braj-rasik-heritage|what-is-radha-snata|nitya-vihar-vs-nikunj-vihar|glossary|places|saints|books|ragas|content|who-is-harirae-ji|what-is-madhurya-and-sakhi-bhava|radhavallabh-vs-gaudiya-sampradaya|vrindavan-parikrama-guide|history-of-radhavallabh-sampradaya|major-rasik-saints-of-braj)",
      "destination": "/api/seo-handler?type=static&slug=:slug&lang=hi"
    },
    {
      "source": "/content/:slug",
      "destination": "/api/seo-handler?type=content&slug=:slug"
    },
    {
      "source": "/hi/content/:slug",
      "destination": "/api/seo-handler?type=content&slug=:slug&lang=hi"
    },
    {
      "source": "/saint/:slug",
      "destination": "/api/seo-handler?type=saint&slug=:slug"
    },
    {
      "source": "/hi/saint/:slug",
      "destination": "/api/seo-handler?type=saint&slug=:slug&lang=hi"
    },
    {
      "source": "/saints/:slug",
      "destination": "/api/seo-handler?type=saint&slug=:slug"
    },
    {
      "source": "/hi/saints/:slug",
      "destination": "/api/seo-handler?type=saint&slug=:slug&lang=hi"
    },
    {
      "source": "/book/:slug",
      "destination": "/api/seo-handler?type=book&slug=:slug"
    },
    {
      "source": "/hi/book/:slug",
      "destination": "/api/seo-handler?type=book&slug=:slug&lang=hi"
    },
    {
      "source": "/granthas/:slug",
      "destination": "/api/seo-handler?type=book&slug=:slug"
    },
    {
      "source": "/hi/granthas/:slug",
      "destination": "/api/seo-handler?type=book&slug=:slug&lang=hi"
    },
    {
      "source": "/raga/:slug",
      "destination": "/api/seo-handler?type=raga&slug=:slug"
    },
    {
      "source": "/hi/raga/:slug",
      "destination": "/api/seo-handler?type=raga&slug=:slug&lang=hi"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/seo-handler?type=category&slug=:slug"
    },
    {
      "source": "/hi/category/:slug",
      "destination": "/api/seo-handler?type=category&slug=:slug&lang=hi"
    },
    {
      "source": "/glossary/:slug",
      "destination": "/api/seo-handler?type=glossary&slug=:slug"
    },
    {
      "source": "/hi/glossary/:slug",
      "destination": "/api/seo-handler?type=glossary&slug=:slug&lang=hi"
    },
    {
      "source": "/teachings/:slug",
      "destination": "/api/seo-handler?type=static&slug=:slug"
    },
    {
      "source": "/hi/teachings/:slug",
      "destination": "/api/seo-handler?type=static&slug=:slug&lang=hi"
    },
    {
      "source": "/((?!api|sitemap\\.xml|robots\\.txt|google27b1a7fc60901288\\.html|static|manifest\\.json|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/sitemap",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/seo-handler.js": {
      "includeFiles": "build/index.html"
    },
    "frontend/api/seo-handler.js": {
      "includeFiles": "frontend/build/index.html"
    }
  }
}